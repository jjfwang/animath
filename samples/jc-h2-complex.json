        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "reAxis",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 80,
            "x2": 880,
            "y1": 300,
            "y2": 300
          }
        },
        {
