          "at_ms": 3600,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "modEq",
            "kind": "latex",
            "size": 44,
            "tex": "|z| = \\sqrt{x^2 + y^2}",
            "x": 200,
            "y": 130
          }
        },
        {
          "at_ms": 4800,
          "do": "show",
          "shape": {
            "id": "triX",
            "kind": "line",
