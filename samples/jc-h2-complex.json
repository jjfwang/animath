    {
      "caption": "Argument is the angle; the conjugate mirrors it",
      "duration_ms": 9000,
      "id": "s3",
      "narration": "The argument of z is the angle the arrow makes with the positive real axis. Reflect the point across the real axis and the imaginary part flips sign - that is the complex conjugate: z-bar equals x minus iy.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "reAxis",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 80,
            "x2": 880,
            "y1": 360,
            "y2": 360
          }
        },
        {
          "at_ms": 600,
          "do": "show",
          "shape": {
            "id": "imAxis",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 480,
            "x2": 480,
            "y1": 120,
            "y2": 520
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "id": "z",
            "kind": "arrow",
            "stroke": "#1f7a3a",
            "width": 4,
            "x1": 480,
            "x2": 680,
            "y1": 360,
            "y2": 240
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "id": "theta",
            "kind": "text",
            "size": 36,
            "text": "θ",
            "x": 560,
            "y": 335
          }
        },
        {
          "at_ms": 3600,
          "do": "show",
          "shape": {
            "id": "argEq",
            "kind": "latex",
            "size": 36,
            "tex": "\\arg z = \\theta",
            "x": 700,
            "y": 300
          }
        },
        {
          "at_ms": 4800,
          "do": "show",
          "shape": {
            "id": "zc",
            "kind": "arrow",
            "stroke": "#1a56db",
