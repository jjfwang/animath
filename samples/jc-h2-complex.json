    {
      "caption": "Modulus is the distance from the origin",
      "duration_ms": 8000,
      "id": "s2",
      "narration": "The modulus of z is its distance from the origin. With real part x and imaginary part y, the point, the origin, and the axes form a right-angled triangle - so the modulus is Pythagoras: the square root of x squared plus y squared.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "mod",
            "kind": "line",
            "stroke": "#1f7a3a",
            "width": 4,
            "x1": 200,
            "x2": 560,
            "y1": 420,
            "y2": 240
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "cx": 200,
            "cy": 420,
            "fill": "#1a1a1a",
            "id": "origin",
            "kind": "circle",
            "r": 6
          }
        },
        {
          "at_ms": 1800,
          "do": "show",
          "shape": {
            "cx": 560,
            "cy": 240,
            "fill": "#1f7a3a",
            "id": "zpt",
            "kind": "circle",
            "r": 8
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "id": "zLab",
            "kind": "text",
            "size": 30,
            "text": "z = x + iy",
            "x": 600,
            "y": 220
          }
        },
