{"animath":"0.1","canvas":{"height":540,"width":960},"kind":"concept","level":"primary","scenes":[{"caption":"Percent means per hundred","duration_ms":7000,"id":"s1","narration":"Percent means out of one hundred. On this hundred-grid, twenty-five shaded cells out of one hundred is 25 percent.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":44,"text":"25% — 25 out of 100","x":120,"y":90}},{"at_ms":500,"do":"show","shape":{"fill":"#ffffff","h":280,"id":"grid","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":280,"x":120,"y":140}},{"at_ms":700,"do":"show","shape":{"id":"v1","kind":"line","stroke":"#aaaaaa","width":1,"x1":148,"x2":148,"y1":140,"y2":420}},{"at_ms":750,"do":"show","shape":{"id":"v2","kind":"line","stroke":"#aaaaaa","width":1,"x1":176,"x2":176,"y1":140,"y2":420}},{"at_ms":800,"do":"show","shape":{"id":"v3","kind":"line","stroke":"#aaaaaa","width":1,"x1":204,"x2":204,"y1":140,"y2":420}},{"at_ms":850,"do":"show","shape":{"id":"v4","kind":"line","stroke":"#aaaaaa","width":1,"x1":232,"x2":232,"y1":140,"y2":420}},{"at_ms":900,"do":"show","shape":{"id":"v5","kind":"line","stroke":"#aaaaaa","width":1,"x1":260,"x2":260,"y1":140,"y2":420}},{"at_ms":950,"do":"show","shape":{"id":"v6","kind":"line","stroke":"#aaaaaa","width":1,"x1":288,"x2":288,"y1":140,"y2":420}},{"at_ms":1000,"do":"show","shape":{"id":"v7","kind":"line","stroke":"#aaaaaa","width":1,"x1":316,"x2":316,"y1":140,"y2":420}},{"at_ms":1050,"do":"show","shape":{"id":"v8","kind":"line","stroke":"#aaaaaa","width":1,"x1":344,"x2":344,"y1":140,"y2":420}},{"at_ms":1100,"do":"show","shape":{"id":"v9","kind":"line","stroke":"#aaaaaa","width":1,"x1":372,"x2":372,"y1":140,"y2":420}},{"at_ms":1150,"do":"show","shape":{"id":"h1","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":168,"y2":168}},{"at_ms":1200,"do":"show","shape":{"id":"h2","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":196,"y2":196}},{"at_ms":1250,"do":"show","shape":{"id":"h3","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":224,"y2":224}},{"at_ms":1300,"do":"show","shape":{"id":"h4","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":252,"y2":252}},{"at_ms":1350,"do":"show","shape":{"id":"h5","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":280,"y2":280}},{"at_ms":1400,"do":"show","shape":{"id":"h6","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":308,"y2":308}},{"at_ms":1450,"do":"show","shape":{"id":"h7","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":336,"y2":336}},{"at_ms":1500,"do":"show","shape":{"id":"h8","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":364,"y2":364}},{"at_ms":1550,"do":"show","shape":{"id":"h9","kind":"line","stroke":"#aaaaaa","width":1,"x1":120,"x2":400,"y1":392,"y2":392}},{"at_ms":2000,"do":"show","shape":{"fill":"#7fb3e8","h":280,"id":"c1","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":28,"x":120,"y":140}},{"at_ms":2200,"do":"show","shape":{"fill":"#7fb3e8","h":280,"id":"c2","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":28,"x":148,"y":140}},{"at_ms":2400,"do":"show","shape":{"fill":"#8fd694","h":140,"id":"c3","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":28,"x":176,"y":140}},{"at_ms":3000,"do":"show","shape":{"id":"lab","kind":"text","size":30,"text":"25 cells shaded out of 100","x":450,"y":230}},{"at_ms":3700,"do":"show","shape":{"id":"eq","kind":"text","size":36,"text":"25% = 25/100","x":450,"y":310}},{"at_ms":4500,"do":"emphasize","dur_ms":1000,"target":"eq"},{"at_ms":5600,"do":"caption","text":"Percent always counts out of one hundred"}]},{"caption":"Watch out: 25% is not just 25","duration_ms":8000,"id":"s2","narration":"Careful: 25 percent of 60 is not 25. The 25 means 25 out of 100 — and our whole here is 60, not 100.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":36,"text":"25% of 60 — is the answer 25?","x":120,"y":140}},{"at_ms":1400,"do":"show","shape":{"color":"#8a1f1f","id":"warn","kind":"text","size":30,"text":"No. 25% means 25 out of 100 — never 25 out of 60.","x":120,"y":205}},{"at_ms":2800,"do":"show","shape":{"fill":"#ffffff","h":150,"id":"mini","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":150,"x":120,"y":300}},{"at_ms":3200,"do":"show","shape":{"fill":"#7fb3e8","h":75,"id":"minifill","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":38,"x":120,"y":300}},{"at_ms":3600,"do":"show","shape":{"id":"minilab","kind":"text","size":26,"text":"25% of a hundred-grid","x":120,"y":490}},{"at_ms":4400,"do":"show","shape":{"fill":"#ffffff","h":44,"id":"wholebar","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":330,"x":470,"y":300}},{"at_ms":4800,"do":"show","shape":{"id":"wholelab","kind":"text","size":26,"text":"but here the whole is 60","x":470,"y":385}},{"at_ms":5600,"do":"show","shape":{"id":"sum","kind":"text","size":30,"text":"so 25% of 60 must be smaller than 25","x":470,"y":440}},{"at_ms":6800,"do":"caption","text":"A percent is a share — ask: share of what?"}]},{"caption":"25% of 60: divide into quarters","duration_ms":9000,"id":"s3","narration":"25 out of 100 is one quarter. So 25 percent of 60 is one quarter of 60. Divide 60 by 4 to get 15.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":44,"text":"25% of 60","x":120,"y":90}},{"at_ms":600,"do":"show","shape":{"fill":"#ffffff","h":60,"id":"bar","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":440,"x":120,"y":160}},{"at_ms":1200,"do":"show","shape":{"id":"cut1","kind":"line","stroke":"#1a1a1a","width":3,"x1":230,"x2":230,"y1":160,"y2":220}},{"at_ms":1400,"do":"show","shape":{"id":"cut2","kind":"line","stroke":"#1a1a1a","width":3,"x1":340,"x2":340,"y1":160,"y2":220}},{"at_ms":1600,"do":"show","shape":{"id":"cut3","kind":"line","stroke":"#1a1a1a","width":3,"x1":450,"x2":450,"y1":160,"y2":220}},{"at_ms":2400,"do":"show","shape":{"fill":"#7fb3e8","h":60,"id":"quarter","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":110,"x":120,"y":160}},{"at_ms":2700,"do":"show","shape":{"id":"lab","kind":"text","size":30,"text":"one quarter of the bar","x":600,"y":195}},{"at_ms":3400,"do":"show","shape":{"id":"frac","kind":"text","size":34,"text":"25% = 1/4","x":600,"y":265}},{"at_ms":4400,"do":"show","shape":{"id":"div","kind":"text","size":38,"text":"60 ÷ 4 = 15","x":120,"y":300}},{"at_ms":5600,"do":"emphasize","dur_ms":1000,"target":"div"},{"at_ms":6600,"do":"show","shape":{"color":"#1f7a3a","id":"ans","kind":"text","size":40,"text":"25% of 60 = 15 ✓","x":120,"y":390}},{"at_ms":7600,"do":"caption","text":"Split the whole into four equal parts"}]},{"caption":"The takeaway","duration_ms":6000,"id":"s4","narration":"Percent means per hundred. To find a percent of a quantity, turn the percent into a fraction of that new whole, then divide.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t1","kind":"text","size":30,"text":"1. Percent = per hundred: 25% = 25/100 = 1/4","x":120,"y":200}},{"at_ms":1500,"do":"show","shape":{"id":"t2","kind":"text","size":30,"text":"2. Find the fraction of the new whole: 60 ÷ 4 = 15","x":120,"y":260}},{"at_ms":3000,"do":"show","shape":{"color":"#1f7a3a","id":"t3","kind":"text","size":40,"text":"25% of 60 = 15 ✓","x":120,"y":350}}]}],"subject":"math","title":"Percentage: 25% of 60","topic":"percentage"}