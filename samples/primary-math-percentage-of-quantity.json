ff", "stroke": "#1a1a1a", "strokeWidth": 2, "x": 120, "y": 300, "w": 100, "h": 100, "explain": "The mini hundred-grid: 25% of 100 is 25."}}, {"at_ms": 3100, "do": "show", "shape": {"id": "minifill", "kind": "rect", "fill": "#7fb3e8", "stroke": "#1a1a1a", "strokeWidth": 2, "x": 120, "y": 300, "w": 50, "h": 50, "explain": "The shaded 25 cells of the mini grid: 25% of 100."}}, {"at_ms": 3500, "do": "show", "shape": {"id": "minilab", "kind": "text", "size": 26, "text": "25% of a hundred-grid", "x": 120, "y": 435, "explain": "The mini label: 25% of a hundred-grid."}}, {"at_ms": 4300, "do": "show", "shape": {"id": "wholebar", "kind": "rect", "fill": "#ffffff", "stroke": "#1a1a1a", "strokeWidth": 2, "x": 470, "y": 300, "w": 330, "h": 44, "explain": "The whole bar: here the whole is 60, not 100."}}, {"at_ms": 4600, "do": "show", "shape": {"id": "wholelab", "kind": "text", "size": 26, "text": "but here the whole is 60", "x": 470, "y": 385, "explain": "The whole label: the whole is 60."}}, {"at_ms": 5200, "do": "move", "target": "minifill", "to": {"x": 470, "y": 300, "w": 82.5, "h": 44}, "dur_ms": 1200}, {"at_ms": 6500, "do": "show", "shape": {"id": "sum", "kind": "text", "size": 22, "text": "so 25% of 60 must be smaller than 25", "x": 470, "y": 440, "explain": "The takeaway: 25% of 60 must be smaller than 25."}}, {"at_ms": 7400, "do": "caption", "text": "A percent is a share — ask: share of what?"}]}, {"id": "s3", "caption": "25% of 60: divide into quarters", "duration_ms": 9000, "narration": "25 out of 100 is one quarter. So 25 percent of 60 is one quarter of 60. Divide 60 by 4 to get 15.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "q", "kind": "text", "size": 44, "text": "25% of 60", "x": 120, "y": 90, "explain": "The question: 25% of 60."}}, {"at_ms": 600, "do": "show", "shape": {"id": "bar", "kind": "rect", "fill": "#ffffff", "stroke": "#1a1a1a", "strokeWidth": 2, "x": 120, "y": 160, "w": 440, "h": 60, "explain": "The 60 bar: the whole we take a percent of."}}