    {
      "caption": "The power rule",
      "duration_ms": 8000,
      "id": "s2",
      "narration": "Differentiation has a workhorse: if y is x to the n, the derivative is n times x to the n minus one. Three examples show the pattern doing all the work.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "rule",
            "kind": "latex",
            "size": 44,
            "tex": "y = x^n \\;\\Longrightarrow\\; \\frac{dy}{dx} = nx^{n-1}",
            "x": 150,
            "y": 140
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "ex1",
            "kind": "latex",
            "size": 40,
            "tex": "y = x^3 \\Rightarrow \\frac{dy}{dx} = 3x^2",
            "x": 150,
            "y": 260
          }
        },
        {
          "at_ms": 2800,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "ex2",
            "kind": "latex",
            "size": 40,
            "tex": "y = 5x^4 \\Rightarrow \\frac{dy}{dx} = 20x^3",
            "x": 150,
            "y": 360
          }
        },
        {
          "at_ms": 4200,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "ex3",
            "kind": "latex",
            "size": 40,
            "tex": "y = \\frac{1}{x} = x^{-1} \\Rightarrow \\frac{dy}{dx} = -x^{-2}",
            "x": 150,
            "y": 460
          }
        },
        {
          "at_ms": 6000,
          "do": "show",
          "shape": {
            "id": "tip",
            "kind": "text",
            "size": 26,
            "text": "multiply by the power, drop the power by one",
            "x": 480,
            "y": 120
          }
        },
        {
          "at_ms": 7000,
          "do": "emphasize",
          "dur_ms": 900,
          "target": "rule"
        }
      ]
    },
    {
      "caption": "dy/dx from first principles",
      "duration_ms": 9000,
      "id": "s3",
      "narration": "The derivative is a limit: the change in y over the change in x, as the change in x shrinks to zero. The power rule is just the shortcut this limit proves.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "fp",
            "kind": "latex",
            "size": 44,
            "tex": "\\frac{dy}{dx} = \\lim_{\\Delta x \\to 0} \\frac{\\Delta y}{\\Delta x}",
            "x": 170,
            "y": 140
          }
        },
        {
          "at_ms": 1500,
          "do": "show",
          "shape": {
            "id": "step1",
            "kind": "text",
            "size": 28,
            "text": "1. gradient of a chord: Δy ÷ Δx",
            "x": 170,
            "y": 260
          }
        },
        {
          "at_ms": 3000,
          "do": "show",
          "shape": {
            "id": "step2",
            "kind": "text",
            "size": 28,
            "text": "2. shrink Δx — the chord becomes the tangent",
            "x": 170,
            "y": 340
          }
        },
        {
          "at_ms": 4500,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "fpEg",
            "kind": "latex",
            "size": 40,
            "tex": "y = x^2 \\;\\Rightarrow\\; \\frac{dy}{dx} = 2x",
            "x": 170,
            "y": 440
          }
        },
        {
          "at_ms": 6000,
          "do": "show",
          "shape": {
            "id": "fpNote",
            "kind": "text",
            "size": 26,
            "text": "the limit proves the shortcut, the shortcut is what you use",
            "x": 170,
            "y": 500
          }
        },
        {
          "at_ms": 7400,
          "do": "emphasize",
          "dur_ms": 900,
          "target": "fp"
        }
      ]
    },
