se","kind":"line","x1":420,"y1":340,"x2":420,"y2":160,"stroke":"#b00020","strokeWidth":3}},{"at_ms":6600,"do":"show","shape":{"id":"ptlab","kind":"latex","x":432,"y":172,"size":32,"tex":"(4, 8)"}},{"at_ms":6600,"do":"show","shape":{"id":"riselab","kind":"latex","x":430,"y":252,"size":28,"tex":"6"}},{"at_ms":7200,"do":"show","shape":{"id":"grad","kind":"latex","x":620,"y":200,"size":40,"tex":"m = \\frac{6}{4} = \\frac{3}{2}","color":"#1f7a3a"}},{"at_ms":8200,"do":"caption","text":"Gradient = rise ÷ run; the intercept is the value at x = 0"}]},{"id":"s3","duration_ms":9000,"caption":"Parallel lines share a gradient","narration":"y equals three x plus one and y equals three x minus four both have gradient three, so they climb at exactly the same rate. Different intercepts mean different starting heights — same slope, never crossing: parallel.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","x":120,"y":100,"size":36,"text":"Parallel lines share a gradient"}},{"at_ms":600,"do":"show","shape":{"id":"eqa","kind":"latex","x":120,"y":180,"size":44,"tex":"y = 3x + 1","color":"#1f7a3a"}},{"at_ms":1400,"do":"show","shape":{"id":"eqb","kind":"latex","x":120,"y":260,"size":44,"tex":"y = 3x - 4","color":"#1a56db"}},{"at_ms":2200,"do":"show","shape":{"id":"linea","kind":"arrow","x1":275,"y1":430,"x2":285,"y2":400,"color":"#1f7a3a","strokeWidth":4}},{"at_ms":2200,"do":"show","shape":{"id":"lineb","kind":"arrow","x1":350,"y1":330,"x2":360,"y2":300,"color":"#1a56db","strokeWidth":4}},{"at_ms":2800,"do":"move","target":"linea","to":{"x1":275,"y1":430,"x2":350,"y2":205},"dur_ms":1800},{"at_ms":2800,"do":"move","target":"lineb","to":{"x1":350,"y1":330,"x2":425,"y2":105},"dur_ms":1800},{"at_ms":4700,"do":"show","shape":{"id":"probe","kind":"circle","cx":275,"cy":430,"r":8,"fill":"#1f7a3a"}},{"at_ms":5000,"do":"move","target":"probe","to":{"cx":300,"cy":430},"dur_ms":700},{"at_ms":5000,"do":"show","shape":{"id":"run1","kind":"line","x1":275,"y1":430,"x2":300,"y2":430,"stroke":"#1f7a3a","strokeWidth":3}},{"at_ms":5800,"do":"move","target":"probe","to":{"cx":300,"cy":355},"dur_ms":700},{"at_ms":5800,"do":"show","shape":{"id":"rise1","kind":"line","x1":300,"y1":430,"x2":300,"y2":355,"stroke":"#1f7a3a","strokeWidth":3}},{"at_ms":6600,"do":"show","shape":{"id":"m3","kind":"latex","x":470,"y":220,"size":40,"tex":"m = 3 \\text{ for both}"}},{"at_ms":7400,"do":"emphasize","target":"linea","dur_ms":900},{"at_ms":7800,"do":"emphasize","target":"lineb","dur_ms":900},{"at_ms":8400,"do":"caption","text":"Same gradient, different intercepts — parallel lines never meet"}]},{"id":"s4","duration_ms":10000,"caption":"Roots and the turning point of y = x² − 4","narration":"Sketch y equals x squared minus four: where the curve crosses the x-axis, y is zero, so x squared minus four equals zero gives x equals plus or minus two — the roots. The turning point at zero, minus four is the minimum.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","x":120,"y":100,"size":36,"text":"Roots and the turning point of y = x² − 4"}},{"at_ms":600,"do":"show","shape":{"id":"eq","kind":"latex","x":620,"y":150,"size":48,"tex":"y = x^2 - 4"}},{"at_ms":1400,"do":"show","shape":{"id":"xaxis","kind":"line","x1":120,"y1":360,"x2":560,"y2":360,"stroke":"#1a1a1a","strokeWidth":2}},{"at_ms":1800,"do":"show","shape":{"id":"yaxis","kind":"line","x1":340,"y1":120,"x2":340,"y2":500,"stroke":"#1a1a1a","strokeWidth":2}},{"at_ms":2200,"do":"show","shape":{"id":"tracer","kind":"circle","cx":220,"cy":160,"r":8,"fill":"#1f7a3a"}},{"at_ms":2200,"do":"show","shape":{"id":"seg1","kind":"polygon","points":[[220,160],[240,270],[260,360]],"stroke":"#1f7a3a","strokeWidth":4,"fill":"none"}},{"at_ms":2700,"do":"move","target":"tracer","to":{"cx":280,"cy":430},"dur_ms":800},{"at_ms":2700,"do":"show","shape":{"id":"seg2","kind":"polygon","points":[[260,360],[280,430],[300,480]],"stroke":"#1f7a3a","strokeWidth":4,"fill":"none"}},{"at_ms":3500,"do":"show","shape":{"id":"root1","kind":"circle","cx":260,"cy":360,"r":7,"fill":"#b00020"}},{"at_ms":3600,"do":"move","target":"tracer","to":{"cx":320,"cy":510},"dur_ms":800},{"at_ms":3600,"do":"show","shape":{"id":"seg3","kind":"polygon","points":[[300,480],[320,510],[340,520]],"stroke":"#1f7a3a","strokeWidth":4,"fill":"none"}},{"at_ms":3800,"do":"show","shape":{"id":"root1lab","kind":"latex","x":150,"y":392,"size":32,"tex":"x = -2"}},{"at_ms":4500,"do":"move","target":"tracer","to":{"cx":360,"cy":510},"dur_ms":800},{"at_ms":4500,"do":"show","shape":{"id":"seg4","kind":"polygon","points":[[340,520],[360,510],[380,480]],"stroke":"#1f7a3a","strokeWidth":4,"fill":"none"}},{"at_ms":5400,"do":"move","target":"tracer","to":{"cx":400,"cy":430},"dur_ms":800},{"at_ms":5400,"do":"show","shape":{"id":"seg5","kind":"polygon","points":[[380,480],[400,430],[420,360]],"stroke":"#1f7a3a","strokeWidth":4,"fill":"none"}},{"at_ms":6200,"do":"show","shape":{"id":"root2","kind":"circle","cx":420,"cy":360,"r":7,"fill":"#b00020"}},{"at_ms":6300,"do":"move","target":"tracer","to":{"cx":460,"cy":160},"dur_ms":800},{"at_ms":6300,"do":"show","shape":{"id":"seg6","kind":"polygon","points":[[420,360],[440,270],[460,160]],"stroke":"#1f7a3a","strokeWidth":4,"fill":"none"}},{"at_ms":6500,"do":"show","shape":{"id":"root2lab","kind":"latex","x":428,"y":392,"size":32,"tex":"x = 2"}},{"at_ms":7000,"do":"show","shape":{"id":"rootsum","kind":"latex","x":480,"y":300,"size":36,"tex":"x^2 - 4 = 0 \\;\\Rightarrow\\; x = \\pm 2"}},{"at_ms":7400,"do":"show","shape":{"id":"turn","kind":"circle","cx":340,"cy":520,"r":7,"fill":"#1a56db"}},{"at_ms":7800,"do":"show","shape":{"id":"turnlab","kind":"latex","x":520,"y":400,"size":36,"tex":"\\text{turning point } (0, -4)"}},{"at_ms":8800,"do":"caption","text":"Roots cross the x-axis; the turning point is the minimum"}]},{"id":"s5","duration_ms":9000,"caption":"A common mistake: the bigger intercept is steeper","narration":"A common mistake: the line with the bigger intercept is steeper. Which is steeper: A, y equals four x minus six, or B, y equals x plus three? The intercept is the visible height, so it feels like the climb. Steepness is the gradient, not the intercept: A has gradient four against B's one, so A climbs fastest — compare the m, never the c.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","x":120,"y":100,"size":36,"text":"Misconception: bigger intercept, steeper line?"}},{"at_ms":600,"do":"show","shape":{"id":"eqa","kind":"latex","x":90,"y":120,"size":40,"tex":"A:\\; y = 4x - 6","color":"#b00020"}},{"at_ms":1400,"do":"show","shape":{"id":"eqb","kind":"latex","x":90,"y":180,"size":40,"tex":"B:\\; y = x + 3","color":"#1f7a3a"}},{"at_ms":2200,"do":"show","shape":{"id":"linea","kind":"arrow","x1":300,"y1":480,"x2":304,"y2":464,"color":"#b00020","strokeWidth":4}},{"at_ms":2200,"do":"show","shape":{"id":"lineb","kind":"arrow","x1":300,"y1":300,"x2":310,"y2":290,"color":"#1f7a3a","strokeWidth":4}},{"at_ms":2800,"do":"move","target":"linea","to":{"x1":300,"y1":480,"x2":360,"y2":240},"dur_ms":1800},{"at_ms":2800,"do":"move","target":"lineb","to":{"x1":300,"y1":300,"x2":400,"y2":200},"dur_ms":1800},{"at_ms":4700,"do":"show","shape":{"id":"grad","kind":"latex","x":560,"y":200,"size":40,"tex":"m_A = 4 > 1 = m_B"}},{"at_ms":5600,"do":"show","shape":{"id":"icept","kind":"latex","x":560,"y":280,"size":40,"tex":"c_A = -6 < 3 = c_B"}},{"at_ms":6200,"do":"emphasize","target":"linea","dur_ms":900},{"at_ms":7400,"do":"caption","text":"Steepness comes from the gradient, not the intercept"}]}]}