{"animath":"0.1","kind":"concept","level":"secondary","subject":"math","topic":"e-functions-graphs","title":"E-Math functions and graphs: straight lines and quadratics","canvas":{"width":960,"height":540},"scenes":[{"id":"s1","duration_ms":10000,"caption":"Sketch y = 2x − 3 from gradient and intercept","narration":"Sketch y equals two x minus three. The intercept is at zero, minus three. A gradient of two means rise two for every run of one. Plot the intercept, step out the rise and run, then join them — the line is done.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","x":120,"y":100,"size":36,"text":"Sketch y = 2x − 3"}},{"at_ms":600,"do":"show","shape":{"id":"eq","kind":"latex","x":150,"y":190,"size":48,"tex":"y = 2x - 3"}},{"at_ms":1400,"do":"show","shape":{"id":"xaxis","kind":"line","x1":140,"y1":390,"x2":580,"y2":390,"stroke":"#1a1a1a","strokeWidth":2}},{"at_ms":1800,"do":"show","shape":{"id":"yaxis","kind":"line","x1":360,"y1":120,"x2":360,"y2":500,"stroke":"#1a1a1a","strokeWidth":2}},{"at_ms":2400,"do":"show","shape":{"id":"pen","kind":"circle","cx":360,"cy":480,"r":8,"fill":"#1f7a3a"}},{"at_ms":2800,"do":"show","shape":{"id":"iceptlab","kind":"latex","x":378,"y":494,"size":32,"tex":"(0, -3)"}},{"at_ms":3400,"do":"move","target":"pen","to":{"cx":390,"cy":480},"dur_ms":900},{"at_ms":3400,"do":"show","shape":{"id":"run","kind":"line","x1":360,"y1":480,"x2":390,"y2":480,"stroke":"#1f7a3a","strokeWidth":3}},{"at_ms":4400,"do":"show","shape":{"id":"runlab","kind":"latex","x":396,"y":466,"size":28,"tex":"\\text{run } 1"}},{"at_ms":4400,"do":"move","target":"pen","to":{"cx":390,"cy":420},"dur_ms":900},{"at_ms":4400,"do":"show","shape":{"id":"rise","kind":"line","x1":390,"y1":480,"x2":390,"y2":420,"stroke":"#1f7a3a","strokeWidth":3}},{"at_ms":5400,"do":"show","shape":{"id":"riselab","kind":"latex","x":398,"y":456,"size":28,"tex":"\\text{rise } 2"}},{"at_ms":5400,"do":"show","shape":{"id":"line","kind":"arrow","x1":360,"y1":480,"x2":372,"y2":444,