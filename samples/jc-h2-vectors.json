    {
      "caption": "A vector has size and direction",
      "duration_ms": 8000,
      "id": "s1",
      "narration": "A vector is an arrow with a size and a direction. This arrow moves 2 units right and 3 units up, and its column vector records exactly that: 2 over 3. The length of the arrow is the magnitude of the vector.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "explain": "The x-axis.",
            "id": "xAxis",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 80,
            "x2": 880,
            "y1": 450,
            "y2": 450
          }
        },
        {
          "at_ms": 800,
          "do": "show",
          "shape": {
            "explain": "The y-axis.",
            "id": "yAxis",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 120,
            "x2": 120,
            "y1": 80,
            "y2": 490
          }
        },
        {
          "at_ms": 1600,
          "do": "show",
          "shape": {
            "explain": "The vector a: 2 right and 3 up, drawn as an arrow.",
            "id": "vec",
            "kind": "arrow",
            "stroke": "#1f7a3a",
            "width": 4,
            "x1": 120,
            "x2": 480,
            "y1": 450,
