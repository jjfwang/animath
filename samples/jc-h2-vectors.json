        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "explain": "Vector a: the first leg of the journey.",
            "id": "a",
            "kind": "arrow",
            "stroke": "#1f7a3a",
            "width": 4,
            "x1": 150,
            "x2": 350,
            "y1": 400,
            "y2": 250
          }
        },
        {
          "at_ms": 1400,
