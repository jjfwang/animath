    {
      "caption": "The dot product measures the shadow",
      "duration_ms": 9000,
      "id": "s3",
      "narration":"The dot product asks how much of one vector points along another: drop a perpendicular from the tip of b onto a, and the shadow it casts is the projection. It equals the two lengths times cos theta.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "explain": "Vector a: the first arrow in the dot-product pair.",
            "id": "a",
            "kind": "arrow",
            "stroke": "#1f7a3a",
            "width": 4,
            "x1": 120,
            "x2": 600,
            "y1": 420,
            "y2": 420
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "explain": "Vector b: the dot product measures how much of a points along b.",
            "id": "b",
            "kind": "arrow",
            "stroke": "#1a56db",
            "width": 4,
            "x1": 120,
            "x2": 480,
            "y1": 420,
            "y2": 180
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "explain": "Theta: the angle between the two vectors; the dot product needs it.",
            "id": "theta",
            "kind": "text",
            "size": 40,
            "text": "θ",
            "x": 230,
            "y": 380
          }
        },
        {
          "at_ms": 3600,
          "do": "show",
          "shape": {
            "explain": "The perpendicular drop: from the tip of b down onto a, casting the shadow.",
            "id": "proj",
            "kind": "line",
            "stroke": "#999999",
            "width": 2,
            "x1": 480,
            "x2": 480,
            "y1": 180,
            "y2": 180
          }
        },
        {
          "at_ms": 3800,
          "do": "move",
          "dur_ms": 900,
          "target": "proj",
          "to": {
            "x2": 480,
            "y2": 420
          }
        },

        {
          "at_ms": 4600,
          "do": "show",
          "shape": {
            "explain": "The dot product: the two lengths times cos theta.",
            "color": "#1f7a3a",
            "id": "dotEq",
            "kind": "latex",
            "size": 44,
            "tex": "a \\cdot b = |a||b|\\cos\\theta",
            "x": 120,
            "y": 130
          }
        },
        {
          "at_ms": 5800,
          "do": "show",
          "shape": {
            "explain": "The shadow: b's projection onto a, the length the dot product measures.",
            "id": "projLab",
            "kind": "text",
            "size": 26,
            "text": "the shadow of b on a",
            "x": 510,
            "y": 300
          }
        },
        {
          "at_ms": 6800,
          "do": "emphasize",
          "dur_ms": 900,
          "target": "dotEq"
        },
        {
          "at_ms": 7600,
          "do": "caption",
          "text": "cos θ picks out how much of b points along a"
        }
      ]
    },
