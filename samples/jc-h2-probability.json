    {
      "id": "s3",
      "caption": "Binomial: n = 10, p = 0.3",
      "narration": "For a binomial variable with 10 trials and success probability 0.3, the chance of exactly 3 successes is 10 choose 3 times 0.3 cubed times 0.7 to the 7. There are 120 ways to pick which 3 trials succeed, giving about 0.267.",
      "duration_ms": 9000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "probEq",
            "kind": "latex",
            "x": 120,
            "y": 150,
            "tex": "P(X = 3) = \\binom{10}{3} (0.3)^{3} (0.7)^{7}",
            "size": 40
          }
        },
        {
          "at_ms": 2000,
          "do": "show",
          "shape": {
            "id": "cVal",
            "kind": "text",
            "x": 120,
            "y": 250,
            "text": "C(10, 3) = 120 ways to choose the 3 successes",
            "size": 30
          }
        },
        {
          "at_ms": 3800,
          "do": "show",
          "shape": {
            "id": "val",
            "kind": "text",
            "x": 120,
            "y": 340,
            "text": "≈ 120 × 0.027 × 0.0823 ≈ 0.267",
            "size": 34
          }
        },
        {
          "at_ms": 5400,
          "do": "show",
          "shape": {
            "id": "note",
            "kind": "text",
            "x": 100,
            "y": 430,
            "text": "each success path has the same probability — multiply, don't add",
            "size": 22
          }
        },
        {
          "at_ms": 6600,
          "do": "emphasize",
          "target": "val",
          "dur_ms": 900
        },
        {
          "at_ms": 7600,
          "do": "caption",
          "text": "≈ 0.267 — about a 1-in-4 chance of exactly 3"
        }
      ]
    },
    {
      "id": "s4",
      "caption": "The 68–95–99.7 rule",
      "narration": "A normal distribution is fully described by its mean and standard deviation. About 68 percent of the area lies within one standard deviation of the mean, 95 within two, and 99.7 within three.",
