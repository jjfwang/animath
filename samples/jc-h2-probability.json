    {
      "id": "s5",
      "caption": "Misconception: the coin has no memory",
      "narration": "After five heads in a row, it feels like tails is due. It is not. Each toss is independent, so the probability of heads on the next toss is still one half. The six-heads run itself has probability 1 over 64, which is small — but the coin never remembers.",
      "duration_ms": 9000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "mis",
            "kind": "text",
            "x": 120,
            "y": 110,
            "text": "Misconception:",
            "size": 36,
            "color": "#b00020"
          }
        },
        {
          "at_ms": 1200,
          "do": "show",
          "shape": {
            "id": "tosses",
            "kind": "text",
            "x": 120,
            "y": 200,
            "text": "H H H H H — heads five times running",
            "size": 36
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "id": "fallacy",
            "kind": "text",
            "x": 120,
            "y": 290,
            "text": "\"tails is due!\"",
            "size": 32,
            "color": "#b00020"
          }
        },
        {
          "at_ms": 4000,
          "do": "show",
          "shape": {
            "id": "truth",
            "kind": "text",
            "x": 120,
            "y": 380,
            "text": "no — P(H) = ½ on the next toss, every toss",
            "size": 30
          }
        },
        {
          "at_ms": 5400,
          "do": "show",
          "shape": {
            "id": "sixEq",
            "kind": "latex",
