    {
      "caption": "Le Chatelier: the system opposes the change",
      "duration_ms": 11000,
      "id": "s5",
      "narration": "An equilibrium opposes any disturbance. Add nitrogen to the Haber mixture and it consumes some to make ammonia; raise the pressure and it shifts toward fewer gas moles; cool this exothermic reaction and it shifts to release more heat. The equilibrium constant itself only moves with temperature.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "haberEq",
            "kind": "latex",
            "size": 36,
            "tex": "\\text{N}_2 + 3\\text{H}_2 \\rightleftharpoons 2\\text{NH}_3",
            "x": 250,
            "y": 100
          }
        },
        {
          "at_ms": 900,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "kcEq",
            "kind": "latex",
            "size": 32,
            "tex": "K_c = \\frac{[\\text{NH}_3]^2}{[\\text{N}_2][\\text{H}_2]^3}",
            "x": 250,
            "y": 180
          }
        },
