{"animath":"0.1","canvas":{"height":540,"width":960},"kind":"concept","level":"primary","subject":"math","title":"Adding fractions: 1/2 + 1/4","topic":"fractions","scenes":[{"caption":"Adding fractions","duration_ms":8500,"id":"s1","narration":"Let's add one half and one quarter. Watch how a quarter fits inside a half - exactly twice.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":44,"text":"1/2 + 1/4 = ?","x":120,"y":90}},{"at_ms":800,"do":"show","shape":{"id":"bar1","kind":"rect","fill":"#ffffff","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":160}},{"at_ms":900,"do":"show","shape":{"id":"half","kind":"rect","fill":"#7fb3e8","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":180,"x":120,"y":160}},{"at_ms":1100,"do":"show","shape":{"id":"lab1","kind":"text","size":30,"text":"1/2 of the bar is blue","x":500,"y":205}},{"at_ms":2600,"do":"show","shape":{"id":"bar2","kind":"rect","fill":"#ffffff","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":280}},{"at_ms":2700,"do":"show","shape":{"id":"quart","kind":"rect","fill":"#8fd694","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":280}},{"at_ms":2900,"do":"show","shape":{"id":"lab2","kind":"text","size":30,"text":"1/4 of the bar is green","x":500,"y":325}},{"at_ms":4800,"do":"move","target":"quart","to":{"x":120,"y":160},"dur_ms":900},{"at_ms":6000,"do":"move","target":"quart","to":{"x":210,"y":160},"dur_ms":900},{"at_ms":7200,"do":"caption","text":"A quarter fits inside a half, exactly twice"}]},{"caption":"Make the pieces the same size","duration_ms":7000,"id":"s2","narration":"We cannot add halves and quarters directly. Watch the blade split the half - now every piece is a quarter.","steps":[{"at_ms":0,"do":"show","shape":{"id":"bar","kind":"rect","fill":"#ffffff","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":200}},{"at_ms":200,"do":"show","shape":{"id":"h","kind":"rect","fill":"#7fb3e8","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":180,"x":120,"y":200}},{"at_ms":500,"do":"show","shape":{"id":"lab","kind":"text","size":34,"text":"1/2","x":500,"y":245}},{"at_ms":1800,"do":"show","shape":{"id":"cut","kind":"line","stroke":"#1a1a1a","width":3,"x1":300,"x2":300,"y1":200,"y2":205}},{"at_ms":2400,"do":"move","target":"cut","to":{"y2":270},"dur_ms":800},{"at_ms":3600,"do":"hide","target":"h"},{"at_ms":3700,"do":"show","shape":{"id":"qa","kind":"rect","fill":"#7fb3e8","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":200}},{"at_ms":3900,"do":"show","shape":{"id":"qb","kind":"rect","fill":"#7fb3e8","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":210,"y":200}},{"at_ms":4500,"do":"show","shape":{"id":"conv","kind":"text","size":38,"text":"1/2 = 2/4","x":120,"y":340}},{"at_ms":5800,"do":"caption","text":"Now every piece is a quarter - add the quarters"}]},{"caption":"Count the quarters","duration_ms":10000,"id":"s3","narration":"Two quarters plus one quarter is three quarters. The bottom number stays 4 because the piece size never changed.","steps":[{"at_ms":0,"do":"show","shape":{"id":"frame","kind":"rect","fill":"#ffffff","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":180}},{"at_ms":300,"do":"show","shape":{"id":"q1","kind":"rect","fill":"#7fb3e8","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":180}},{"at_ms":900,"do":"show","shape":{"id":"q2","kind":"rect","fill":"#7fb3e8","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":210,"y":180}},{"at_ms":1500,"do":"show","shape":{"id":"q3","kind":"rect","fill":"#8fd694","h":70,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":300,"y":180}},{"at_ms":2200,"do":"show","shape":{"id":"zone","kind":"rect","fill":"#f2f2f2","h":110,"stroke":"#1a1a1a","strokeWidth":2,"w":330,"x":550,"y":160}},{"at_ms":2400,"do":"move","target":"q1","to":{"x":560,"y":175},"dur_ms":900},{"at_ms":3000,"do":"move","target":"q2","to":{"x":655,"y":175},"dur_ms":900},{"at_ms":3600,"do":"move","target":"q3","to":{"x":750,"y":175},"dur_ms":900},{"at_ms":4800,"do":"show","shape":{"id":"eq","kind":"text","size":40,"text":"2/4 + 1/4 = 3/4","x":120,"y":320}},{"at_ms":6000,"do":"show","shape":{"id":"ghost","kind":"text","size":40,"text":"3/8?","x":560,"y":320,"color":"#8a1f1f"}},{"at_ms":7000,"do":"move","target":"ghost","to":{"y":480},"dur_ms":800},{"at_ms":8200,"do":"show","shape":{"id":"warn","kind":"text","size":26,"text":"The bottoms never add - pieces stay quarters","x":120,"y":390,"color":"#8a1f1f"}}]},{"caption":"Watch out: 1/2 + 1/4 is not 2/6","duration_ms":10000,"id":"s4","narration":"Watch out: the tempting wrong turn is adding the tops and bottoms, so 1/2 + 1/4 becomes 2/6. The bottom number names the piece size, so it cannot be added like the tops. The bottom number stays 4 because the piece size never changed: 1/2 + 1/4 = 2/4 + 1/4 = 3/4.","steps":[{"at_ms":0,"do":"show","shape":{"id":"bar","kind":"rect","fill":"#ffffff","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":180}},{"at_ms":300,"do":"show","shape":{"id":"c1","kind":"rect","fill":"#7fb3e8","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":560,"y":180}},{"at_ms":500,"do":"show","shape":{"id":"c2","kind":"rect","fill":"#7fb3e8","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":560,"y":270}},{"at_ms":700,"do":"show","shape":{"id":"c3","kind":"rect","fill":"#8fd694","h":64,"stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":560,"y":360}},{"at_ms":1400,"do":"move","target":"c1","to":{"x":120,"y":180},"dur_ms":900},{"at_ms":2600,"do":"move","target":"c2","to":{"x":210,"y":180},"dur_ms":900},{"at_ms":3800,"do":"move","target":"c3","to":{"x":300,"y":180},"dur_ms":900},{"at_ms":5200,"do":"show","shape":{"id":"t1","kind":"text","size":30,"text":"Same size -> add tops, keep bottom","x":120,"y":300}},{"at_ms":6600,"do":"show","shape":{"id":"t2","kind":"text","size":30,"text":"Different sizes -> convert, then add","x":120,"y":350}},{"at_ms":8300,"do":"show","shape":{"id":"t3","kind":"text","size":40,"text":"1/2 + 1/4 = 3/4","x":120,"y":430,"color":"#1f7a3a"}}]}]}
