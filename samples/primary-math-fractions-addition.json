s":2600,"do":"emphasize","dur_ms":900,"target":"cut"},{"at_ms":3800,"do":"show","shape":{"id":"conv","kind":"text","size":38,"text":"1/2 = 2/4","x":120,"y":340}},{"at_ms":5200,"do":"caption","text":"Now every piece is a quarter — add the quarters"}]},{"caption":"Count the quarters","duration_ms":8000,"id":"s3","narration":"Two quarters plus one quarter is three quarters. The bottom number stays 4 because the piece size never changed.","steps":[{"at_ms":0,"do":"show","shape":{"fill":"#ffffff","h":70,"id":"frame","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":180}},{"at_ms":300,"do":"show","shape":{"fill":"#7fb3e8","h":70,"id":"q1","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":180}},{"at_ms":900,"do":"show","shape":{"fill":"#7fb3e8","h":70,"id":"q2","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":210,"y":180}},{"at_ms":1500,"do":"show","shape":{"fill":"#8fd694","h":70,"id":"q3","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":300,"y":180}},{"at_ms":2400,"do":"show","shape":{"id":"eq","kind":"text","size":40,"text":"2/4 + 1/4 = 3/4","x":120,"y":320}},{"at_ms":3800,"do":"emphasize","dur_ms":1000,"target":"eq"},{"at_ms":5200,"do":"show","shape":{"color":"#8a1f1f","id":"warn","kind":"text","size":26,"text":"Not 2/6 — the pieces never changed size!","x":120,"y":390}}]},{"caption":"The takeaway","duration_ms":6000,"id":"s4","narration":"Same-size pieces: add the top numbers, keep the bottom. Different sizes: convert first, then add.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t1","kind":"text","size":30,"text":"1. Same size → add the tops, keep the bottom","x":120,"y":200}},{"at_ms":1500,"do":"show","shape":{"id":"t2","kind":"text","size":30,"text":"2. Different sizes → convert first, then add","x":120,"y":260}},{"at_ms":3000,"do":"show","shape":{"color":"#1f7a3a","id":"t3","kind":"text","size":40,"text":"1/2 + 1/4 = 3/4 ✓","x":120,"y":350}}]}],"subject":"math","title":"Adding fractions: 1/2 + 1/4","topic":"fractions"}