74c3c","id":"c4","kind":"circle","r":30,"stroke":"#e74c3c","width":2}},{"at_ms":1300,"do":"show","shape":{"cx":480,"cy":380,"fill":"#e74c3c","id":"c5","kind":"circle","r":30,"stroke":"#e74c3c","width":2}},{"at_ms":1500,"do":"show","shape":{"cx":660,"cy":380,"fill":"#e74c3c","id":"c6","kind":"circle","r":30,"stroke":"#e74c3c","width":2}},{"at_ms":1900,"do":"show","shape":{"id":"cL","kind":"text","size":22,"text":"positive ions","x":140,"y":300}},{"at_ms":2300,"do":"show","shape":{"cx":390,"cy":300,"fill":"#2471a3","id":"e1","kind":"circle","r":8,"stroke":"#2471a3","width":2}},{"at_ms":2500,"do":"show","shape":{"cx":570,"cy":300,"fill":"#2471a3","id":"e2","kind":"circle","r":8,"stroke":"#2471a3","width":2}},{"at_ms":2700,"do":"show","shape":{"cx":480,"cy":300,"fill":"#2471a3","id":"e3","kind":"circle","r":8,"stroke":"#2471a3","width":2}},{"at_ms":3000,"do":"show","shape":{"id":"eL","kind":"text","size":22,"text":"electron sea","x":740,"y":300}},{"at_ms":3600,"do":"move","dur_ms":2500,"target":"e1","to":{"cx":700,"cy":300}},{"at_ms":3800,"do":"move","dur_ms":2500,"target":"e2","to":{"cx":260,"cy":300}},{"at_ms":4000,"do":"move","dur_ms":2500,"target":"e3","to":{"cx":480,"cy":480}},{"at_ms":6700,"do":"show","shape":{"id":"t1","kind":"text","size":24,"text":"electrons flow → metals conduct","x":140,"y":500}},{"at_ms":7300,"do":"caption","text":"Delocalised electrons belong to the whole lattice."}]},{"caption":"Check the thinking","duration_ms":6500,"id":"s5","narration":"Shared does not mean given away. In a covalent bond the shared electrons stay attached to both nuclei — that is what holds the two atoms together.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"Check the thinking","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"id":"myth","kind":"text","size":28,"text":"❌ “Sharing means giving away.”","x":80,"y":170}},{"at_ms":1500,"do":"show","shape":{"cx":360,"cy":330,"fill":"#fdebd0","id":"nA","kind":"circle","r":36,"stroke":