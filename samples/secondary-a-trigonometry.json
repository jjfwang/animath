  "scenes": [
    {
      "id": "s1",
      "caption": "The two seed identities, on the unit circle",
      "narration": "Two identities grow all the others: sin squared plus cos squared equals one, and tan is sin over cos. On the unit circle this is just Pythagoras: the legs are cos and sin, the hypotenuse is 1.",
      "duration_ms": 8000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "id1",
            "kind": "latex",
            "tex": "\\sin^2 \\theta + \\cos^2 \\theta = 1",
            "x": 120,
            "y": 80,
            "size": 46,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 1100,
          "do": "show",
          "shape": {
            "id": "id2",
            "kind": "latex",
            "tex": "\\tan \\theta = \\frac{\\sin \\theta}{\\cos \\theta}",
            "x": 120,
            "y": 170,
            "size": 46,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 2200,
          "do": "show",
          "shape": {
            "id": "uc",
            "kind": "circle",
            "cx": 700,
            "cy": 350,
            "r": 110,
            "fill": "none",
            "stroke": "#1a1a1a",
