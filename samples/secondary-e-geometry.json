    {
      "caption": "Misconception: same area means congruent?",
      "duration_ms": 8000,
      "id": "s7",
      "narration": "A four-by-one rectangle and a two-by-two square both have area four \u2014 but they are clearly not the same shape. Equal area does not make shapes congruent. Congruence needs every matching side and every matching angle.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
