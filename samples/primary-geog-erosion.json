{"animath":"0.1","title":"Erosion: wind and water wear rock away","level":"primary","subject":"geography","topic":"erosion","kind":"concept","canvas":{"width":960,"height":540},"scenes":[{"id":"s1","caption":"A hard cliff stands by the sea","narration":"A cliff of hard rock stands by the sea. All day, the waves rush at it.","duration_ms":6000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"cliff","kind":"polygon","points":[[60,540],[60,200],[140,220],[130,300],[190,330],[180,420],[250,440],[250,540]],"fill":"#b0724a","stroke":"#7a4a2a","strokeWidth":3,"explain":"The cliff: hard rock standing against the sea."}},{"at_ms":300,"do":"show","shape":{"id":"sea","kind":"rect","x":250,"y":430,"w":650,"h":110,"fill":"#7fb3e8","stroke":"#3a7bd5","strokeWidth":3,"explain":"The sea: its waves carry energy to the cliff."}},{"at_ms":600,"do":"show","shape":{"id":"cliffLabel","kind":"text","x":90,"y":110,"text":"Cliff","size":34,"color":"#6b3d1e","explain":"Label: Cliff."}},{"at_ms":800,"do":"show","shape":{"id":"seaLabel","kind":"text","x":800,"y":300,"text":"Sea","size":34,"color":"#123c7a","explain":"Label: Sea."}},{"at_ms":1100,"do":"show","shape":{"id":"wave","kind":"arrow","x1":800,"y1":455,"x2":300,"y2":450,"stroke":"#2a6db5","width":5,"explain":"A wave: it rushes at the cliff."}},{"at_ms":1900,"do":"move","target":"wave","to":{"x1":660,"y1":452,"x2":270,"y2":445},"dur_ms":1400},{"at_ms":3800,"do":"caption","text":"The waves batter the cliff"}]},{"id":"s2","caption":"The waves loosen bits of rock","narration":"The battering cracks the cliff. A loose bit breaks off, and the current carries it away.","duration_ms":7000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"cliff2","kind":"polygon","points":[[60,540],[60,220],[120,240],[110,320],[170,340],[160,430],[220,450],[220,540]],"fill":"#b0724a","stroke":"#7a4a2a","strokeWidth":3,"explain":"The same cliff: the waves have struck it again and again."}},{"at_ms":500,"do":"show","shape":{"id":"crack","kind":"line","x1":150,"y1":330,"x2":195,"y2":360,"stroke":"#3a2a1a","width":4,"explain":"A crack: the battering has loosened this bit."}},{"at_ms":900,"do":"show","shape":{"id":"chip","kind":"polygon","points":[[150,330],[195,360],[185,395],[140,370]],"fill":"#c98d5f","stroke":"#7a4a2a","strokeWidth":2,"explain":"A loose bit of rock: it is about to break off."}},{"at_ms":1500,"do":"move","target":"chip","to":{"points":[[150,390],[195,420],[185,455],[140,430]]},"dur_ms":1200},{"at_ms":3200,"do":"show","shape":{"id":"flow","kind":"arrow","x1":260,"y1":470,"x2":700,"y2":470,"stroke":"#2a6db5","width":4,"explain":"The current: it carries loose bits along."}},{"at_ms":3800,"do":"move","target":"chip","to":{"points":[[430,420],[475,450],[465,485],[420,460]]},"dur_ms":2000},{"at_ms":6000,"do":"caption","text":"Loosened bits break off and wash away"}]},{"id":"s3","caption":"Moving water and wind do the wearing","narration":"Rocks do not crumble on their own. It is the moving water and wind that wear them away.","duration_ms":6000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"cliff3","kind":"polygon","points":[[60,540],[60,220],[120,240],[110,320],[170,340],[160,430],[220,450],[220,540]],"fill":"#b0724a","stroke":"#7a4a2a","strokeWidth":3,"explain":"The cliff: on a calm day nothing happens to it."}},{"at_ms":800,"do":"show","shape":{"id":"gust","kind":"arrow","x1":850,"y1":300,"x2":560,"y2":300,"stroke":"#5a9bd4","width":5,"explain":"Wind: moving air wearing at the rock."}},{"at_ms":1400,"do":"move","target":"gust","to":{"x1":620,"y1":300,"x2":300,"y2":300},"dur_ms":1200},{"at_ms":3000,"do":"show","shape":{"id":"pebble","kind":"circle","cx":300,"cy":380,"r":9,"fill":"#c98d5f","stroke":"#7a4a2a","strokeWidth":2,"explain":"A worn-off pebble: the wind did that."}},{"at_ms":3600,"do":"move","target":"pebble","to":{"cx":430,"cy":430},"dur_ms":1500},{"at_ms":5300,"do":"caption","text":"Rocks do not crumble on their own - moving water and wind do the work"}]}]}
