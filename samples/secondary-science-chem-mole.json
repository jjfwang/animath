{"animath": "0.1", "canvas": {"width": 960, "height": 540}, "kind": "concept", "level": "secondary", "subject": "science", "topic": "chem-mole", "title": "The mole: counting atoms by weighing", "scenes": [{"id": "s1", "caption": "A mole is a counting word", "narration": "Chemists count particles in moles, the same way a baker counts eggs in dozens. One dozen is 12 items; one mole is 6.02 × 10²³ items — far too many to count one by one, so we weigh moles instead of counting them.", "duration_ms": 9000, "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "x": 80, "y": 70, "size": 34, "text": "A mole is a counting word"}}, {"at_ms": 400, "do": "show", "shape": {"id": "dozL", "kind": "text", "x": 80, "y": 122, "size": 26, "text": "1 dozen = 12 eggs", "explain": "1 dozen = 12 eggs: a counting word, just like the mole."}}, {"at_ms": 800, "do": "show", "shape": {"id": "egg1", "kind": "circle", "cx": 130, "cy": 190, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 960, "do": "show", "shape": {"id": "egg2", "kind": "circle", "cx": 195, "cy": 190, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 1120, "do": "show", "shape": {"id": "egg3", "kind": "circle", "cx": 260, "cy": 190, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 1280, "do": "show", "shape": {"id": "egg4", "kind": "circle", "cx": 325, "cy": 190, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 1440, "do": "show", "shape": {"id": "egg5", "kind": "circle", "cx": 130, "cy": 245, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "egg6", "kind": "circle", "cx": 195, "cy": 245, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 1760, "do": "show", "shape": {"id": "egg7", "kind": "circle", "cx": 260, "cy": 245, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 1920, "do": "show", "shape": {"id": "egg8", "kind": "circle", "cx": 325, "cy": 245, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 2080, "do": "show", "shape": {"id": "egg9", "kind": "circle", "cx": 130, "cy": 300, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 2240, "do": "show", "shape": {"id": "egg10", "kind": "circle", "cx": 195, "cy": 300, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 2400, "do": "show", "shape": {"id": "egg11", "kind": "circle", "cx": 260, "cy": 300, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 2560, "do": "show", "shape": {"id": "egg12", "kind": "circle", "cx": 325, "cy": 300, "r": 14, "color": "#e8a33d", "explain": "An egg: one of the twelve in the dozen."}}, {"at_ms": 3200, "do": "show", "shape": {"id": "dozBox", "kind": "rect", "x": 92, "y": 158, "w": 302, "h": 202, "color": "#8a6d3b", "explain": "The dozen box: it holds 12 eggs, the way a mole holds 6.02 x 10^23 particles."}}, {"at_ms": 3400, "do": "move", "target": "egg1", "to": {"cx": 205, "cy": 245}, "dur_ms": 600}, {"at_ms": 3600, "do": "move", "target": "egg6", "to": {"cx": 295, "cy": 245}, "dur_ms": 600}, {"at_ms": 3800, "do": "move", "target": "egg11", "to": {"cx": 250, "cy": 305}, "dur_ms": 600}, {"at_ms": 4600, "do": "show", "shape": {"id": "avoL", "kind": "text", "x": 520, "y": 122, "size": 26, "text": "1 mole = 6.02 × 10²³ particles", "explain": "1 mole = 6.02 x 10^23 particles: Avogadro's number, far too many to count one by one."}}, {"at_ms": 4800, "do": "show", "shape": {"id": "a1", "kind": "circle", "cx": 560, "cy": 170, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 4920, "do": "show", "shape": {"id": "a2", "kind": "circle", "cx": 630, "cy": 150, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5040, "do": "show", "shape": {"id": "a3", "kind": "circle", "cx": 700, "cy": 165, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5160, "do": "show", "shape": {"id": "a4", "kind": "circle", "cx": 770, "cy": 150, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5280, "do": "show", "shape": {"id": "a5", "kind": "circle", "cx": 840, "cy": 170, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5400, "do": "show", "shape": {"id": "a6", "kind": "circle", "cx": 580, "cy": 235, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5520, "do": "show", "shape": {"id": "a7", "kind": "circle", "cx": 660, "cy": 240, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5640, "do": "show", "shape": {"id": "a8", "kind": "circle", "cx": 740, "cy": 240, "r": 10, "color": "#3a7bd5", "explain": "A particle: one of the 6.02 x 10^23 in a mole."}}, {"at_ms": 5850, "do": "move", "target": "a1", "to": {"cx": 600, "cy": 330}, "dur_ms": 700}, {"at_ms": 6000, "do": "move", "target": "a2", "to": {"cx": 655, "cy": 320}, "dur_ms": 700}, {"at_ms": 6150, "do": "move", "target": "a3", "to": {"cx": 710, "cy": 330}, "dur_ms": 700}, {"at_ms": 6300, "do": "move", "target": "a4", "to": {"cx": 765, "cy": 320}, "dur_ms": 700}, {"at_ms": 6450, "do": "move", "target": "a5", "to": {"cx": 620, "cy": 385}, "dur_ms": 700}, {"at_ms": 6600, "do": "move", "target": "a6", "to": {"cx": 675, "cy": 380}, "dur_ms": 700}, {"at_ms": 6750, "do": "move", "target": "a7", "to": {"cx": 730, "cy": 385}, "dur_ms": 700}, {"at_ms": 6900, "do": "move", "target": "a8", "to": {"cx": 785, "cy": 378}, "dur_ms": 700}, {"at_ms": 7000, "do": "show", "shape": {"id": "tooBig", "kind": "text", "x": 500, "y": 430, "size": 24, "text": "far too many to count one by one", "explain": "far too many to count one by one: that is why chemists weigh moles instead."}}, {"at_ms": 7800, "do": "show", "shape": {"id": "so", "kind": "text", "x": 80, "y": 470, "size": 24, "text": "…so we weigh moles instead of counting", "explain": "so we weigh moles instead of counting: the scale counts the atoms for us."}}]}, {"id": "s2", "caption": "Mass to moles", "narration": "The mass of one mole of carbon-12 is 12 grams — that is its molar mass. Weigh 12 grams of carbon and you have exactly one mole: the scale counted the atoms for you.", "duration_ms": 10000, "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "x": 80, "y": 70, "size": 34, "text": "Mass to moles"}}, {"at_ms": 400, "do": "show", "shape": {"id": "formula", "kind": "latex", "x": 80, "y": 170, "size": 40, "color": "#1f7a3a", "tex": "n = \\frac{m}{M}", "explain": "n = m / M: moles equals mass divided by molar mass."}}, {"at_ms": 900, "do": "show", "shape": {"id": "legend", "kind": "text", "x": 330, "y": 190, "size": 22, "text": "n = moles,  m = mass,  M = molar mass", "explain": "n = moles, m = mass, M = molar mass: the parts of the formula."}}, {"at_ms": 1300, "do": "show", "shape": {"id": "pan", "kind": "rect", "x": 300, "y": 400, "w": 360, "h": 18, "color": "#555", "explain": "The balance pan: it holds the carbon being weighed."}}, {"at_ms": 1300, "do": "show", "shape": {"id": "stem", "kind": "rect", "x": 470, "y": 418, "w": 20, "h": 60, "color": "#555", "explain": "The balance stem: it supports the pan."}}, {"at_ms": 1400, "do": "show", "shape": {"id": "given", "kind": "text", "x": 80, "y": 130, "size": 22, "text": "M of carbon-12 = 12 g/mol", "explain": "M of carbon-12 = 12 g/mol: one mole of carbon-12 weighs 12 grams."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "cd1", "kind": "circle", "cx": 640, "cy": 120, "r": 12, "color": "#333", "explain": "Carbon atoms on the pan: being weighed, not counted."}}, {"at_ms": 1800, "do": "show", "shape": {"id": "cd2", "kind": "circle", "cx": 640, "cy": 120, "r": 12, "color": "#333", "explain": "Carbon atoms on the pan: being weighed, not counted."}}, {"at_ms": 2000, "do": "show", "shape": {"id": "cd3", "kind": "circle", "cx": 640, "cy": 120, "r": 12, "color": "#333", "explain": "Carbon atoms on the pan: being weighed, not counted."}}, {"at_ms": 2200, "do": "show", "shape": {"id": "cd4", "kind": "circle", "cx": 640, "cy": 120, "r": 12, "color": "#333", "explain": "Carbon atoms on the pan: being weighed, not counted."}}, {"at_ms": 2400, "do": "show", "shape": {"id": "cd5", "kind": "circle", "cx": 640, "cy": 120, "r": 12, "color": "#333", "explain": "Carbon atoms on the pan: being weighed, not counted."}}, {"at_ms": 2800, "do": "move", "target": "cd1", "to": {"cx": 380, "cy": 388}, "dur_ms": 800}, {"at_ms": 3100, "do": "move", "target": "cd2", "to": {"cx": 430, "cy": 388}, "dur_ms": 800}, {"at_ms": 3400, "do": "move", "target": "cd3", "to": {"cx": 480, "cy": 388}, "dur_ms": 800}, {"at_ms": 3700, "do": "move", "target": "cd4", "to": {"cx": 530, "cy": 388}, "dur_ms": 800}, {"at_ms": 4000, "do": "move", "target": "cd5", "to": {"cx": 580, "cy": 388}, "dur_ms": 800}, {"at_ms": 4600, "do": "show", "shape": {"id": "readL", "kind": "text", "x": 690, "y": 390, "size": 26, "text": "12 g", "explain": "12 g: the scale reading."}}, {"at_ms": 5200, "do": "show", "shape": {"id": "mVal", "kind": "text", "x": 690, "y": 240, "size": 26, "text": "m = 12 g", "explain": "m = 12 g: the mass going into the formula."}}, {"at_ms": 5600, "do": "move", "target": "mVal", "to": {"x": 400, "y": 240}, "dur_ms": 700}, {"at_ms": 6600, "do": "show", "shape": {"id": "work", "kind": "latex", "x": 80, "y": 440, "size": 36, "color": "#1f7a3a", "tex": "n = \\frac{12\\ \\text{g}}{12\\ \\text{g/mol}} = 1\\ \\text{mol}", "explain": "The working: 12 g divided by 12 g/mol gives exactly 1 mole."}}, {"at_ms": 7400, "do": "emphasize", "target": "work", "dur_ms": 900}, {"at_ms": 8000, "do": "show", "shape": {"id": "ans", "kind": "text", "x": 620, "y": 470, "size": 24, "text": "weighed, not counted", "explain": "weighed, not counted: the scale did the counting for us."}}, {"at_ms": 8400, "do": "move", "target": "ans", "to": {"x": 620, "y": 240}, "dur_ms": 600}]}, {"id": "s3", "caption": "Mole ratios", "narration": "Balanced equations count moles, not grams: two moles of hydrogen react with one of oxygen to make two of water. Double the hydrogen and you must double the oxygen — the ratio never changes.", "duration_ms": 10500, "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "x": 80, "y": 70, "size": 34, "text": "Mole ratios"}}, {"at_ms": 400, "do": "show", "shape": {"id": "eqn", "kind": "text", "x": 80, "y": 118, "size": 30, "text": "2 H₂ + O₂ → 2 H₂O", "explain": "2 H2 + O2 -> 2 H2O: the balanced equation counts moles, not grams."}}, {"at_ms": 900, "do": "show", "shape": {"id": "ratio", "kind": "text", "x": 80, "y": 160, "size": 22, "text": "moles:   2   :   1   :   2", "explain": "moles 2 : 1 : 2: the fixed ratio the equation demands."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "h2a", "kind": "circle", "cx": 120, "cy": 300, "r": 14, "color": "#3a7bd5", "explain": "A hydrogen molecule: two H atoms joined as H2."}}, {"at_ms": 1400, "do": "show", "shape": {"id": "h2b", "kind": "circle", "cx": 120, "cy": 360, "r": 14, "color": "#3a7bd5", "explain": "A hydrogen molecule: two H atoms joined as H2."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "o1", "kind": "circle", "cx": 120, "cy": 430, "r": 14, "color": "#d53a3a", "explain": "An oxygen molecule: O2."}}, {"at_ms": 2200, "do": "show", "shape": {"id": "rxnArrow", "kind": "arrow", "x1": 560, "y1": 350, "x2": 700, "y2": 350, "color": "#333", "explain": "The reaction arrow: reactants turn into products."}}, {"at_ms": 2600, "do": "move", "target": "h2a", "to": {"cx": 420, "cy": 300}, "dur_ms": 800}, {"at_ms": 2800, "do": "move", "target": "h2b", "to": {"cx": 420, "cy": 360}, "dur_ms": 800}, {"at_ms": 3000, "do": "move", "target": "o1", "to": {"cx": 460, "cy": 330}, "dur_ms": 800}, {"at_ms": 4000, "do": "hide", "target": "h2a"}, {"at_ms": 4000, "do": "hide", "target": "h2b"}, {"at_ms": 4000, "do": "hide", "target": "o1"}, {"at_ms": 4100, "do": "show", "shape": {"id": "h2o1", "kind": "circle", "cx": 470, "cy": 330, "r": 14, "color": "#6aa84f", "explain": "A water molecule: H2O, the product."}}, {"at_ms": 4200, "do": "show", "shape": {"id": "h2o2", "kind": "circle", "cx": 430, "cy": 330, "r": 14, "color": "#6aa84f", "explain": "A water molecule: H2O, the product."}}, {"at_ms": 4400, "do": "move", "target": "h2o1", "to": {"cx": 780, "cy": 310}, "dur_ms": 800}, {"at_ms": 4600, "do": "move", "target": "h2o2", "to": {"cx": 780, "cy": 380}, "dur_ms": 800}, {"at_ms": 5600, "do": "show", "shape": {"id": "q", "kind": "text", "x": 80, "y": 470, "size": 24, "text": "How much O₂ for 4 mol of H₂?", "explain": "How much O2 for 4 mol of H2?: scale the whole ratio."}}, {"at_ms": 6000, "do": "show", "shape": {"id": "scaleL", "kind": "text", "x": 80, "y": 210, "size": 22, "text": "double everything", "explain": "double everything: the 2 : 1 : 2 ratio stays fixed when scaled."}}, {"at_ms": 6200, "do": "show", "shape": {"id": "h2c", "kind": "circle", "cx": 120, "cy": 300, "r": 14, "color": "#3a7bd5", "explain": "A hydrogen molecule: H2, doubled for the scale-up."}}, {"at_ms": 6400, "do": "show", "shape": {"id": "h2d", "kind": "circle", "cx": 120, "cy": 360, "r": 14, "color": "#3a7bd5", "explain": "A hydrogen molecule: H2, doubled for the scale-up."}}, {"at_ms": 6600, "do": "show", "shape": {"id": "o2", "kind": "circle", "cx": 120, "cy": 430, "r": 14, "color": "#d53a3a", "explain": "An oxygen molecule: O2, doubled to 2 mol."}}, {"at_ms": 7000, "do": "move", "target": "h2c", "to": {"cx": 420, "cy": 300}, "dur_ms": 800}, {"at_ms": 7200, "do": "move", "target": "h2d", "to": {"cx": 420, "cy": 360}, "dur_ms": 800}, {"at_ms": 7400, "do": "move", "target": "o2", "to": {"cx": 460, "cy": 330}, "dur_ms": 800}, {"at_ms": 8400, "do": "hide", "target": "h2c"}, {"at_ms": 8400, "do": "hide", "target": "h2d"}, {"at_ms": 8400, "do": "hide", "target": "o2"}, {"at_ms": 8500, "do": "show", "shape": {"id": "h2o3", "kind": "circle", "cx": 470, "cy": 330, "r": 14, "color": "#6aa84f", "explain": "A water molecule: H2O, doubled to 4 mol."}}, {"at_ms": 8600, "do": "show", "shape": {"id": "h2o4", "kind": "circle", "cx": 430, "cy": 330, "r": 14, "color": "#6aa84f", "explain": "A water molecule: H2O, doubled to 4 mol."}}, {"at_ms": 8800, "do": "move", "target": "h2o3", "to": {"cx": 850, "cy": 310}, "dur_ms": 800}, {"at_ms": 9000, "do": "move", "target": "h2o4", "to": {"cx": 850, "cy": 380}, "dur_ms": 800}, {"at_ms": 10000, "do": "show", "shape": {"id": "ans2", "kind": "text", "x": 80, "y": 250, "size": 22, "text": "→ 2 mol O₂, 4 mol H₂O", "explain": "2 mol O2 and 4 mol H2O: doubling the 2 : 1 : 2 ratio."}}]}, {"id": "s4", "caption": "A common mistake: one mole of everything weighs the same", "narration": "One mole of anything weighs the same: an easy mistake, because a mole feels like a fixed bag of the same size, so every mole feels equally heavy. Mass = moles x molar mass: one mole of hydrogen is 1 g but one mole of oxygen is 16 g.", "duration_ms": 8000, "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "x": 80, "y": 70, "size": 34, "text": "Check the thinking"}}, {"at_ms": 400, "do": "show", "shape": {"id": "myth", "kind": "text", "x": 80, "y": 122, "size": 26, "text": "❌ 1 mol = 1 gram", "explain": "Myth: 1 mol = 1 gram. A mole counts particles, not grams."}}, {"at_ms": 1000, "do": "show", "shape": {"id": "cLab", "kind": "text", "x": 120, "y": 190, "size": 22, "text": "carbon", "explain": "carbon: one mole of it weighs 12 g."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "panL", "kind": "rect", "x": 120, "y": 400, "w": 240, "h": 16, "color": 