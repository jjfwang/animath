 {"at_ms": 4800, "do": "move", "target": "wc1", "to": {"cx": 660, "cy": 388}, "dur_ms": 700}, {"at_ms": 5100, "do": "move", "target": "wc2", "to": {"cx": 720, "cy": 388}, "dur_ms": 700}, {"at_ms": 5400, "do": "move", "target": "wc3", "to": {"cx": 780, "cy": 388}, "dur_ms": 700}, {"at_ms": 6000, "do": "show", "shape": {"id": "wL", "kind": "text", "x": 600, "y": 230, "size": 22, "text": "1 mol of H₂O = 18 g", "explain": "1 mol of H2O = 18 g: the same number of particles, water's mass."}}, {"at_ms": 6400, "do": "hide", "target": "myth"}, {"at_ms": 6600, "do": "show", "shape": {"id": "fix", "kind": "text", "x": 80, "y": 470, "size": 24, "text": "Same number of particles. Different mass.", "explain": "Same number of particles. Different mass: the molar mass decides the weight."}}]}]}