":"co2dot","to":{"cx":460,"cy":388},"dur_ms":900},{"at_ms":9500,"do":"show","shape":{"id":"fossil","kind":"text","x":60,"y":460,"text":"fossil fuels: ancient carbon burned all at once","size":24}},{"at_ms":10000,"do":"move","target":"co2dot","to":{"cx":500,"cy":112},"dur_ms":900},{"at_ms":10600,"do":"caption","text":"Carbon loops: photosynthesis in, respiration out"}]},{"id":"s5","caption":"Conservation: when habitat shrinks, species vanish","narration":"The fastest way to lose species is to lose their habitat. Watch each patch shrink under pressure — and its species label vanishes with it. Protected corridors fight back by reconnecting the fragments.","duration_ms":10000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"p1","kind":"rect","x":90,"y":150,"w":240,"h":150,"stroke":"#1a7f37","strokeWidth":2,"fill":"#bfe3c6"}},{"at_ms":400,"do":"show","shape":{"id":"p2","kind":"rect","x":360,"y":150,"w":240,"h":150,"stroke":"#1a7f37","strokeWidth":2,"fill":"#bfe3c6"}},{"at_ms":800,"do":"show","shape":{"id":"p3","kind":"rect","x":630,"y":150,"w":240,"h":150,"stroke":"#1a7f37","strokeWidth":2,"fill":"#bfe3c6"}},{"at_ms":1200,"do":"show","shape":{"id":"sp1","kind":"text","x":130,"y":220,"text":"hornbills","size":26}},{"at_ms":1600,"do":"show","shape":{"id":"sp2","kind":"text","x":400,"y":220,"text":"pangolins","size":26}},{"at_ms":2000,"do":"show","shape":{"id":"sp3","kind":"text","x":670,"y":220,"text":"tigers","size":26}},{"at_ms":2400,"do":"show","shape":{"id":"pr1","kind":"arrow","x1":210,"y1":60,"x2":210,"y2":140,"stroke":"#b00020","width":3}},{"at_ms":2800,"do":"show","shape":{"id":"pr2","kind":"arrow","x1":480,"y1":60,"x2":480,"y2":140,"stroke":"#b00020","width":3}},{"at_ms":3200,"do":"show","shape":{"id":"pr3","kind":"arrow","x1":750,"y1":60,"x2":750,"y2":140,"stroke":"#b00020","width":3}},{"at_ms":3600,"do":"move","target":"p1","to":{"x":160,"y":195,"w":100,"h":60},"dur_ms":1200},{"at_ms":4800,"do":"hide","target":"sp1"},{"at_ms":5000,"do":"move","target":"p2","to":{"x":430,"y":195,"w":100,"h":60},"dur_ms":1200},{"at_ms":6200,"do":"hide","target":"sp2"},{"at_ms":6400,"do":"move","target":"p3","to":{"x":700,"y":195,"w":100,"h":60},"dur_ms":1200},{"at_ms":7600,"do":"hide","target":"sp3"},{"at_ms":8000,"do":"show","shape":{"id":"corridor","kind":"rect","x":80,"y":140,"w":810,"h":170,"stroke":"#1a7f37","strokeWidth":3}},{"at_ms":8400,"do":"show","shape":{"id":"corrLabel","kind":"text","x":90,"y":340,"text":"protected corridors connect the fragments","size":24}},{"at_ms":9200,"do":"caption","text":"Habitat shrinks; species vanish with it"}]},{"id":"s6","caption":"A common mistake: energy is not recycled","narration":"A common mistake: energy is recycled through the ecosystem. The \"cycle of life\" language makes energy sound like it loops round forever. Energy flows one way — sunlight in, heat out: the red dot enters as sunlight and leaves as heat, never returning. What is recycled is matter — carbon, nitrogen and water: the blue carbon dot loops round and round.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"sun","kind":"circle","cx":120,"cy":120,"r":30,"fill":"#f5c518"}},{"at_ms":600,"do":"show","shape":{"id":"plant","kind":"text","x":300,"y":120,"text":"plants","size":28}},{"at_ms":1200,"do":"show","shape":{"id":"animal","kind":"text","x":480,"y":120,"text":"animals","size":28}},{"at_ms":1800,"do":"show","shape":{"id":"heat","kind":"text","x":700,"y":120,"text":"heat escapes","size":28,"color":"#b00020"}},{"at_ms":2400,"do":"show","shape":{"id":"eDot","kind":"circle","cx":120,"cy":120,"r":12,"fill":"#b00020"}},{"at_ms":3000,"do":"show","shape":{"id":"track","kind":"rect","x":290,"y":330,"w":380,"h":120,"stroke":"#1a56db","strokeWidth":2}},{"at_ms":3050,"do":"move","target":"eDot","to":{"cx":300,"cy":120},"dur_ms":600},{"at_ms":3400,"do":"show","shape":{"id":"cplants","kind":"text","x":300,"y":370,"text":"plants","size":24}},{"at_ms":3800,"do":"move","target":"eDot","to":{"cx":480,"cy":120},"dur_ms":600},{"at_ms