{"animath":"0.1","canvas":{"height":540,"width":960},"kind":"concept","level":"primary","scenes":[{"caption":"Speed is distance per hour","duration_ms":9000,"id":"s1","narration":"Speed tells how far you go in one hour. A bus at sixty kilometres per hour covers sixty kilometres every single hour.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":44,"text":"Speed: distance in one hour","x":120,"y":90}},{"at_ms":600,"do":"show","shape":{"id":"track","kind":"arrow","stroke":"#1a1a1a","width":4,"x1":120,"x2":600,"y1":320,"y2":320}},{"at_ms":700,"do":"show","shape":{"fill":"#e8a13d","h":46,"id":"car","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":297}},{"at_ms":1200,"do":"show","shape":{"id":"labStart","kind":"text","size":26,"text":"start","x":120,"y":375}},{"at_ms":1400,"do":"show","shape":{"id":"labEnd","kind":"text","size":26,"text":"finish","x":610,"y":375}},{"at_ms":2000,"do":"move","dur_ms":2000,"target":"car","to":{"x":270,"y":297}},{"at_ms":2600,"do":"show","shape":{"id":"eq1","kind":"text","size":34,"text":"speed = distance ÷ time","x":520,"y":180}},{"at_ms":4000,"do":"show","shape":{"id":"eq2","kind":"text","size":34,"text":"distance = speed × time","x":520,"y":250}},{"at_ms":4500,"do":"move","dur_ms":2000,"target":"car","to":{"x":420,"y":297}},{"at_ms":5600,"do":"emphasize","dur_ms":1000,"target":"eq2"},{"at_ms":7600,"do":"caption","text":"Speed tells how far each hour takes you"}]},{"caption":"60 km/h for 2.5 hours","duration_ms":10000,"id":"s2","narration":"The bus runs at sixty kilometres per hour for two and a half hours. Watch it pass sixty, then one hundred and twenty, then reach one hundred and fifty kilometres.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":44,"text":"60 km/h for 2.5 hours","x":120,"y":90}},{"at_ms":600,"do":"show","shape":{"id":"track","kind":"arrow","stroke":"#1a1a1a","width":4,"x1":120,"x2":600,"y1":320,"y2":320}},{"at_ms":1400,"do":"show","shape":{"id":"m1","kind":"line","stroke":"#1a1a1a","width":2,"x1":312,"x2":312,"y1":305,"y2":335}},{"at_ms":1500,"do":"show","shape":{"id":"m1lab","kind":"text","size":26,"text":"60 km","x":292,"y":368}},{"at_ms":1700,"do":"show","shape":{"id":"m2","kind":"line","stroke":"#1a1a1a","width":2,"x1":504,"x2":504,"y1":305,"y2":335}},{"at_ms":1800,"do":"show","shape":{"id":"m2lab","kind":"text","size":26,"text":"120 km","x":474,"y":368}},{"at_ms":2000,"do":"show","shape":{"id":"m3","kind":"line","stroke":"#1a1a1a","width":2,"x1":600,"x2":600,"y1":305,"y2":335}},{"at_ms":2100,"do":"show","shape":{"id":"m3lab","kind":"text","size":26,"text":"150 km","x":570,"y":368}},{"at_ms":2200,"do":"show","shape":{"fill":"#e8a13d","h":46,"id":"car","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":297}},{"at_ms":2600,"do":"move","dur_ms":2200,"target":"car","to":{"x":312,"y":297}},{"at_ms":5200,"do":"show","shape":{"id":"eq1","kind":"text","size":36,"text":"distance = 60 × 2.5","x":520,"y":170}},{"at_ms":5400,"do":"move","dur_ms":2200,"target":"car","to":{"x":504,"y":297}},{"at_ms":6000,"do":"show","shape":{"color":"#1f7a3a","id":"eq2","kind":"text","size":40,"text":"= 150 km ✓","x":520,"y":240}},{"at_ms":6600,"do":"emphasize","dur_ms":1000,"target":"eq2"},{"at_ms":7800,"do":"move","dur_ms":1200,"target":"car","to":{"x":600,"y":297}},{"at_ms":9200,"do":"caption","text":"Multiply the speed by the hours"}]},{"caption":"Watch out: speed is not distance","duration_ms":8000,"id":"s3","narration":"Careful: sixty kilometres per hour is a speed, not a distance. After only half an hour the bus has gone thirty kilometres — not sixty.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":36,"text":"60 km/h for ½ hour — is that 60 km?","x":120,"y":140}},{"at_ms":1400,"do":"show","shape":{"color":"#8a1f1f","id":"warn","kind":"text","size":30,"text":"No. Speed is not distance —","x":120,"y":205}},{"at_ms":1600,"do":"show","shape":{"color":"#8a1f1f","id":"warn2","kind":"text","size":30,"text":"half the time, half the distance.","x":120,"y":245}},{"at_ms":2800,"do":"show","shape":{"id":"track","kind":"arrow","stroke":"#1a1a1a","width":4,"x1":120,"x2":600,"y1":320,"y2":320}},{"at_ms":3200,"do":"show","shape":{"id":"half","kind":"line","stroke":"#8a1f1f","width":3,"x1":360,"x2":360,"y1":305,"y2":335}},{"at_ms":3400,"do":"show","shape":{"id":"halflab","kind":"text","size":26,"text":"½ hour","x":336,"y":368}},{"at_ms":3800,"do":"show","shape":{"fill":"#e8a13d","h":46,"id":"car","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":297}},{"at_ms":4200,"do":"move","dur_ms":2000,"target":"car","to":{"x":270,"y":297}},{"at_ms":6200,"do":"show","shape":{"id":"eq","kind":"text","size":36,"text":"60 × 1/2 = 30 km","x":520,"y":295}},{"at_ms":6800,"do":"emphasize","dur_ms":1000,"target":"eq"},{"at_ms":7400,"do":"caption","text":"Time matters as much as speed"}]},{"caption":"The takeaway","duration_ms":6000,"id":"s4","narration":"Distance, speed, and time are one family: distance equals speed times time, and you can flip the formula either way.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t1","kind":"text","size":30,"text":"1. distance = speed × time","x":120,"y":200}},{"at_ms":1500,"do":"show","shape":{"id":"t2","kind":"text","size":30,"text":"2. speed = distance ÷ time","x":120,"y":260}},{"at_ms":3000,"do":"show","shape":{"color":"#1f7a3a","id":"t3","kind":"text","size":40,"text":"3. time = distance ÷ speed ✓","x":120,"y":350}}]}],"subject":"math","title":"Rate and speed: d = s × t","topic":"rate-speed"}