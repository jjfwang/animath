{"animath": "0.1", "title": "Rate and speed: d = s × t", "level": "primary", "subject": "math", "topic": "rate-speed", "kind": "concept", "canvas": {"width": 960, "height": 540}, "scenes": [{"id": "s1", "caption": "Speed is distance per hour", "duration_ms": 10000, "narration": "Speed tells how far you go in one hour. A bus at sixty kilometres per hour covers sixty kilometres every single hour.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "q", "kind": "text", "text": "Speed: distance in one hour", "size": 44, "x": 120, "y": 90, "explain": "The idea: speed is the distance covered in one hour."}}, {"at_ms": 600, "do": "show", "shape": {"id": "track", "kind": "arrow", "x1": 120, "y1": 320, "x2": 950, "y2": 320, "stroke": "#1a1a1a", "width": 4, "explain": "The road: the bus travels along it at 60 km per hour."}}, {"at_ms": 800, "do": "show", "shape": {"id": "car", "kind": "rect", "x": 120, "y": 297, "w": 90, "h": 46, "fill": "#e8a13d", "stroke": "#1a1a1a", "strokeWidth": 2, "explain": "The bus: it covers 60 km every hour."}}, {"at_ms": 1000, "do": "show", "shape": {"id": "labStart", "kind": "text", "text": "start", "size": 26, "x": 120, "y": 375, "explain": "The start of the journey."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "tick1", "kind": "line", "x1": 360, "y1": 310, "x2": 360, "y2": 330, "stroke": "#1a1a1a", "width": 3, "explain": "The 1-hour mark."}}, {"at_ms": 1250, "do": "show", "shape": {"id": "h1lab", "kind": "text", "text": "1 hour", "size": 24, "x": 332, "y": 375, "explain": "After 1 hour."}}, {"at_ms": 1350, "do": "show", "shape": {"id": "tick2", "kind": "line", "x1": 600, "y1": 310, "x2": 600, "y2": 330, "stroke": "#1a1a1a", "width": 3, "explain": "The 2-hour mark."}}, {"at_ms": 1400, "do": "show", "shape": {"id": "h2lab", "kind": "text", "text": "2 hours", "size": 24, "x": 568, "y": 375, "explain": "After 2 hours."}}, {"at_ms": 1500, "do": "show", "shape": {"id": "tick3", "kind": "line", "x1": 840, "y1": 310, "x2": 840, "y2": 330, "strok