52, "explain": "The chip label: 180 km."}}, {"at_ms": 9400, "do": "hide", "target": "ro2"}, {"at_ms": 9450, "do": "show", "shape": {"id": "ro3", "kind": "text", "text": "180 km so far", "size": 30, "x": 728, "y": 150, "explain": "The running total: 180 km so far."}}, {"at_ms": 9700, "do": "caption", "text": "Speed tells how far each hour takes you"}]}, {"id": "s2", "caption": "60 km/h for 2.5 hours", "duration_ms": 10000, "narration": "The bus runs at sixty kilometres per hour for two and a half hours. Watch it pass sixty, then one hundred and twenty, then reach one hundred and fifty kilometres.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "q", "kind": "text", "text": "60 km/h for 2.5 hours", "size": 44, "x": 120, "y": 90, "explain": "The problem: 60 km per hour for 2.5 hours."}}, {"at_ms": 600, "do": "show", "shape": {"id": "track", "kind": "arrow", "x1": 120, "y1": 260, "x2": 840, "y2": 260, "stroke": "#1a1a1a", "width": 4, "explain": "The road the bus travels on."}}, {"at_ms": 800, "do": "show", "shape": {"id": "car", "kind": "rect", "x": 120, "y": 237, "w": 90, "h": 46, "fill": "#e8a13d", "stroke": "#1a1a1a", "strokeWidth": 2, "explain": "The bus travelling at 60 km per hour."}}, {"at_ms": 1000, "do": "show", "shape": {"id": "m1", "kind": "line", "x1": 360, "y1": 250, "x2": 360, "y2": 270, "stroke": "#1a1a1a", "width": 3, "explain": "The 60 km mark."}}, {"at_ms": 1050, "do": "show", "shape": {"id": "m1lab", "kind": "text", "text": "60 km", "size": 26, "x": 332, "y": 315, "explain": "The label: 60 km."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "m2", "kind": "line", "x1": 600, "y1": 250, "x2": 600, "y2": 270, "stroke": "#1a1a1a", "width": 3, "explain": "The 120 km mark."}}, {"at_ms": 1250, "do": "show", "shape": {"id": "m2lab", "kind": "text", "text": "120 km", "size": 26, "x": 566, "y": 315, "explain": "The label: 120 km."}}, {"at_ms": 1400, "do": "show", "shape": {"id": "m3", "kind": "line", "x1": 720, "y1": 250, "x2": 720, "y2": 270, "stroke": "#1a1a1a", "width": 3, "explain": "The 150 km mark: 2.5 hours of travel."}}, {"at_ms": 1450, "do": "show", "shape": {"id": "m3lab", "kind": "text", "text": "150 km", "size": 26, "x": 686, "y": 315, "explain": "The label: 150 km."}}, {"at_ms": 2000, "do": "move", "target": "car", "to": {"x": 360, "y": 237}, "dur_ms": 1800}, {"at_ms": 3900, "do": "show", "shape": {"id": "chip1", "kind": "rect", "x": 300, "y": 130, "w": 120, "h": 44, "fill": "#dbe7ff", "stroke": "#315fd6", "strokeWidth": 2, "explain": "The first hour's distance: 60 km."}}, {"at_ms": 3950, "do": "show", "shape": {"id": "chip1t", "kind": "text", "text": "60 km", "size": 30, "x": 313, "y": 162, "explain": "The chip label: 60 km."}}, {"at_ms": 4300, "do": "move", "target": "car", "to": {"x": 600, "y": 237}, "dur_ms": 1800}, {"at_ms": 4400, "do": "show", "shape": {"id": "bar1", "kind": "rect", "x": 120, "y": 380, "w": 240, "h": 30, "fill": "#7bc96f", "stroke": "#2e7d32", "strokeWidth": 2, "explain": "The bar for the first hour: 60 km."}}, {"at_ms": 6200, "do": "show", "shape": {"id": "chip2", "kind": "rect", "x": 540, "y": 130, "w": 120, "h": 44, "fill": "#dbe7ff", "stroke": "#315fd6", "strokeWidth": 2, "explain": "The second hour's distance: 120 km."}}, {"at_ms": 6250, "do": "show", "shape": {"id": "chip2t", "kind": "text", "text": "120 km", "size": 30, "x": 544, "y": 162, "explain": "The chip label: 120 km."}}, {"at_ms": 6300, "do": "show", "shape": {"id": "bar2", "kind": "rect", "x": 360, "y": 380, "w": 240, "h": 30, "fill": "#7bc96f", "stroke": "#2e7d32", "strokeWidth": 2, "explain": "The bar for the second hour: another 60 km."}}, {"at_ms": 6600, "do": "move", "target": "car", "to": {"x": 720, "y": 237}, "dur_ms": 1400}, {"at_ms": 8100, "do": "show", "shape": {"id": "chip3", "kind": "rect", "x": 660, "y": 130, "w": 120, "h": 44, "fill": "#dbe7ff", "stroke": "#315fd6", "strokeWidth": 2, "explain": "The half hour's distance: 30 km more, 150 km total."}}, {"at_ms": 8150, "do": "show", "shape": {"id": "chip3t", "kind": "text", "text": "150 km", "size": 30, "x": 664, "y": 162, "explain": "The chip label: 150 km."}}, {"at_ms": 8200, "do": "show", "shape": {"id": "bar3", "kind": "rect", "x": 600, "y": 380, "w": 120, "h": 30, "fill": "#7bc96f", "stroke": "#2e7d32", "strokeWidth": 2, "explain": "The bar for the half hour: half a 60 km bar."}}, {"at_ms": 8500, "do": "show", "shape": {"id": "spChip", "kind": "text", "text": "60 km/h", "size": 34, "x": 180, "y": 480, "explain": "The speed: 60 km per hour."}}, {"at_ms": 8700, "do": "show", "shape": {"id": "opChip", "kind": "text", "text": "×", "size": 40, "x": 350, "y": 480, "explain": "Multiply: distance is speed times time."}}, {"at_ms": 8900, "do": "show", "shape": {"id": "tChip", "kind": "text", "text": "2.5 h", "size": 34, "x": 400, "y": 480, "explain": "The time: 2.5 hours."}}, {"at_ms": 9100, "do": "show", "shape": {"id": "eqChip", "kind": "text", "text": "=", "size": 40, "x": 530, "y": 480, "explain": "Equals."}}, {"at_ms": 9200, "do": "show", "shape": {"id": "resChip", "kind": "text", "text": "150 km", "size": 34, "x": 570, "y": 480, "explain": "The answer: 150 km."}}, {"at_ms": 9500, "do": "caption", "text": "Multiply: speed × time = distance"}]}, {"id": "s3", "caption": "Watch out: speed is not distance", "duration_ms": 8000, "narration": "Careful: sixty kilometres per hour is a speed, not a distance. After only half an hour the bus has gone thirty kilometres — not sixty.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "q", "kind": "text", "text": "60 km/h for ½ hour — is that 60 km?", "size": 40, "x": 120, "y": 90, "explain": "The trap: is 60 km per hour for half an hour 60 km?"}}, {"at_ms": 1200, "do": "show", "shape": {"id": "track", "kind": "arrow", "x1": 120, "y1": 320, "x2": 480, "y2": 320, "stroke": "#1a1a1a", "width": 4, "explain": "The short road: only half an hour of travel."}}, {"at_ms": 1400, "do": "show", "shape": {"id": "half", "kind": "line", "x1": 300, "y1": 310, "x2": 300, "y2": 330, "stroke": "#1a1a1a", "width": 3, "explain": "The halfway mark: half an hour."}}, {"at_ms": 1450, "do": "show", "shape": {"id": "halflab", "kind": "text", "text": "½ hour", "size": 26, "x": 268, "y": 375, "explain": "The label: half an hour."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "wrongChip", "kind": "rect", "x": 700, "y": 240, "w": 130, "h": 44, "fill": "#f5c6c6", "stroke": "#c0392b", "strokeWidth": 2, "explain": "The wrong answer: 60 km."}}, {"at_ms": 1650, "do": "show", "shape": {"id": "wrongT", "kind": "text", "text": "60 km?", "size": 30, "x": 722, "y": 272, "explain": "The mistake: reading the speed as the distance."}}, {"at_ms": 1800, "do": "show", "shape": {"id": "car", "kind": "rect", "x": 120, "y": 297, "w": 90, "h": 46, "fill": "#e8a13d", "stroke": "#1a1a1a", "strokeWidth": 2, "explain": "The bus: after half an hour it has gone 30 km."}}, {"at_ms": 2000, "do": "move", "target": "wrongChip", "to": {"x": 420, "y": 240}, "dur_ms": 1200}, {"at_ms": 2000, "do": "move", "target": "wrongT", "to": {"x": 442, "y": 272}, "dur_ms": 1200}, {"at_ms": 2200, "do": "move", "target": "car", "to": {"x": 300, "y": 297}, "dur_ms": 2000}, {"at_ms": 4400, "do": "move", "target": "wrongChip", "to": {"x": 700, "y": 240}, "dur_ms": 1200}, {"at_ms": 4400, "do": "move", "target": "wrongT", "to": {"x": 722, "y": 272}, "dur_ms": 1200}, {"at_ms": 4600, "do": "show", "shape": {"id": "okChip", "kind": "rect", "x": 240, "y": 240, "w": 130, "h": 44, "fill": "#dbe7ff", "stroke": "#315fd6", "strokeWidth": 2, "explain": "The right answer: 30 km."}}, {"at_ms": 4650, "do": "show", "shape": {"id": "okT", "kind": "text", "text": "30 km", "size": 30, "x": 268, "y": 272, "explain": "The correction: half the time means half the distance."}}, {"at_ms": 6000, "do": "show", "shape": {"id": "eq", "kind": "text", "text": "60 × ½ = 30 km", "size": 34, "x": 520, "y": 180, "explain": "The working: 60 times one half is 30 km."}}, {"at_ms": 6800, "do": "emphasize", "target": "eq", "dur_ms": 1000}, {"at_ms": 7400, "do": "caption", "text": "Watch out: speed is not distance"}]}, {"id": "s4", "caption": "The takeaway", "duration_ms": 10000, "narration": "Distance, speed, and time are one family: distance equals speed times time, and you can flip the formula either way.", "steps": [{"at_ms": 400, "do": "show", "shape": {"id": "e1", "kind": "line", "x1": 720, "y1": 90, "x2": 610, "y2": 260, "stroke": "#1a1a1a", "width": 4, "explain": "The triangle's left edge: it separates d from s."}}, {"at_ms": 700, "do": "show", "shape": {"id": "e2", "kind": "line", "x1": 720, "y1": 90, "x2": 830, "y2": 260, "stroke": "#1a1a1a", "width": 4, "explain": "The triangle's right edge: it separates d from t."}}, {"at_ms": 1000, "do": "show", "shape": {"id": "e3", "kind": "line", "x1": 665, "y1": 175, "x2": 775, "y2": 175, "stroke": "#1a1a1a", "width": 4, "explain": "The middle line: it separates s from t."}}, {"at_ms": 1300, "do": "show", "shape": {"id": "e4", "kind": "line", "x1": 610, "y1": 260, "x2": 830, "y2": 260, "stroke": "#1a1a1a", "width": 4, "explain": "The triangle's base."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "dLab", "kind": "text", "text": "d", "size": 40, "x": 722, "y": 155, "explain": "d: distance, at the top of the triangle."}}, {"at_ms": 1900, "do": "show", "shape": {"id": "sLab", "kind": "text", "text": "s", "size": 40, "x": 648, "y": 240, "explain": "s: speed, at the bottom left."}}, {"at_ms": 2200, "do": "show", "shape": {"id": "tLab", "kind": "text", "text": "t", "size": 40, "x": 778, "y": 240, "explain": "t: time, at the bottom right."}}, {"at_ms": 2400, "do": "show", "shape": {"id": "cD", "kind": "text", "text": "d", "size": 40, "x": 900, "y": 420, "explain": "The formula's d: distance."}}, {"at_ms": 2500, "do": "move", "target": "cD", "to": {"x": 300, "y": 420}, "dur_ms": 800}, {"at_ms": 3000, "do": "show", "shape": {"id": "cEq", "kind": "text", "text": "=", "size": 40, "x": 900, "y": 420, "explain": "Equals."}}, {"at_ms": 3100, "do": "move", "target": "cEq", "to": {"x": 360, "y": 420}, "dur_ms": 800}, {"at_ms": 3600, "do": "show", "shape": {"id": "cS", "kind": "text", "text": "s", "size": 40, "x": 900, "y": 420, "explain": "s: speed."}}, {"at_ms": 3700, "do": "move", "target": "cS", "to": {"x": 420, "y": 420}, "dur_ms": 800}, {"at_ms": 4200, "do": "show", "shape": {"id": "cOp", "kind": "text", "text": "×", "size": 40, "x": 900, "y": 420, "explain": "Times."}}, {"at_ms": 4300, "do": "move", "target": "cOp", "to": {"x": 480, "y": 420}, "dur_ms": 800}, {"at_ms": 4800, "do": "show", "shape": {"id": "cT", "kind": "text", "text": "t", "size": 40, "x": 900, "y": 420, "explain": "t: time."}}, {"at_ms": 4900, "do": "move", "target": "cT", "to": {"x": 540, "y": 420}, "dur_ms": 800}, {"at_ms": 5900, "do": "move", "target": "cS", "to": {"x": 300, "y": 360}, "dur_ms": 800}, {"at_ms": 5900, "do": "move", "target": "cD", "to": {"x": 420, "y": 480}, "dur_ms": 800}, {"at_ms": 5950, "do": "hide", "target": "cOp"}, {"at_ms": 6000, "do": "show", "shape": {"id": "cOpD", "kind": "text", "text": "÷", "size": 40, "x": 480, "y": 420, "explain": "Or divide: cover s to see d divided by t."}}, {"at_ms": 6800, "do": "move", "target": "cS", "to": {"x": 300, "y": 420}, "dur_ms": 300}, {"at_ms": 6800, "do": "move", "target": "cD", "to": {"x": 420, "y": 420}, "dur_ms": 300}, {"at_ms": 7200, "do": "emphasize", "target": "cS", "dur_ms": 700}, {"at_ms": 8000, "do": "move", "target": "cT", "to": {"x": 300, "y": 360}, "dur_ms": 800}, {"at_ms": 8000, "do": "move", "target": "cS", "to": {"x": 540, "y": 480}, "dur_ms": 800}, {"at_ms": 8900, "do": "move", "target": "cT", "to": {"x": 300, "y": 420}, "dur_ms": 300}, {"at_ms": 8900, "do": "move", "target": "cS", "to": {"x": 540, "y": 420}, "dur_ms": 300}, {"at_ms": 9300, "do": "caption", "text": "One family: flip the formula either way"}]}]}