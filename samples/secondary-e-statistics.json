890,"y":255,"text":"8","size":22}},{"at_ms":4100,"do":"show","shape":{"id":"c20","kind":"text","x":60,"y":310,"text":"20 < x ≤ 30","size":22}},{"at_ms":4250,"do":"show","shape":{"id":"c21","kind":"text","x":250,"y":310,"text":"8","size":22}},{"at_ms":4400,"do":"show","shape":{"id":"c22","kind":"text","x":380,"y":310,"text":"25","size":22}},{"at_ms":4550,"do":"show","shape":{"id":"c23","kind":"text","x":510,"y":310,"text":"200","size":22}},{"at_ms":4700,"do":"show","shape":{"id":"bar2","kind":"rect","x":620,"y":300,"w":4,"h":20,"fill":"#2a7de1","explain":"Cumulative bar: it grows as each row's frequency is added."}},{"at_ms":4850,"do":"move","target":"bar2","to":{"x":620,"y":300,"w":173,"h":20},"dur_ms":500},{"at_ms":5050,"do":"show","shape":{"id":"c24","kind":"text","x":890,"y":310,"text":"16","size":22}},{"at_ms":5300,"do":"show","shape":{"id":"c30","kind":"text","x":60,"y":365,"text":"30 < x ≤ 40","size":22}},{"at_ms":5450,"do":"show","shape":{"id":"c31","kind":"text","x":250,"y":365,"text":"6","size":22}},{"at_ms":5600,"do":"show","shape":{"id":"c32","kind":"text","x":380,"y":365,"text":"35","size":22}},{"at_ms":5750,"do":"show","shape":{"id":"c33","kind":"text","x":510,"y":365,"text":"210","size":22}},{"at_ms":5900,"do":"show","shape":{"id":"bar3","kind":"rect","x":620,"y":355,"w":4,"h":20,"fill":"#2a7de1","explain":"Cumulative bar: it grows as each row's frequency is added."}},{"at_ms":6050,"do":"move","target":"bar3","to":{"x":620,"y":355,"w":238,"h":20},"dur_ms":500},{"at_ms":6250,"do":"show","shape":{"id":"c34","kind":"text","x":890,"y":365,"text":"22","size":22}},{"at_ms":6500,"do":"show","shape":{"id":"c40","kind":"text","x":60,"y":420,"text":"40 < x ≤ 50","size":22}},{"at_ms":6650,"do":"show","shape":{"id":"c41","kind":"text","x":250,"y":420,"text":"2","size":22}},{"at_ms":6800,"do":"show","shape":{"id":"c42","kind":"text","x":380,"y":420,"text":"45","size":22}},{"at_ms":6950,"do":"show","shape":{"id":"c43","kind":"text","x":510,"y":420,"text":"90","size":22}},{"at_ms":7100,"do":"show","shape":{"id":"bar4","kind":"rect","x":620,"y":410,"w":4,"h":20,"fill":"#2a7de1","explain":"Cumulative bar: it grows as each row's frequency is added."}},{"at_ms":7250,"do":"move","target":"bar4","to":{"x":620,"y":410,"w":260,"h":20},"dur_ms":500},{"at_ms":7450,"do":"show","shape":{"id":"c44","kind":"text","x":890,"y":420,"text":"24","size":22}},{"at_ms":8000,"do":"show","shape":{"id":"gest","kind":"latex","x":60,"y":482,"tex":"\\sum f = 24,\\quad \\sum fx = 600,\\quad \\bar{x} \\approx \\frac{600}{24} = 25","size":24,"explain":"Estimated mean: each value stands in for its class midpoint."}},{"at_ms":9000,"do":"caption","text":"a grouped mean is an estimate — values stand in for midpoints"}]},{"id":"s5","caption":"The ogive: cumulative frequency curve","duration_ms":8000,"narration":"Accumulate the frequencies: 2, then 8, 16, 22, 24. The probe walks each upper class boundary against its cumulative frequency, and the curve draws itself behind it. This is the ogive.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t5","kind":"text","x":60,"y":64,"text":"The ogive: cumulative frequency curve","size":32}},{"at_ms":500,"do":"caption","text":"the probe walks the points; the curve draws behind it"},{"at_ms":900,"do":"show","shape":{"id":"xa","kind":"arrow","x1":80,"y1":420,"x2":810,"y2":420,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Marks axis."}},{"at_ms":1100,"do":"show","shape":{"id":"ya","kind":"arrow","x1":100,"y1":450,"x2":100,"y2":90,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Cumulative frequency axis."}},{"at_ms":1250,"do":"show","shape":{"id":"xl","kind":"text","x":762,"y":448,"text":"marks","size":18}},{"at_ms":1320,"do":"show","shape":{"id":"yl","kind":"text","x":58,"y":100,"text":"cf","size":18}},{"at_ms":1500,"do":"show","shape":{"id":"probe","kind":"circle","cx":100,"cy":420,"r":8,"fill":"#d62728","explain":"Probe dot: it visits each cumulative point in turn."}},{"at_ms":2300,"do":"move","target":"probe","to":{"cx":236,"cy":395},"dur_ms":400},{"at_ms":2800,"do":"show","shape":{"id":"sg0","kind":"line","x1":100,"y1":420,"x2":236,"y2":395,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Ogive segment: straight lines join the cumulative points."}},{"at_ms":3100,"do":"move","target":"probe","to":{"cx":372,"cy":320},"dur_ms":400},{"at_ms":3600,"do":"show","shape":{"id":"sg1","kind":"line","x1":236,"y1":395,"x2":372,"y2":320,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Ogive segment: straight lines join the cumulative points."}},{"at_ms":3900,"do":"move","target":"probe","to":{"cx":508,"cy":220},"dur_ms":400},{"at_ms":4400,"do":"show","shape":{"id":"sg2","kind":"line","x1":372,"y1":320,"x2":508,"y2":220,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Ogive segment: straight lines join the cumulative points."}},{"at_ms":4700,"do":"move","target":"probe","to":{"cx":644,"cy":145},"dur_ms":400},{"at_ms":5200,"do":"show","shape":{"id":"sg3","kind":"line","x1":508,"y1":220,"x2":644,"y2":145,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Ogive segment: straight lines join the cumulative points."}},{"at_ms":5500,"do":"move","target":"probe","to":{"cx":780,"cy":120},"dur_ms":400},{"at_ms":6000,"do":"show","shape":{"id":"sg4","kind":"line","x1":644,"y1":145,"x2":780,"y2":120,"stroke":"#1a1a1a","strokeWidth":3,"explain":"Ogive segment: straight lines join the cumulative points."}},{"at_ms":6800,"do":"caption","text":"the ogive only ever rises — frequencies just add up"},{"at_ms":7300,"do":"emphasize","target":"probe","dur_ms":700}]},{"id":"s6","caption":"Read-off: median ≈ 25, IQR ≈ 16.7","duration_ms":11500,"narration":"Half of 24 is 12: the dashed line grows across from 12 to the curve, then drops down — the median is about 25. The same read-off from 6 and 18 gives quartiles 16.7 and 33.3, so the IQR is about 16.7.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t6","kind":"text","x":60,"y":64,"text":"Reading the median and quartiles","size":32}},{"at_ms":500,"do":"caption","text":"dashed read-off lines