"id":"medL","kind":"text","x":425,"y":340,"text":"median 9","size":22,"color":"#2ca02c"}},{"at_ms":5600,"do":"show","shape":{"id":"modeB","kind":"rect","x":354,"y":412,"w":4,"h":18,"fill":"#ff7f0e","explain":"Mode bar: the most common score, 8, appears twice."}},{"at_ms":5800,"do":"move","target":"modeB","to":{"x":354,"y":412,"w":40,"h":18},"dur_ms":600},{"at_ms":6600,"do":"show","shape":{"id":"modeL","kind":"text","x":398,"y":428,"text":"mode 8","size":22,"color":"#ff7f0e"}},{"at_ms":7200,"do":"caption","text":"three centres: mean 10, median 9, mode 8"}]},{"id":"s3","caption":"The mean follows the outlier; the median resists","duration_ms":10000,"narration":"Drag the top score from 18 up to 27. The total becomes 99, so the mean marker chases it up to 11. But the median ring never moves — the middle of the list is still 9.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t3","kind":"text","x":120,"y":80,"text":"One outlier changes the mean","size":34}},{"at_ms":500,"do":"caption","text":"the 18 slides to 27 — watch the mean chase it"},{"at_ms":800,"do":"show","shape":{"id":"ax3","kind":"arrow","x1":90,"y1":390,"x2":770,"y2":390,"stroke":"#1a1a1a","strokeWidth":3}},{"at_ms":1000,"do":"show","shape":{"id":"z0","kind":"text","x":92,"y":418,"text":"0","size":18}},{"at_ms":1100,"do":"show","shape":{"id":"z30","kind":"text","x":722,"y":418,"text":"30","size":18}},{"at_ms":1300,"do":"show","shape":{"id":"p1","kind":"circle","cx":203,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":1580,"do":"show","shape":{"id":"p2","kind":"circle","cx":249,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":1860,"do":"show","shape":{"id":"p3","kind":"circle","cx":271,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":2140,"do":"show","shape":{"id":"p4","kind":"circle","cx":271,"cy":334,"r":10,"fill":"#2a7de1"}},{"at_ms":2420,"do":"show","shape":{"id":"p5","kind":"circle","cx":294,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":2700,"do":"show","shape":{"id":"p6","kind":"circle","cx":317,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":2980,"do":"show","shape":{"id":"p7","kind":"circle","cx":339,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":3260,"do":"show","shape":{"id":"p8","kind":"circle","cx":407,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":3540,"do":"show","shape":{"id":"p9","kind":"circle","cx":498,"cy":360,"r":10,"fill":"#2a7de1"}},{"at_ms":4200,"do":"show","shape":{"id":"bMean","kind":"arrow","x1":317,"y1":250,"x2":317,"y2":295,"stroke":"#d62728","strokeWidth":4,"explain":"Mean marker, starting at 10 before the outlier moves."}},{"at_ms":4400,"do":"show","shape":{"id":"bMeanL","kind":"text","x":329,"y":272,"text":"mean 10","size":22,"color":"#d62728"}},{"at_ms":4700,"do":"show","shape":{"id":"bMed","kind":"circle","cx":294,"cy":360,"r":14,"stroke":"#2ca02c","strokeWidth":3,"explain":"Median marker: it will not move when the outlier shifts."}},{"at_ms":4900,"do":"show","shape":{"id":"bMedL","kind":"text","x":310,"y":332,"text":"median 9","size":22,"color":"#2ca02c"}},{"at_ms":5400,"do":"move","target":"p9","to":{"cx":702,"cy":360},"dur_ms":1200},{"at_ms":7000,"do":"move","target":"bMean","to":{"x1":339,"y1":250,"x2":339,"y2":295},"dur_ms":800},{"at_ms":7000,"do":"hide","target":"bMeanL"},{"at_ms":7300,"do":"show","shape":{"id":"aMeanL","kind":"text","x":351,"y":272,"text":"mean 11","size":22,"color":"#d62728"}},{"at_ms":8000,"do":"emphasize","target":"bMed","dur_ms":800},{"at_ms":8700,"do":"caption","text":"the median resists outliers; the mean follows them"}]},{"id":"s4","caption":"Grouped data: the cumulative frequency table","duration_ms":10000,"narration":"For grouped data, every value stands in for its group's midpoint. Watch each cumulative bar grow as frequencies pile up: 2, 8, 16, 22, 24. The estimated mean is 600 over 24, which is 25.","steps":[{"at_ms":0,"do":"show","shape":{"id":"t4","kind":"text","x":60,"y":70,"text":"Grouped data: cumulative frequency","size":32}},{"at_ms":500,"do":"caption","text":"bars grow as frequencies accumulate"},{"at_ms":900,"do":"show","