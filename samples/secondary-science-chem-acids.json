    {
      "id": "s4",
      "caption": "Neutralisation: a worked example",
      "duration_ms": 9000,
      "narration": "Mix an acid with an alkali and they cancel out: H+ pairs with OH− to make water, and the leftover ions form a salt. Acid plus alkali gives salt plus water — always.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
            "kind": "text",
            "x": 80,
            "y": 70,
            "size": 30,
            "text": "Neutralisation: acid + alkali → salt + water"
          }
        },
        {
          "at_ms": 400,
          "do": "show",
          "shape": {
            "id": "eq",
            "kind": "latex",
            "x": 120,
            "y": 220,
            "size": 40,
            "color": "#1f7a3a",
            "tex": "\\mathrm{HCl + NaOH \\rightarrow NaCl + H_2O}"
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "id": "l1",
            "kind": "text",
            "x": 120,
            "y": 300,
            "size": 24,
            "text": "hydrochloric acid + sodium hydroxide →"
          }
