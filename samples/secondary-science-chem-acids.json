        },
        {
          "at_ms": 2600,
          "do": "emphasize",
          "target": "eq"
        },
        {
          "at_ms": 3400,
          "do": "show",
          "shape": {
            "id": "water",
            "kind": "text",
            "x": 120,
            "y": 420,
            "size": 24,
            "text": "The H⁺ and OH⁻ ions pair up to make water."
          }
        },
        {
          "at_ms": 4000,
          "do": "show",
          "shape": {
            "id": "salt",
            "kind": "text",
            "x": 120,
            "y": 460,
            "size": 24,
            "text": "The Na⁺ and Cl⁻ ions left over make the salt."
          }
        },
        {
          "at_ms": 5000,
          "do": "caption",
