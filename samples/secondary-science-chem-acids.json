          "do": "show",
          "shape": {
            "id": "sol2",
            "kind": "text",
            "x": 80,
            "y": 420,
            "size": 24,
            "text": "not just which acid you started with."
          }
        },
        {
          "at_ms": 4600,
          "do": "caption",
