    {
      "id": "s6",
      "caption": "Naming the salt",
      "duration_ms": 7000,
      "narration": "The salt takes its name from the acid. Hydrochloric acid gives a chloride; nitric acid gives a nitrate; sulfuric acid gives a sulfate.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
            "kind": "text",
            "x": 80,
            "y": 70,
            "size": 34,
            "text": "Naming the salt"
          }
        },
        {
          "at_ms": 400,
          "do": "show",
          "shape": {
            "id": "e1a",
            "kind": "text",
            "x": 120,
            "y": 180,
            "size": 24,
            "text": "hydrochloric acid + sodium hydroxide"
          }
        },
        {
          "at_ms": 900,
          "do": "show",
          "shape": {
            "id": "e1b",
            "kind": "text",
            "x": 120,
            "y": 215,
            "size": 24,
            "text": "→ sodium CHLORIDE + water"
          }
        },
        {
          "at_ms": 1700,
          "do": "show",
          "shape": {
            "id": "e2a",
            "kind": "text",
            "x": 120,
            "y": 300,
            "size": 24,
            "text": "nitric acid + potassium hydroxide"
