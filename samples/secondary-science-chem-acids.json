    {
      "id": "s3",
      "caption": "What pH is really about: ions",
      "duration_ms": 9000,
      "narration": "Acids release hydrogen ions, H+, when they dissolve in water. Alkalis release hydroxide ions, OH−. Whichever ion is in excess decides the pH.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
            "kind": "text",
            "x": 80,
            "y": 70,
            "size": 34,
            "text": "It is about ions: H⁺ and OH⁻"
          }
        },
        {
          "at_ms": 400,
          "do": "show",
          "shape": {
            "id": "hp",
            "kind": "circle",
            "cx": 180,
