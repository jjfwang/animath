{"animath":"0.1","canvas":{"height":540,"width":960},"kind":"concept","level":"secondary","scenes":[{"caption":"Acids and alkalis around you","duration_ms":6000,"id":"s1","narration":"Lemon juice and vinegar are acids; soap and baking soda are alkalis. Chemists sort them on one number line: the pH scale.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"Acids and alkalis around you","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"fill":"#ffffff","h":220,"id":"beakerA","kind":"rect","stroke":"#1a1a1a","w":120,"x":140,"y":170,"explain":"Beaker of acid: it holds the acid being tested."}},{"at_ms":400,"do":"show","shape":{"fill":"#ffffff","h":220,"id":"beakerB","kind":"rect","stroke":"#1a1a1a","w":120,"x":420,"y":170,"explain":"Beaker of alkali: it holds the alkali being tested."}},{"at_ms":800,"do":"show","shape":{"fill":"#c0392b","h":12,"id":"fillA","kind":"rect","stroke":"#c0392b","w":104,"x":148,"y":370,"explain":"The acid liquid: lemon juice and vinegar are acids."}},{"at_ms":900,"do":"move","dur_ms":1400,"target":"fillA","to":{"h":182,"y":200}},{"at_ms":1000,"do":"show","shape":{"fill":"#2471a3","h":12,"id":"fillB","kind":"rect","stroke":"#2471a3","w":104,"x":428,"y":370,"explain":"The alkali liquid: soap and baking soda are alkalis."}},{"at_ms":1100,"do":"move","dur_ms":1400,"target":"fillB","to":{"h":182,"y":200}},{"at_ms":2600,"do":"show","shape":{"color":"#c0392b","id":"labA","kind":"text","size":26,"text":"acid","x":148,"y":430,"explain":"acid: pH below 7, more H+ than OH- ions."}},{"at_ms":2700,"do":"show","shape":{"color":"#2471a3","id":"labB","kind":"text","size":26,"text":"alkali","x":412,"y":430,"explain":"alkali: pH above 7, more OH- than H+ ions."}},{"at_ms":3000,"do":"show","shape":{"id":"ex","kind":"text","size":22,"text":"lemon juice \u00b7 vinegar \u00b7 stomach acid  |  soap \u00b7 baking soda \u00b7 toothpaste","x":80,"y":500,"explain":"Everyday examples: acids on the left, alkalis on the right."}},{"at_ms":3800,"do":"caption","text":"Acids and alkalis are part of everyday life."}]},{"caption":"The pH scale ladder","duration_ms":8000,"id":"s2","narration":"The pH scale runs from 0 to 14, with 7 neutral. Each step away from 7 is ten times stronger.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"The pH scale","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"fill":"#c0392b","h":8,"id":"r1","kind":"rect","stroke":"#1a1a1a","w":40,"x":140,"y":120,"explain":"The acidic end of the scale: pH 0 to 6."}},{"at_ms":500,"do":"move","dur_ms":900,"target":"r1","to":{"h":120}},{"at_ms":1400,"do":"show","shape":{"id":"t0","kind":"text","size":22,"text":"pH 0 \u2014 strongly acidic","x":230,"y":450,"explain":"pH 0 - strongly acidic: the most acidic end of the scale."}},{"at_ms":1600,"do":"show","shape":{"fill":"#e67e22","h":8,"id":"r2","kind":"rect","stroke":"#1a1a1a","w":40,"x":140,"y":240,"explain":"The acidic band: pH 1 to 6."}},{"at_ms":1700,"do":"move","dur_ms":800,"target":"r2","to":{"h":80}},{"at_ms":2000,"do":"show","shape":{"id":"t1","kind":"text","size":22,"text":"pH 1\u20136 \u2014 acidic","x":230,"y":400,"explain":"pH 1 to 6 - acidic: below the neutral point of 7."}},{"at_ms":2300,"do":"show","shape":{"fill":"#27ae60","h":8,"id":"r3","kind":"rect","stroke":"#1a1a1a","w":40,"x":140,"y":320,"explain":"Neutral: pH 7 exactly, like pure water."}},{"at_ms":2400,"do":"move","dur_ms":700,"target":"r3","to":{"h":40}},{"at_ms":2700,"do":"show","shape":{"id":"t7","kind":"text","size":22,"text":"pH 7 \u2014 neutral","x":230,"y":340,"explain":"pH 7 - neutral: neither acidic nor alkaline."}},{"at_ms":3000,"do":"show","shape":{"fill":"#7d3c98","h":8,"id":"r4","kind":"rect","stroke":"#1a1a1a","w":40,"x":140,"y":360,"explain":"The alkaline band: pH 8 to 13."}},{"at_ms":3100,"do":"move","dur_ms":900,"target":"r4","to":{"h":120}},{"at_ms":3400,"do":"show","shape":{"id":"t8","kind":"text","size":22,"text":"pH 8\u201313 \u2014 alkaline","x":230,"y":180,"explain":"pH 8 to 13 - alkaline: above the neutral point of 7."}},{"at_ms":3800,"do":"show","shape":{"id":"t14","kind":"text","size":22,"text":"pH 14 \u2014 strongly alkaline","x":230,"y":130,"explain":"pH 14 - strongly alkaline: the most alkaline end of the scale."}},{"at_ms":4200,"do":"show","shape":{"id":"ladder","kind":"arrow","stroke":"#1a1a1a","width":3,"x1":210,"x2":210,"y1":470,"y2":110,"explain":"The pH ladder: it runs from 0 (acidic) through 7 (neutral) to 14 (alkaline)."}},{"at_ms":4600,"do":"emphasize","target":"t7"},{"at_ms":5200,"do":"caption","text":"pH 7 is neutral; lower is acidic, higher is alkaline."},{"at_ms":5800,"do":"show","shape":{"id":"jump","kind":"text","size":22,"text":"Each step is ten times stronger \u2014 a big jump.","x":80,"y":505,"explain":"Each pH step is ten times stronger: pH 3 is ten times more acidic than pH 4."}}]},{"caption":"What pH is really about: ions","duration_ms":9000,"id":"s3","narration":"Acids release H+ ions and alkalis release OH\u2212 ions in water. Whichever ion is in excess decides the pH.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"It is about ions: H\u207a and OH\u207b","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"color":"#c0392b","id":"acidZone","kind":"text","size":24,"text":"acid","x":100,"y":130,"explain":"The acid side: crowded with H+ ions."}},{"at_ms":400,"do":"show","shape":{"fill":"#ffffff","h":170,"id":"acidBottle","kind":"rect","stroke":"#c0392b","w":90,"x":100,"y":150,"explain":"Acid bottle: it releases H+ ions into the water."}},{"at_ms":400,"do":"show","shape":{"color":"#2471a3","id":"alkZone","kind":"text","size":24,"text":"alkali","x":770,"y":130,"explain":"The alkali side: crowded with OH- ions."}},{"at_ms":400,"do":"show","shape":{"fill":"#ffffff","h":170,"id":"alkBottle","kind":"rect","stroke":"#2471a3","w":90,"x":770,"y":150,"explain":"Alkali bottle: it releases OH- ions into the water."}},{"at_ms":1000,"do":"show","shape":{"cx":145,"cy":195,"fill":"#2980b9","id":"hp1","kind":"circle","r":20,"stroke":"#2980b9","explain":"An H+ ion: a hydrogen ion released by the acid."}},{"at_ms":1000,"do":"show","shape":{"color":"#ffffff","id":"hp1L","kind":"text","size":18,"text":"H\u207a","x":134,"y":202,"explain":"H+: a hydrogen ion. Acids release these into water."}},{"at_ms":1000,"do":"show","shape":{"cx":145,"cy":250,"fill":"#2980b9","id":"hp2","kind":"circle","r":20,"stroke":"#2980b9","explain":"An H+ ion: a hydrogen ion released by the acid."}},{"at_ms":1000,"do":"show","shape":{"color":"#ffffff","id":"hp2L","kind":"text","size":18,"text":"H\u207a","x":134,"y":257,"explain":"H+: a hydrogen ion. Acids release these into water."}},{"at_ms":1000,"do":"show","shape":{"cx":145,"cy":305,"fill":"#2980b9","id":"hp3","kind":"circle","r":20,"stroke":"#2980b9","explain":"An H+ ion: a hydrogen ion released by the acid."}},{"at_ms":1000,"do":"show","shape":{"color":"#ffffff","id":"hp3L","kind":"text","size":18,"text":"H\u207a","x":134,"y":312,"explain":"H+: a hydrogen ion. Acids release these into water."}},{"at_ms":1400,"do":"move","dur_ms":1000,"target":"hp1","to":{"cx":300,"cy":180}},{"at_ms":1400,"do":"move","dur_ms":1000,"target":"hp1L","to":{"x":289,"y":187}},{"at_ms":1600,"do":"move","dur_ms":1000,"target":"hp2","to":{"cx":330,"cy":270}},{"at_ms":1600,"do":"move","dur_ms":1000,"target":"hp2L","to":{"x":319,"y":277}},{"at_ms":1800,"do":"move","dur_ms":1000,"target":"hp3","to":{"cx":290,"cy":360}},{"at_ms":1800,"do":"move","dur_ms":1000,"target":"hp3L","to":{"x":279,"y":367}},{"at_ms":3000,"do":"show","shape":{"cx":815,"cy":195,"fill":"#c0392b","id":"oh1","kind":"circle","r":22,"stroke":"#c0392b","explain":"An OH- ion: a hydroxide ion released by the alkali."}},{"at_ms":3000,"do":"show","shape":{"color":"#ffffff","id":"oh1L","kind":"text","size":16,"text":"OH\u207b","x":800,"y":202,"explain":"OH-: a hydroxide ion. Alkalis release these into water."}},{"at_ms":3000,"do":"show","shape":{"cx":815,"cy":250,"fill":"#c0392b","id":"oh2","kind":"circle","r":22,"stroke":"#c0392b","explain":"An OH- ion: a hydroxide ion released by the alkali."}},{"at_ms":3000,"do":"show","shape":{"color":"#ffffff","id":"oh2L","kind":"text","size":16,"text":"OH\u207b","x":800,"y":257,"explain":"OH-: a hydroxide ion. Alkalis release these into water."}},{"at_ms":3000,"do":"show","shape":{"cx":815,"cy":305,"fill":"#c0392b","id":"oh3","kind":"circle","r":22,"stroke":"#c0392b","explain":"An OH- ion: a hydroxide ion released by the alkali."}},{"at_ms":3000,"do":"show","shape":{"color":"#ffffff","id":"oh3L","kind":"text","size":16,"text":"OH\u207b","x":800,"y":312,"explain":"OH-: a hydroxide ion. Alkalis release these into water."}},{"at_ms":3400,"do":"move","dur_ms":1000,"target":"oh1","to":{"cx":660,"cy":180}},{"at_ms":3400,"do":"move","dur_ms":1000,"target":"oh1L","to":{"x":645,"y":187}},{"at_ms":3600,"do":"move","dur_ms":1000,"target":"oh2","to":{"cx":630,"cy":270}},{"at_ms":3600,"do":"move","dur_ms":1000,"target":"oh2L","to":{"x":615,"y":277}},{"at_ms":3800,"do":"move","dur_ms":1000,"target":"oh3","to":{"cx":670,"cy":360}},{"at_ms":3800,"do":"move","dur_ms":1000,"target":"oh3L","to":{"x":655,"y":367}},{"at_ms":5000,"do":"show","shape":{"id":"acidRule","kind":"text","size":24,"text":"More H\u207a than OH\u207b \u2192 acidic","x":80,"y":470,"explain":"More H+ than OH- means acidic: whichever ion is in excess decides the pH."}},{"at_ms":5600,"do":"show","shape":{"id":"alkRule","kind":"text","size":24,"text":"More OH\u207b than H\u207a \u2192 alkaline","x":480,"y":470,"explain":"More OH- than H+ means alkaline."}},{"at_ms":6400,"do":"show","shape":{"id":"neuRule","kind":"text","size":24,"text":"Equal numbers \u2192 neutral.","x":280,"y":515,"explain":"Equal numbers of H+ and OH- means neutral, pH 7."}},{"at_ms":7000,"do":"caption","text":"The winning ion decides the pH."}]},{"caption":"Neutralisation: a worked example","duration_ms":9000,"id":"s4","narration":"Mix an acid with an alkali and the H+ and OH\u2212 ions pair up to make water. The leftover ions form a salt: acid plus alkali always gives salt plus water.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":30,"text":"Neutralisation: acid + alkali \u2192 salt + water","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"color":"#1f7a3a","id":"eq","kind":"latex","size":40,"tex":"\\mathrm{HCl + NaOH \\rightarrow NaCl + H_2O}","x":120,"y":220,"explain":"The neutralisation equation: hydrochloric acid plus sodium hydroxide makes sodium chloride (salt) plus water."}},{"at_ms":1800,"do":"show","shape":{"cx":200,"cy":420,"fill":"#2980b9","id":"h","kind":"circle","r":26,"stroke":"#2980b9","explain":"An H+ ion from the acid: about to pair up with OH-."}},{"at_ms":1800,"do":"show","shape":{"color":"#ffffff","id":"hL","kind":"text","size":22,"text":"H\u207a","x":189,"y":429,"explain":"H+: the hydrogen ion from the hydrochloric acid."}},{"at_ms":1800,"do":"show","shape":{"cx":400,"cy":420,"fill":"#c0392b","id":"oh","kind":"circle","r":30,"stroke":"#c0392b","explain":"An OH- ion from the alkali: about to pair up with H+."}},{"at_ms":1800,"do":"show","shape":{"color":"#ffffff","id":"ohL","kind":"text","size":20,"text":"OH\u207b","x":384,"y":428,"explain":"OH-: the hydroxide ion from the sodium hydroxide."}},{"at_ms":2400,"do":"move","dur_ms":1200,"target":"h","to":{"cx":300,"cy":420}},{"at_ms":2400,"do":"move","dur_ms":1200,"target":"hL","to":{"x":289,"y":429}},{"at_ms":2400,"do":"move","dur_ms":1200,"target":"oh","to":{"cx":300,"cy":420}},{"at_ms":2400,"do":"move","dur_ms":1200,"target":"ohL","to":{"x":284,"y":428}},{"at_ms":3700,"do":"hide","target":"h"},{"at_ms":3700,"do":"hide","target":"hL"},{"at_ms":3700,"do":"hide","target":"oh"},{"at_ms":3700,"do":"hide","target":"ohL"},{"at_ms":3700,"do":"show","shape":{"cx":300,"cy":420,"fill":"#5dade2","id":"water","kind":"circle","r":42,"stroke":"#2e86c1","explain":"Water: one H+ and one OH- pair up to make H2O."}},{"at_ms":3700,"do":"show","shape":{"color":"#ffffff","id":"waterL","kind":"text","size":22,"text":"H\u2082O","x":278,"y":429,"explain":"H2O: water, made when H+ and OH- join."}},{"at_ms":4400,"do":"show","shape":{"cx":620,"cy":420,"fill":"#8e44ad","id":"na","kind":"circle","r":24,"stroke":"#8e44ad","explain":"A Na+ ion: the leftover sodium from the alkali."}},{"at_ms":4400,"do":"show","shape":{"color":"#ffffff","id":"naL","kind":"text","size":18,"text":"Na\u207a","x":607,"y":428,"explain":"Na+: a sodium ion, left over after neutralisation."}},{"at_ms":4400,"do":"show","shape":{"cx":760,"cy":420,"fill":"#27ae60","id":"cl","kind":"circle","r":24,"stroke":"#27ae60","explain":"A Cl- ion: the leftover chloride from the acid."}},{"at_ms":4400,"do":"show","shape":{"color":"#ffffff","id":"clL","kind":"text","size":18,"text":"Cl\u207b","x":748,"y":428,"explain":"Cl-: a chloride ion, left over after neutralisation."}},{"at_ms":5000,"do":"move","dur_ms":1000,"target":"na","to":{"cx":690,"cy":420}},{"at_ms":5000,"do":"move","dur_ms":1000,"target":"naL","to":{"x":677,"y":428}},{"at_ms":5000,"do":"move","dur_ms":1000,"target":"cl","to":{"cx":690,"cy":420}},{"at_ms":5000,"do":"move","dur_ms":1000,"target":"clL","to":{"x":678,"y":428}},{"at_ms":6100,"do":"hide","target":"na"},{"at_ms":6100,"do":"hide","target":"naL"},{"at_ms":6100,"do":"hide","target":"cl"},{"at_ms":6100,"do":"hide","target":"clL"},{"at_ms":6100,"do":"show","shape":{"fill":"#ecf0f1","h":64,"id":"salt","kind":"rect","stroke":"#1a1a1a","w":64,"x":658,"y":388,"explain":"Salt: the leftover Na+ and Cl- ions form sodium chloride."}},{"at_ms":6100,"do":"show","shape":{"id":"saltL","kind":"text","size":22,"text":"NaCl","x":668,"y":428,"explain":"NaCl: sodium chloride, the salt made in this neutralisation."}},{"at_ms":6800,"do":"caption","text":"Neutralisation always makes salt and water."}]},{"caption":"The litmus test","duration_ms":8000,"id":"s5","narration":"Litmus paper is a quick dye test: blue litmus turns red in acid, red litmus turns blue in alkali. No change means neutral.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"The litmus test","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"color":"#c0392b","id":"labA","kind":"text","size":24,"text":"acid","x":150,"y":150,"explain":"acid: pH below 7, more H+ than OH- ions."}},{"at_ms":400,"do":"show","shape":{"fill":"#ffffff","h":240,"id":"beakerA","kind":"rect","stroke":"#1a1a1a","w":200,"x":150,"y":170,"explain":"Beaker of acid: it holds the acid being tested."}},{"at_ms":600,"do":"show","shape":{"fill":"#f1948a","h":102,"id":"acidLiq","kind":"rect","stroke":"#f1948a","w":184,"x":158,"y":300,"explain":"The acid liquid: blue litmus turns red in it."}},{"at_ms":1000,"do":"show","shape":{"fill":"#2471a3","h":120,"id":"stripB","kind":"rect","stroke":"#1a1a1a","w":40,"x":245,"y":90,"explain":"Blue litmus paper: the test strip dipping into the acid."}},{"at_ms":1000,"do":"show","shape":{"id":"stripBL","kind":"text","size":20,"text":"blue litmus","x":130,"y":110,"explain":"blue litmus: the dye paper used for the quick acid test."}},{"at_ms":1600,"do":"move","dur_ms":1200,"target":"stripB","to":{"y":220}},{"at_ms":1600,"do":"move","dur_ms":1200,"target":"stripBL","to":{"y":210}},{"at_ms":2900,"do":"hide","target":"stripB"},{"at_ms":2900,"do":"show","shape":{"fill":"#c0392b","h":120,"id":"stripB2","kind":"rect","stroke":"#1a1a1a","w":40,"x":245,"y":220,"explain":"Blue litmus after the acid dip: it has turned red."}},{"at_ms":3300,"do":"show","shape":{"color":"#c0392b","id":"resA","kind":"text","size":24,"text":"blue litmus turns RED","x":150,"y":450,"explain":"Result: blue litmus turns RED in acid. That is the acid test."}},{"at_ms":3800,"do":"show","shape":{"color":"#2471a3","id":"labB","kind":"text","size":24,"text":"alkali","x":600,"y":150,"explain":"alkali: pH above 7, more OH- than H+ ions."}},{"at_ms":3800,"do":"show","shape":{"fill":"#ffffff","h":240,"id":"beakerB","kind":"rect","stroke":"#1a1a1a","w":200,"x":600,"y":170,"explain":"Beaker of alkali: it holds the alkali being tested."}},{"at_ms":4000,"do":"show","shape":{"fill":"#aed6f1","h":102,"id":"alkLiq","kind":"rect","stroke":"#aed6f1","w":184,"x":608,"y":300,"explain":"The alkali liquid: red litmus turns blue in it."}},{"at_ms":4400,"do":"show","shape":{"fill":"#c0392b","h":120,"id":"stripR","kind":"rect","stroke":"#1a1a1a","w":40,"x":695,"y":90,"explain":"Red litmus paper: the test strip dipping into the alkali."}},{"at_ms":4400,"do":"show","shape":{"id":"stripRl","kind":"text","size":20,"text":"red litmus","x":575,"y":110,"explain":"red litmus: the dye paper used for the quick alkali test."}},{"at_ms":4800,"do":"move","dur_ms":1200,"target":"stripR","to":{"y":220}},{"at_ms":4800,"do":"move","dur_ms":1200,"target":"stripRl","to":{"y":210}},{"at_ms":6100,"do":"hide","target":"stripR"},{"at_ms":6100,"do":"show","shape":{"fill":"#2471a3","h":120,"id":"stripR2","kind":"rect","stroke":"#1a1a1a","w":40,"x":695,"y":220,"explain":"Red litmus after the alkali dip: it has turned blue."}},{"at_ms":6500,"do":"show","shape":{"color":"#2471a3","id":"resB","kind":"text","size":24,"text":"red litmus turns BLUE","x":600,"y":450,"explain":"Result: red litmus turns BLUE in alkali. That is the alkali test."}},{"at_ms":7000,"do":"caption","text":"Blue goes red in acid; red goes blue in alkali."}]},{"caption":"Naming the salt","duration_ms":7000,"id":"s6","narration":"The salt takes its name from the acid. Hydrochloric gives a chloride, nitric a nitrate, sulfuric a sulfate.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"Naming the salt","x":80,"y":70}},{"at_ms":300,"do":"show","shape":{"id":"chip1","kind":"text","size":24,"text":"hydrochloric acid","x":120,"y":190,"explain":"hydrochloric acid: the acid in this pair. The salt's second word comes from the acid."}},{"at_ms":500,"do":"show","shape":{"id":"a1","kind":"arrow","stroke":"#1a1a1a","width":3,"x1":420,"x2":490,"y1":180,"y2":180,"explain":"Naming arrow: the salt takes its name from the acid it came from."}},{"at_ms":700,"do":"move","dur_ms":900,"target":"chip1","to":{"x":520}},{"at_ms":1700,"do":"hide","target":"chip1"},{"at_ms":1700,"do":"show","shape":{"id":"salt1","kind":"text","size":24,"text":"sodium CHLORIDE","x":520,"y":190,"explain":"sodium CHLORIDE: hydrochloric acid gives a chloride. The sodium comes from the alkali."}},{"at_ms":2000,"do":"emphasize","target":"salt1"},{"at_ms":2600,"do":"show","shape":{"id":"chip2","kind":"text","size":24,"text":"nitric acid","x":120,"y":310,"explain":"nitric acid: it gives a nitrate salt."}},{"at_ms":2700,"do":"show","shape":{"id":"a2","kind":"arrow","stroke":"#1a1a1a","width":3,"x1":420,"x2":490,"y1":300,"y2":300,"explain":"Naming arrow: the salt takes its name from the acid it came from."}},{"at_ms":2900,"do":"move","dur_ms":900,"target":"chip2","to":{"x":520}},{"at_ms":3900,"do":"hide","target":"chip2"},{"at_ms":3900,"do":"show","shape":{"id":"salt2","kind":"text","size":24,"text":"potassium NITRATE","x":520,"y":310,"explain":"potassium NITRATE: nitric acid gives a nitrate."}},{"at_ms":4100,"do":"emphasize","target":"salt2"},{"at_ms":4500,"do":"show","shape":{"id":"chip3","kind":"text","size":24,"text":"sulfuric acid","x":120,"y":430,"explain":"sulfuric acid: it gives a sulfate salt."}},{"at_ms":4600,"do":"show","shape":{"id":"a3","kind":"arrow","stroke":"#1a1a1a","width":3,"x1":420,"x2":490,"y1":420,"y2":420,"explain":"Naming arrow: the salt takes its name from the acid it came from."}},{"at_ms":4800,"do":"move","dur_ms":900,"target":"chip3","to":{"x":520}},{"at_ms":5800,"do":"hide","target":"chip3"},{"at_ms":5800,"do":"show","shape":{"id":"salt3","kind":"text","size":24,"text":"magnesium SULFATE","x":520,"y":430,"explain":"magnesium SULFATE: sulfuric acid gives a sulfate."}},{"at_ms":6000,"do":"emphasize","target":"salt3"},{"at_ms":6400,"do":"caption","text":"The acid names the salt: \u2212ic becomes \u2212ate."}]},{"caption":"A common mistake: all acids are strong","duration_ms":6000,"id":"s7","narration":"A common mistake: all acids are strong acids. Acid sounds dangerous, so every acid is treated like it fully burns through everything. Weak acids only partly release their hydrogen ions: vinegar is still acidic, just not strong.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","size":34,"text":"Check the thinking","x":80,"y":70}},{"at_ms":400,"do":"show","shape":{"id":"myth","kind":"text","size":28,"text":"\u274c \u201cAll acids are strong.\u201d","x":80,"y":170,"explain":"Myth: all acids are strong. Vinegar is acidic but weak - only some of its H+ breaks free."}},{"at_ms":800,"do":"show","shape":{"id":"strongLab","kind":"text","size":24,"text":"strong acid","x":80,"y":250,"explain":"strong acid: almost every molecule releases its H+."}},{"at_ms":800,"do":"show","shape":{"fill":"#ffffff","h":190,"id":"beakerS","kind":"rect","stroke":"#1a1a1a","w":160,"x":80,"y":270,"explain":"The strong-acid beaker: nearly all its H+ ions break free."}},{"at_ms":800,"do":"show","shape":{"id":"weakLab","kind":"text","size":24,"text":"vinegar (weak acid)","x":560,"y":250,"explain":"vinegar (weak acid): still acidic, but only a few molecules release H+."}},{"at_ms":800,"do":"show","shape":{"fill":"#ffffff","h":190,"id":"beakerW","kind":"rect","stroke":"#1a1a1a","w":160,"x":560,"y":270,"explain":"The weak-acid beaker: vinegar."}},{"at_ms":1200,"do":"show","shape":{"cx":115,"cy":310,"fill":"#2980b9","id":"sp1","kind":"circle","r":16,"stroke":"#2980b9","explain":"A freed H+ ion: in the strong acid, almost every one breaks free."}},{"at_ms":1200,"do":"show","shape":{"cx":160,"cy":310,"fill":"#2980b9","id":"sp2","kind":"circle","r":16,"stroke":"#2980b9","explain":"A freed H+ ion: in the strong acid, almost every one breaks free."}},{"at_ms":1200,"do":"show","shape":{"cx":205,"cy":310,"fill":"#2980b9","id":"sp3","kind":"circle","r":16,"stroke":"#2980b9","explain":"A freed H+ ion: in the strong acid, almost every one breaks free."}},{"at_ms":1200,"do":"show","shape":{"cx":137,"cy":360,"fill":"#2980b9","id":"sp4","kind":"circle","r":16,"stroke":"#2980b9","explain":"A freed H+ ion: in the strong acid, almost every one breaks free."}},{"at_ms":1500,"do":"move","dur_ms":800,"target":"sp1","to":{"cx":280,"cy":300}},{"at_ms":1600,"do":"move","dur_ms":800,"target":"sp2","to":{"cx":300,"cy":360}},{"at_ms":1700,"do":"move","dur_ms":800,"target":"sp3","to":{"cx":270,"cy":420}},{"at_ms":1800,"do":"move","dur_ms":800,"target":"sp4","to":{"cx":320,"cy":250}},{"at_ms":2600,"do":"show","shape":{"color":"#2980b9","id":"resS","kind":"text","size":22,"text":"almost every H\u207a breaks free","x":80,"y":500,"explain":"Almost every H+ breaks free: that is what makes an acid strong."}},{"at_ms":3000,"do":"show","shape":{"cx":595,"cy":310,"fill":"#2980b9","id":"wp1","kind":"circle","r":16,"stroke":"#2980b9","explain":"A bound hydrogen: in the weak acid most H stays attached to its molecule."}},{"at_ms":3000,"do":"show","shape":{"cx":640,"cy":310,"fill":"#2980b9","id":"wp2","kind":"circle","r":16,"stroke":"#2980b9","explain":"A bound hydrogen: in the weak acid most H stays attached to its molecule."}},{"at_ms":3000,"do":"show","shape":{"cx":685,"cy":310,"fill":"#2980b9","id":"wp3","kind":"circle","r":16,"stroke":"#2980b9","explain":"A bound hydrogen: in the weak acid most H stays attached to its molecule."}},{"at_ms":3000,"do":"show","shape":{"cx":617,"cy":360,"fill":"#2980b9","id":"wp4","kind":"circle","r":16,"stroke":"#2980b9","explain":"A bound hydrogen: in the weak acid most H stays attached to its molecule."}},{"at_ms":3300,"do":"move","dur_ms":800,"target":"wp1","to":{"cx":770,"cy":330}},{"at_ms":4100,"do":"show","shape":{"id":"bound","kind":"text","size":20,"text":"the rest stay bound","x":575,"y":430,"explain":"The rest stay bound: only 1 of 4 H+ breaks free in the weak acid."}},{"at_ms":4400,"do":"show","shape":{"color":"#c0392b","id":"resW","kind":"text","size":22,"text":"only 1 of 4 H\u207a breaks free","x":560,"y":500,"explain":"Only 1 of 4 H+ breaks free: few free ions means a weak acid."}},{"at_ms":5000,"do":"caption","text":"Judge the solution by its ions, not its name."}]},{"caption":"The titration curve: watch for the jump","duration_ms":9000,"id":"s8","narration":"Base goes in drop by drop and the pH curve draws itself: slow at first, then a single drop leaps the pH from 4 to 10. That vertical jump is the equivalence point, and an indicator must change colour somewhere on it.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","x":80,"y":70,"size":34,"text":"The titration curve"}},{"at_ms":300,"do":"show","shape":{"id":"xaxis","kind":"arrow","x1":120,"y1":470,"x2":830,"y2":470,"width":2,"explain":"The x-axis: millilitres of base added, drop by drop."}},{"at_ms":300,"do":"show","shape":{"id":"yaxis","kind":"arrow","x1":120,"y1":470,"x2":120,"y2":90,"width":2,"explain":"The y-axis: pH, from 0 to 14."}},{"at_ms":500,"do":"show","shape":{"id":"xlabel","kind":"text","x":380,"y":530,"size":20,"text":"volume of base added (mL)","explain":"volume of base added (mL): the burette drips base in, measured in mL."}},{"at_ms":500,"do":"show","shape":{"id":"ylabel","kind":"text","x":40,"y":110,"size":20,"text":"pH","explain":"pH: it climbs as the base neutralises the acid."}},{"at_ms":600,"do":"show","shape":{"id":"tick0","kind":"line","x1":112,"y1":470,"x2":128,"y2":470,"explain":"The 0 tick on the pH scale."}},{"at_ms":600,"do":"show","shape":{"id":"t0","kind":"text","x":100,"y":478,"size":18,"text":"0","explain":"0: the pH starts near 0 in the strong acid."}},{"at_ms":600,"do":"show","shape":{"id":"tick7","kind":"line","x1":112,"y1":280,"x2":128,"y2":280,"explain":"The 7 tick: the neutral mark."}},{"at_ms":600,"do":"show","shape":{"id":"t7","kind":"text","x":100,"y":288,"size":18,"text":"7","explain":"7: neutral, crossed on the steep jump."}},{"at_ms":600,"do":"show","shape":{"id":"tick14","kind":"line","x1":112,"y1":90,"x2":128,"y2":90,"explain":"The 14 tick: the top of the pH scale."}},{"at_ms":600,"do":"show","shape":{"id":"t14","kind":"text","x":88,"y":98,"size":18,"text":"14","explain":"14: the pH ceiling."}},{"at_ms":600,"do":"show","shape":{"id":"v0","kind":"text","x":114,"y":505,"size":18,"text":"0","explain":"0 mL: no base added yet."}},{"at_ms":600,"do":"show","shape":{"id":"v20","kind":"text","x":435,"y":505,"size":18,"text":"20 mL","explain":"20 mL of base added."}},{"at_ms":600,"do":"show","shape":{"id":"v40","kind":"text","x":775,"y":505,"size":18,"text":"40 mL","explain":"40 mL of base added."}},{"at_ms":900,"do":"show","shape":{"id":"burette","kind":"rect","x":872,"y":110,"w":36,"h":110,"fill":"#ffffff","stroke":"#1a1a1a","explain":"The burette: it drips base in drop by drop, measured in mL."}},{"at_ms":900,"do":"show","shape":{"id":"flask","kind":"rect","x":862,"y":390,"w":56,"h":56,"fill":"#d6eaf8","stroke":"#1a1a1a","explain":"The flask: it holds the acid being titrated."}},{"at_ms":1000,"do":"show","shape":{"id":"baselab","kind":"text","x":866,"y":100,"size":16,"text":"base","explain":"base: the alkali dripping from the burette."}},{"at_ms":1200,"do":"show","shape":{"id":"drop1","kind":"circle","cx":890,"cy":235,"r":6,"fill":"#2471a3","stroke":"#2471a3","explain":"A drop of base: each drop nudges the pH a little higher."}},{"at_ms":1300,"do":"move","target":"drop1","to":{"cy":375},"dur_ms":600},{"at_ms":2000,"do":"hide","target":"drop1"},{"at_ms":2000,"do":"show","shape":{"id":"seg1","kind":"line","x1":120,"y1":443,"x2":290,"y2":432,"width":3,"explain":"A curve segment: the pH climbing as base is added."}},{"at_ms":2000,"do":"show","shape":{"id":"probe","kind":"circle","cx":120,"cy":443,"r":8,"fill":"#c0392b","stroke":"#1a1a1a","explain":"The pH probe: it reads the pH after each drop."}},{"at_ms":2100,"do":"move","target":"probe","to":{"cx":290,"cy":432},"dur_ms":600},{"at_ms":2200,"do":"show","shape":{"id":"drop2","kind":"circle","cx":890,"cy":235,"r":6,"fill":"#2471a3","stroke":"#2471a3","explain":"A drop of base: each drop nudges the pH a little higher."}},{"at_ms":2300,"do":"move","target":"drop2","to":{"cy":375},"dur_ms":600},{"at_ms":3000,"do":"hide","target":"drop2"},{"at_ms":3000,"do":"show","shape":{"id":"seg2","kind":"line","x1":290,"y1":432,"x2":460,"y2":408,"width":3,"explain":"A curve segment: the pH climbing as base is added."}},{"at_ms":3100,"do":"move","target":"probe","to":{"cx":460,"cy":408},"dur_ms":600},{"at_ms":3200,"do":"show","shape":{"id":"drop3","kind":"circle","cx":890,"cy":235,"r":6,"fill":"#2471a3","stroke":"#2471a3","explain":"A drop of base: each drop nudges the pH a little higher."}},{"at_ms":3300,"do":"move","target":"drop3","to":{"cy":375},"dur_ms":600},{"at_ms":4000,"do":"hide","target":"drop3"},{"at_ms":4000,"do":"show","shape":{"id":"seg3","kind":"line","x1":460,"y1":408,"x2":528,"y2":361,"width":3,"explain":"A curve segment: the pH climbing as base is added."}},{"at_ms":4100,"do":"move","target":"probe","to":{"cx":528,"cy":361},"dur_ms":600},{"at_ms":4200,"do":"show","shape":{"id":"drop4","kind":"circle","cx":890,"cy":235,"r":6,"fill":"#2471a3","stroke":"#2471a3","explain":"A drop of base: each drop nudges the pH a little higher."}},{"at_ms":4300,"do":"move","target":"drop4","to":{"cy":375},"dur_ms":600},{"at_ms":5000,"do":"hide","target":"drop4"},{"at_ms":5000,"do":"show","shape":{"id":"seg4","kind":"line","x1":528,"y1":361,"x2":562,"y2":199,"width":4,"stroke":"#c0392b","explain":"A curve segment: the pH climbing as base is added."}},{"at_ms":5000,"do":"move","target":"probe","to":{"cx":562,"cy":199},"dur_ms":400},{"at_ms":5100,"do":"emphasize","target":"seg4","dur_ms":900},{"at_ms":5400,"do":"show","shape":{"id":"drop5","kind":"circle","cx":890,"cy":235,"r":6,"fill":"#2471a3","stroke":"#2471a3","explain":"A drop of base: each drop nudges the pH a little higher."}},{"at_ms":5500,"do":"move","target":"drop5","to":{"cy":375},"dur_ms":600},{"at_ms":6200,"do":"hide","target":"drop5"},{"at_ms":6200,"do":"show","shape":{"id":"seg5","kin