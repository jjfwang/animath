{"animath": "0.1", "canvas": {"height": 540, "width": 960}, "kind": "concept", "level": "secondary", "scenes": [{"caption": "Acids and alkalis around you", "duration_ms": 6000, "id": "s1", "narration": "Lemon juice and vinegar are acids; soap and baking soda are alkalis. Chemists sort them on one number line: the pH scale.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 34, "text": "Acids and alkalis around you", "x": 80, "y": 70}}, {"at_ms": 400, "do": "show", "shape": {"fill": "#ffffff", "h": 220, "id": "beakerA", "kind": "rect", "stroke": "#1a1a1a", "w": 120, "x": 140, "y": 170}}, {"at_ms": 400, "do": "show", "shape": {"fill": "#ffffff", "h": 220, "id": "beakerB", "kind": "rect", "stroke": "#1a1a1a", "w": 120, "x": 420, "y": 170}}, {"at_ms": 800, "do": "show", "shape": {"fill": "#c0392b", "h": 12, "id": "fillA", "kind": "rect", "stroke": "#c0392b", "w": 104, "x": 148, "y": 370}}, {"at_ms": 900, "do": "move", "dur_ms": 1400, "target": "fillA", "to": {"h": 182, "y": 200}}, {"at_ms": 1000, "do": "show", "shape": {"fill": "#2471a3", "h": 12, "id": "fillB", "kind": "rect", "stroke": "#2471a3", "w": 104, "x": 428, "y": 370}}, {"at_ms": 1100, "do": "move", "dur_ms": 1400, "target": "fillB", "to": {"h": 182, "y": 200}}, {"at_ms": 2600, "do": "show", "shape": {"color": "#c0392b", "id": "labA", "kind": "text", "size": 26, "text": "acid", "x": 148, "y": 430}}, {"at_ms": 2700, "do": "show", "shape": {"color": "#2471a3", "id": "labB", "kind": "text", "size": 26, "text": "alkali", "x": 412, "y": 430}}, {"at_ms": 3000, "do": "show", "shape": {"id": "ex", "kind": "text", "size": 22, "text": "lemon juice · vinegar · stomach acid  |  soap · baking soda · toothpaste", "x": 80, "y": 500}}, {"at_ms": 3800, "do": "caption", "text": "Acids and alkalis are part of everyday life."}]}, {"caption": "The pH scale ladder", "duration_ms": 8000, "id": "s2", "narration": "The pH scale runs from 0 to 14, with 7 neutral. Each step away from 7 is ten times stronger.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 34, "text": "The pH scale", "x": 80, "y": 70}}, {"at_ms": 400, "do": "show", "shape": {"fill": "#c0392b", "h": 8, "id": "r1", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 140, "y": 120}}, {"at_ms": 500, "do": "move", "dur_ms": 900, "target": "r1", "to": {"h": 120}}, {"at_ms": 1400, "do": "show", "shape": {"id": "t0", "kind": "text", "size": 22, "text": "pH 0 — strongly acidic", "x": 230, "y": 450}}, {"at_ms": 1600, "do": "show", "shape": {"fill": "#e67e22", "h": 8, "id": "r2", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 140, "y": 240}}, {"at_ms": 1700, "do": "move", "dur_ms": 800, "target": "r2", "to": {"h": 80}}, {"at_ms": 2000, "do": "show", "shape": {"id": "t1", "kind": "text", "size": 22, "text": "pH 1–6 — acidic", "x": 230, "y": 400}}, {"at_ms": 2300, "do": "show", "shape": {"fill": "#27ae60", "h": 8, "id": "r3", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 140, "y": 320}}, {"at_ms": 2400, "do": "move", "dur_ms": 700, "target": "r3", "to": {"h": 40}}, {"at_ms": 2700, "do": "show", "shape": {"id": "t7", "kind": "text", "size": 22, "text": "pH 7 — neutral", "x": 230, "y": 340}}, {"at_ms": 3000, "do": "show", "shape": {"fill": "#7d3c98", "h": 8, "id": "r4", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 140, "y": 360}}, {"at_ms": 3100, "do": "move", "dur_ms": 900, "target": "r4", "to": {"h": 120}}, {"at_ms": 3400, "do": "show", "shape": {"id": "t8", "kind": "text", "size": 22, "text": "pH 8–13 — alkaline", "x": 230, "y": 180}}, {"at_ms": 3800, "do": "show", "shape": {"id": "t14", "kind": "text", "size": 22, "text": "pH 14 — strongly alkaline", "x": 230, "y": 130}}, {"at_ms": 4200, "do": "show", "shape": {"id": "ladder", "kind": "arrow", "stroke": "#1a1a1a", "width": 3, "x1": 210, "x2": 210, "y1": 470, "y2": 110}}, {"at_ms": 4600, "do": "emphasize", "target": "t7"}, {"at_ms": 5200, "do": "caption", "text": "pH 7 is neutral; lower is acidic, higher is alkaline."}, {"at_ms": 5800, "do": "show", "shape": {"id": "jump", "kind": "text", "size": 22, "text": "Each step is ten times stronger — a big jump.", "x": 80, "y": 505}}]}, {"caption": "What pH is really about: ions", "duration_ms": 9000, "id": "s3", "narration": "Acids release H+ ions and alkalis release OH− ions in water. Whichever ion is in excess decides the pH.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 34, "text": "It is about ions: H⁺ and OH⁻", "x": 80, "y": 70}}, {"at_ms": 400, "do": "show", "shape": {"color": "#c0392b", "id": "acidZone", "kind": "text", "size": 24, "text": "acid", "x": 100, "y": 130}}, {"at_ms": 400, "do": "show", "shape": {"fill": "#ffffff", "h": 170, "id": "acidBottle", "kind": "rect", "stroke": "#c0392b", "w": 90, "x": 100, "y": 150}}, {"at_ms": 400, "do": "show", "shape": {"color": "#2471a3", "id": "alkZone", "kind": "text", "size": 24, "text": "alkali", "x": 770, "y": 130}}, {"at_ms": 400, "do": "show", "shape": {"fill": "#ffffff", "h": 170, "id": "alkBottle", "kind": "rect", "stroke": "#2471a3", "w": 90, "x": 770, "y": 150}}, {"at_ms": 1000, "do": "show", "shape": {"cx": 145, "cy": 195, "fill": "#2980b9", "id": "hp1", "kind": "circle", "r": 20, "stroke": "#2980b9"}}, {"at_ms": 1000, "do": "show", "shape": {"color": "#ffffff", "id": "hp1L", "kind": "text", "size": 18, "text": "H⁺", "x": 134, "y": 202}}, {"at_ms": 1000, "do": "show", "shape": {"cx": 145, "cy": 250, "fill": "#2980b9", "id": "hp2", "kind": "circle", "r": 20, "stroke": "#2980b9"}}, {"at_ms": 1000, "do": "show", "shape": {"color": "#ffffff", "id": "hp2L", "kind": "text", "size": 18, "text": "H⁺", "x": 134, "y": 257}}, {"at_ms": 1000, "do": "show", "shape": {"cx": 145, "cy": 305, "fill": "#2980b9", "id": "hp3", "kind": "circle", "r": 20, "stroke": "#2980b9"}}, {"at_ms": 1000, "do": "show", "shape": {"color": "#ffffff", "id": "hp3L", "kind": "text", "size": 18, "text": "H⁺", "x": 134, "y": 312}}, {"at_ms": 1400, "do": "move", "dur_ms": 1000, "target": "hp1", "to": {"cx": 300, "cy": 180}}, {"at_ms": 1400, "do": "move", "dur_ms": 1000, "target": "hp1L", "to": {"x": 289, "y": 187}}, {"at_ms": 1600, "do": "move", "dur_ms": 1000, "target": "hp2", "to": {"cx": 330, "cy": 270}}, {"at_ms": 1600, "do": "move", "dur_ms": 1000, "target": "hp2L", "to": {"x": 319, "y": 277}}, {"at_ms": 1800, "do": "move", "dur_ms": 1000, "target": "hp3", "to": {"cx": 290, "cy": 360}}, {"at_ms": 1800, "do": "move", "dur_ms": 1000, "target": "hp3L", "to": {"x": 279, "y": 367}}, {"at_ms": 3000, "do": "show", "shape": {"cx": 815, "cy": 195, "fill": "#c0392b", "id": "oh1", "kind": "circle", "r": 22, "stroke": "#c0392b"}}, {"at_ms": 3000, "do": "show", "shape": {"color": "#ffffff", "id": "oh1L", "kind": "text", "size": 16, "text": "OH⁻", "x": 800, "y": 202}}, {"at_ms": 3000, "do": "show", "shape": {"cx": 815, "cy": 250, "fill": "#c0392b", "id": "oh2", "kind": "circle", "r": 22, "stroke": "#c0392b"}}, {"at_ms": 3000, "do": "show", "shape": {"color": "#ffffff", "id": "oh2L", "kind": "text", "size": 16, "text": "OH⁻", "x": 800, "y": 257}}, {"at_ms": 3000, "do": "show", "shape": {"cx": 815, "cy": 305, "fill": "#c0392b", "id": "oh3", "kind": "circle", "r": 22, "stroke": "#c0392b"}}, {"at_ms": 3000, "do": "show", "shape": {"color": "#ffffff", "id": "oh3L", "kind": "text", "size": 16, "text": "OH⁻", "x": 800, "y": 312}}, {"at_ms": 3400, "do": "move", "dur_ms": 1000, "target": "oh1", "to": {"cx": 660, "cy": 180}}, {"at_ms": 3400, "do": "move", "dur_ms": 1000, "target": "oh1L", "to": {"x": 645, "y": 187}}, {"at_ms": 3600, "do": "move", "dur_ms": 1000, "target": "oh2", "to": {"cx": 630, "cy": 270}}, {"at_ms": 3600, "do": "move", "dur_ms": 1000, "target": "oh2L", "to": {"x": 615, "y": 277}}, {"at_ms": 3800, "do": "move", "dur_ms": 1000, "target": "oh3", "to": {"cx": 670, "cy": 360}}, {"at_ms": 3800, "do": "move", "dur_ms": 1000, "target": "oh3L", "to": {"x": 655, "y": 367}}, {"at_ms": 5000, "do": "show", "shape": {"id": "acidRule", "kind": "text", "size": 24, "text": "More H⁺ than OH⁻ → acidic", "x": 80, "y": 470}}, {"at_ms": 5600, "do": "show", "shape": {"id": "alkRule", "kind": "text", "size": 24, "text": "More OH⁻ than H⁺ → alkaline", "x": 480, "y": 470}}, {"at_ms": 6400, "do": "show", "shape": {"id": "neuRule", "kind": "text", "size": 24, "text": "Equal numbers → neutral.", "x": 280, "y": 515}}, {"at_ms": 7000, "do": "caption", "text": "The winning ion decides the pH."}]}, {"caption": "Neutralisation: a worked example", "duration_ms": 9000, "id": "s4", "narration": "Mix an acid with an alkali and the H+ and OH− ions pair up to make water. The leftover ions form a salt: acid plus alkali always gives salt plus water.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 30, "text": "Neutralisation: acid + alkali → salt + water", "x": 80, "y": 70}}, {"at_ms": 400, "do": "show", "shape": {"color": "#1f7a3a", "id": "eq", "kind": "latex", "size": 40, "tex": "\\mathrm{HCl + NaOH \\rightarrow NaCl + H_2O}", "x": 120, "y": 220}}, {"at_ms": 1800, "do": "show", "shape": {"cx": 200, "cy": 420, "fill": "#2980b9", "id": "h", "kind": "circle", "r": 26, "stroke": "#2980b9"}}, {"at_ms": 1800, "do": "show", "shape": {"color": "#ffffff", "id": "hL", "kind": "text", "size": 22, "text": "H⁺", "x": 189, "y": 429}}, {"at_ms": 1800, "do": "show", "shape": {"cx": 400, "cy": 420, "fill": "#c0392b", "id": "oh", "kind": "circle", "r": 30, "stroke": "#c0392b"}}, {"at_ms": 1800, "do": "show", "shape": {"color": "#ffffff", "id": "ohL", "kind": "text", "size": 20, "text": "OH⁻", "x": 384, "y": 428}}, {"at_ms": 2400, "do": "move", "dur_ms": 1200, "target": "h", "to": {"cx": 300, "cy": 420}}, {"at_ms": 2400, "do": "move", "dur_ms": 1200, "target": "hL", "to": {"x": 289, "y": 429}}, {"at_ms": 2400, "do": "move", "dur_ms": 1200, "target": "oh", "to": {"cx": 300, "cy": 420}}, {"at_ms": 2400, "do": "move", "dur_ms": 1200, "target": "ohL", "to": {"x": 284, "y": 428}}, {"at_ms": 3700, "do": "hide", "target": "h"}, {"at_ms": 3700, "do": "hide", "target": "hL"}, {"at_ms": 3700, "do": "hide", "target": "oh"}, {"at_ms": 3700, "do": "hide", "target": "ohL"}, {"at_ms": 3700, "do": "show", "shape": {"cx": 300, "cy": 420, "fill": "#5dade2", "id": "water", "kind": "circle", "r": 42, "stroke": "#2e86c1"}}, {"at_ms": 3700, "do": "show", "shape": {"color": "#ffffff", "id": "waterL", "kind": "text", "size": 22, "text": "H₂O", "x": 278, "y": 429}}, {"at_ms": 4400, "do": "show", "shape": {"cx": 620, "cy": 420, "fill": "#8e44ad", "id": "na", "kind": "circle", "r": 24, "stroke": "#8e44ad"}}, {"at_ms": 4400, "do": "show", "shape": {"color": "#ffffff", "id": "naL", "kind": "text", "size": 18, "text": "Na⁺", "x": 607, "y": 428}}, {"at_ms": 4400, "do": "show", "shape": {"cx": 760, "cy": 420, "fill": "#27ae60", "id": "cl", "kind": "circle", "r": 24, "stroke": "#27ae60"}}, {"at_ms": 4400, "do": "show", "shape": {"color": "#ffffff", "id": "clL", "kind": "text", "size": 18, "text": "Cl⁻", "x": 748, "y": 428}}, {"at_ms": 5000, "do": "move", "dur_ms": 1000, "target": "na", "to": {"cx": 690, "cy": 420}}, {"at_ms": 5000, "do": "move", "dur_ms": 1000, "target": "naL", "to": {"x": 677, "y": 428}}, {"at_ms": 5000, "do": "move", "dur_ms": 1000, "target": "cl", "to": {"cx": 690, "cy": 420}}, {"at_ms": 5000, "do": "move", "dur_ms": 1000, "target": "clL", "to": {"x": 678, "y": 428}}, {"at_ms": 6100, "do": "hide", "target": "na"}, {"at_ms": 6100, "do": "hide", "target": "naL"}, {"at_ms": 6100, "do": "hide", "target": "cl"}, {"at_ms": 6100, "do": "hide", "target": "clL"}, {"at_ms": 6100, "do": "show", "shape": {"fill": "#ecf0f1", "h": 64, "id": "salt", "kind": "rect", "stroke": "#1a1a1a", "w": 64, "x": 658, "y": 388}}, {"at_ms": 6100, "do": "show", "shape": {"id": "saltL", "kind": "text", "size": 22, "text": "NaCl", "x": 668, "y": 428}}, {"at_ms": 6800, "do": "caption", "text": "Neutralisation always makes salt and water."}]}, {"caption": "The litmus test", "duration_ms": 8000, "id": "s5", "narration": "Litmus paper is a quick dye test: blue litmus turns red in acid, red litmus turns blue in alkali. No change means neutral.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 34, "text": "The litmus test", "x": 80, "y": 70}}, {"at_ms": 400, "do": "show", "shape": {"color": "#c0392b", "id": "labA", "kind": "text", "size": 24, "text": "acid", "x": 150, "y": 150}}, {"at_ms": 400, "do": "show", "shape": {"fill": "#ffffff", "h": 240, "id": "beakerA", "kind": "rect", "stroke": "#1a1a1a", "w": 200, "x": 150, "y": 170}}, {"at_ms": 600, "do": "show", "shape": {"fill": "#f1948a", "h": 102, "id": "acidLiq", "kind": "rect", "stroke": "#f1948a", "w": 184, "x": 158, "y": 300}}, {"at_ms": 1000, "do": "show", "shape": {"fill": "#2471a3", "h": 120, "id": "stripB", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 245, "y": 90}}, {"at_ms": 1000, "do": "show", "shape": {"id": "stripBL", "kind": "text", "size": 20, "text": "blue litmus", "x": 130, "y": 110}}, {"at_ms": 1600, "do": "move", "dur_ms": 1200, "target": "stripB", "to": {"y": 220}}, {"at_ms": 1600, "do": "move", "dur_ms": 1200, "target": "stripBL", "to": {"y": 210}}, {"at_ms": 2900, "do": "hide", "target": "stripB"}, {"at_ms": 2900, "do": "show", "shape": {"fill": "#c0392b", "h": 120, "id": "stripB2", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 245, "y": 220}}, {"at_ms": 3300, "do": "show", "shape": {"color": "#c0392b", "id": "resA", "kind": "text", "size": 24, "text": "blue litmus turns RED", "x": 150, "y": 450}}, {"at_ms": 3800, "do": "show", "shape": {"color": "#2471a3", "id": "labB", "kind": "text", "size": 24, "text": "alkali", "x": 600, "y": 150}}, {"at_ms": 3800, "do": "show", "shape": {"fill": "#ffffff", "h": 240, "id": "beakerB", "kind": "rect", "stroke": "#1a1a1a", "w": 200, "x": 600, "y": 170}}, {"at_ms": 4000, "do": "show", "shape": {"fill": "#aed6f1", "h": 102, "id": "alkLiq", "kind": "rect", "stroke": "#aed6f1", "w": 184, "x": 608, "y": 300}}, {"at_ms": 4400, "do": "show", "shape": {"fill": "#c0392b", "h": 120, "id": "stripR", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 695, "y": 90}}, {"at_ms": 4400, "do": "show", "shape": {"id": "stripRl", "kind": "text", "size": 20, "text": "red litmus", "x": 575, "y": 110}}, {"at_ms": 4800, "do": "move", "dur_ms": 1200, "target": "stripR", "to": {"y": 220}}, {"at_ms": 4800, "do": "move", "dur_ms": 1200, "target": "stripRl", "to": {"y": 210}}, {"at_ms": 6100, "do": "hide", "target": "stripR"}, {"at_ms": 6100, "do": "show", "shape": {"fill": "#2471a3", "h": 120, "id": "stripR2", "kind": "rect", "stroke": "#1a1a1a", "w": 40, "x": 695, "y": 220}}, {"at_ms": 6500, "do": "show", "shape": {"color": "#2471a3", "id": "resB", "kind": "text", "size": 24, "text": "red litmus turns BLUE", "x": 600, "y": 450}}, {"at_ms": 7000, "do": "caption", "text": "Blue goes red in acid; red goes blue in alkali."}]}, {"caption": "Naming the salt", "duration_ms": 7000, "id": "s6", "narration": "The salt takes its name from the acid. Hydrochloric gives a chloride, nitric a nitrate, sulfuric a sulfate.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 34, "text": "Naming the salt", "x": 80, "y": 70}}, {"at_ms": 300, "do": "show", "shape": {"id": "chip1", "kind": "text", "size": 24, "text": "hydrochloric acid", "x": 120, "y": 190}}, {"at_ms": 500, "do": "show", "shape": {"id": "a1", "kind": "arrow", "stroke": "#1a1a1a", "width": 3, "x1": 420, "x2": 490, "y1": 180, "y2": 180}}, {"at_ms": 700, "do": "move", "dur_ms": 900, "target": "chip1", "to": {"x": 520}}, {"at_ms": 1700, "do": "hide", "target": "chip1"}, {"at_ms": 1700, "do": "show", "shape": {"id": "salt1", "kind": "text", "size": 24, "text": "sodium CHLORIDE", "x": 520, "y": 190}}, {"at_ms": 2000, "do": "emphasize", "target": "salt1"}, {"at_ms": 2600, "do": "show", "shape": {"id": "chip2", "kind": "text", "size": 24, "text": "nitric acid", "x": 120, "y": 310}}, {"at_ms": 2700, "do": "show", "shape": {"id": "a2", "kind": "arrow", "stroke": "#1a1a1a", "width": 3, "x1": 420, "x2": 490, "y1": 300, "y2": 300}}, {"at_ms": 2900, "do": "move", "dur_ms": 900, "target": "chip2", "to": {"x": 520}}, {"at_ms": 3900, "do": "hide", "target": "chip2"}, {"at_ms": 3900, "do": "show", "shape": {"id": "salt2", "kind": "text", "size": 24, "text": "potassium NITRATE", "x": 520, "y": 310}}, {"at_ms": 4100, "do": "emphasize", "target": "salt2"}, {"at_ms": 4500, "do": "show", "shape": {"id": "chip3", "kind": "text", "size": 24, "text": "sulfuric acid", "x": 120, "y": 430}}, {"at_ms": 4600, "do": "show", "shape": {"id": "a3", "kind": "arrow", "stroke": "#1a1a1a", "width": 3, "x1": 420, "x2": 490, "y1": 420, "y2": 420}}, {"at_ms": 4800, "do": "move", "dur_ms": 900, "target": "chip3", "to": {"x": 520}}, {"at_ms": 5800, "do": "hide", "target": "chip3"}, {"at_ms": 5800, "do": "show", "shape": {"id": "salt3", "kind": "text", "size": 24, "text": "magnesium SULFATE", "x": 520, "y": 430}}, {"at_ms": 6000, "do": "emphasize", "target": "salt3"}, {"at_ms": 6400, "do": "caption", "text": "The acid names the salt: −ic becomes −ate."}]}, {"caption": "Misconception: all acids are strong", "duration_ms": 6000, "id": "s7", "narration": "Not every acid is fierce: weak acids like vinegar only partly release their H+ ions. pH measures the solution's ion concentration, not just which acid you started with.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "size": 34, "text": "Check the thinking", "x": 80, "y": 70}}, {"at_ms": 400, "do": "show", "shape": {"id": "myth", "kind": "text", "size": 28, "text": "❌ “All acids are strong.”", "x": 80, "y": 170}}, {"at_ms": 800, "do": "show", "shape": {"id": "strongLab", "kind": "text", "size": 24, "text": "strong acid", "x": 80, "y": 250}}, {"at_ms": 800, "do": "show", "shape": {"fill": "#ffffff", "h": 190, "id": "beakerS", "kind": "rect", "stroke": "#1a1a1a", "w": 160, "x": 80, "y": 270}}, {"at_ms": 800, "do": "show", "shape": {"id": "weakLab", "kind"