        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "cx": 480,
            "cy": 270,
            "id": "coil",
            "kind": "circle",
            "r": 90,
            "stroke": "#1a1a1a",
            "width": 3
          }
        },
        {
          "at_ms": 1200,
          "do": "show",
          "shape": {
            "id": "coilLab",
            "kind": "text",
            "size": 24,
            "text": "one turn of wire",
            "x": 560,
            "y": 420
          }
        },
