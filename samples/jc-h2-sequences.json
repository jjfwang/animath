{"animath":"0.1","canvas":{"width":960,"height":540},"kind":"concept","level":"jc","subject":"math","topic":"h2-sequences","title":"JC H2 sequences: arithmetic and geometric progressions","scenes":[{"id":"s1","caption":"Arithmetic progressions: add d each step","narration":"An arithmetic progression adds the same common difference d every step. Starting from 5 with d = 3, the terms are 5, 8, 11, 14, and the marker hops the axis in equal jumps.","duration_ms":8000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"axis","kind":"line","stroke":"#1a1a1a","width":2,"x1":80,"y1":400,"x2":880,"y2":400,"explain":"The number axis the marker hops along."}},{"at_ms":800,"do":"show","shape":{"id":"d1","kind":"circle","cx":200,"cy":400,"r":9,"fill":"#c2410c","explain":"The starting dot: the first term, 5."}},{"at_ms":800,"do":"show","shape":{"id":"lab1","kind":"text","x":192,"y":352,"text":"5","size":26,"explain":"The term value: 5."}},{"at_ms":1400,"do":"show","shape":{"id":"d2","kind":"circle","cx":350,"cy":400,"r":9,"fill":"#c2410c","explain":"The second dot: 8, one jump on from the start."}},{"at_ms":1400,"do":"show","shape":{"id":"lab2","kind":"text","x":342,"y":352,"text":"8","size":26,"explain":"The term value: 8."}},{"at_ms":2000,"do":"show","shape":{"id":"d3","kind":"circle","cx":500,"cy":400,"r":9,"fill":"#c2410c","explain":"The third dot: 11, two jumps on."}},{"at_ms":2000,"do":"show","shape":{"id":"lab3","kind":"text","x":492,"y":352,"text":"11","size":26,"explain":"The term value: 11."}},{"at_ms":2600,"do":"show","shape":{"id":"d4","kind":"circle","cx":650,"cy":400,"r":9,"fill":"#c2410c","explain":"The fourth dot: 14, three jumps on."}},{"at_ms":2600,"do":"show","shape":{"id":"lab4","kind":"text","x":642,"y":352,"text":"14","size":26,"explain":"The term value: 14."}},{"at_ms":3200,"do":"show","shape":{"id":"marker","kind":"circle","cx":200,"cy":400,"r":11,"fill":"#c0392b","explain":"The hopping marker: it visits each term in turn."}},{"at_ms":3600,"do":"show","shape":{"id":"jmp1","kind":"text","x":261,"y":428,"text":"+3","size":26,"explain":"The common difference: +3, the same jump every time."}},{"at_ms":3600,"do":"move","target":"marker","to":{"cx":350,"cy":400},"dur_ms":700},{"at_ms":4400,"do":"show","shape":{"id":"jmp2","kind":"text","x":411,"y":428,"text":"+3","size":26,"explain":"The common difference again: +3, every step the same."}},{"at_ms":4400,"do":"move","target":"marker","to":{"cx":500,"cy":400},"dur_ms":700},{"at_ms":5200,"do":"show","shape":{"id":"jmp3","kind":"text","x":561,"y":428,"text":"+3","size":26,"explain":"The common difference again: +3, every step the same."}},{"at_ms":5200,"do":"move","target":"marker","to":{"cx":650,"cy":400},"dur_ms":700},{"at_ms":6400,"do":"show","shape":{"id":"apEq","kind":"latex","x":180,"y":150,"size":40,"color":"#1f7a3a","tex":"u_n = a + (n - 1)d","explain":"The AP formula: start at a, add d exactly n-1 times."}}]},{"id":"s2","caption":"Geometric progressions: multiply by r each step","narration":"A geometric progression multiplies by the same ratio r every step. Here r = 2, so the jumps double each time and the marker covers widening ground.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"axis","kind":"line","stroke":"#1a1a1a","width":2,"x1":80,"y1":400,"x2":880,"y2":400,"explain":"The number line: each step multiplies the previous term by r."}},{"at_ms":800,"do":"show","shape":{"id":"g1","kind":"circle","cx":140,"cy":400,"r":9,"fill":"#c2410c","explain":"The first dot: 2, where the geometric run starts."}},{"at_ms":800,"do":"show","shape":{"id":"glab1","kind":"text","x":132,"y":352,"text":"2","size":26,"explain":"The term value: 2."}},{"at_ms":1300,"do":"show","shape":{"id":"g2","kind":"circle","cx":240,"cy":400,"r":9,"fill":"#c2410c","explain":"The second dot: 4, the first doubling."}},{"at_ms":1300,"do":"show","shape":{"id":"glab2","kind":"text","x":232,"y":352,"text":"4","size":26,"explain":"The term value: 4."}},{"at_ms":1800,"do":"show","shape":{"id":"g3","kind":"circle","cx":440,"cy":400,"r":9,"fill":"#c2410c","explain":"The third dot: 8, doubled again."}},{"at_ms":1800,"do":"show","shape":{"id":"glab3","kind":"text","x":432,"y":352,"text":"8","size":26,"explain":"The term value: 8."}},{"at_ms":2300,"do":"show","shape":{"id":"g4","kind":"circle","cx":840,"cy":400,"r":9,"fill":"#c2410c","explain":"The fourth dot: 16, the jumps now cover wide ground."}},{"at_ms":2300,"do":"show","shape":{"id":"glab4","kind":"text","x":832,"y":352,"text":"16","size":26,"explain":"The term value: 16."}},{"at_ms":3000,"do":"show","shape":{"id":"gmarker","kind":"circle","cx":140,"cy":400,"r":11,"fill":"#c0392b","explain":"The marker: its jumps double each time."}},{"at_ms":3400,"do":"show","shape":{"id":"gjmp1","kind":"text","x":174,"y":428,"text":"x2","size":26,"explain":"The common ratio: times 2, every step."}},{"at_ms":3400,"do":"move","target":"gmarker","to":{"cx":240,"cy":400},"dur_ms":700},{"at_ms":4200,"do":"show","shape":{"id":"gjmp2","kind":"text","x":324,"y":428,"text":"x2","size":26,"explain":"The common ratio again: times 2, every step."}},{"at_ms":4200,"do":"move","target":"gmarker","to":{"cx":440,"cy":400},"dur_ms":700},{"at_ms":5000,"do":"show","shape":{"id":"gjmp3","kind":"text","x":624,"y":428,"text":"x2","size":26,"explain":"The common ratio again: times 2, every step."}},{"at_ms":5000,"do":"move","target":"gmarker","to":{"cx":840,"cy":400},"dur_ms":700},{"at_ms":6400,"do":"show","shape":{"id":"gpEq","kind":"latex","x":180,"y":150,"size":40,"color":"#1f7a3a","tex":"u_n = 2 × 2^(n-1)","explain":"The GP formula: 2 times 2 to the n-1."}}]},{"id":"s3","caption":"Seeing the sum build up","narration":"Watch the partial sums build up: each new term drops into the running total and the bar grows. After four terms the total is 20, and the formula comes after the buildup.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"baseLine","kind":"line","stroke":"#1a1a1a","width":3,"x1":540,"y1":470,"x2":680,"y2":470,"explain":"The base the running-total bar grows from."}},{"at_ms":300,"do":"show","shape":{"id":"bar","kind":"rect","x":560,"y":466,"w":80,"h":4,"fill":"#dbeafe","stroke":"#1a56db","width":2,"explain":"The total bar: it grows as each new term drops in."}},{"at_ms":300,"do":"show","shape":{"id":"snLab","kind":"text","x":692,"y":470,"text":"S_n","size":28,"explain":"S sub n: the sum of the first n terms."}},{"at_ms":900,"do":"show","shape":{"id":"chip1","kind":"circle","cx":180,"cy":130,"r":14,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The first term, 2, dropping into the running total."}},{"at_ms":900,"do":"show","shape":{"id":"chipLab1","kind":"text","x":172,"y":137,"text":"2","size":20,"explain":"The term value: 2."}},{"at_ms":900,"do":"show","shape":{"id":"chip2","kind":"circle","cx":300,"cy":130,"r":14,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The second term, 4, dropping into the running total."}},{"at_ms":900,"do":"show","shape":{"id":"chipLab2","kind":"text","x":292,"y":137,"text":"4","size":20,"explain":"The term value: 4."}},{"at_ms":900,"do":"show","shape":{"id":"chip3","kind":"circle","cx":420,"cy":130,"r":14,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The third term, 6, dropping into the running total."}},{"at_ms":900,"do":"show","shape":{"id":"chipLab3","kind":"text","x":412,"y":137,"text":"6","size":20,"explain":"The term value: 6."}},{"at_ms":900,"do":"show","shape":{"id":"chip4","kind":"circle","cx":540,"cy":130,"r":14,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The fourth term, 8, dropping into the running total."}},{"at_ms":900,"do":"show","shape":{"id":"chipLab4","kind":"text","x":532,"y":137,"text":"8","size":20,"explain":"The term value: 8."}},{"at_ms":1800,"do":"move","target":"chip1","to":{"cx":600,"cy":440},"dur_ms":800},{"at_ms":1800,"do":"move","target":"chipLab1","to":{"x":592,"y":447},"dur_ms":800},{"at_ms":2650,"do":"hide","target":"chip1"},{"at_ms":2650,"do":"hide","target":"chipLab1"},{"at_ms":2650,"do":"move","target":"bar","to":{"y":440,"h":30},"dur_ms":700},{"at_ms":2650,"do":"show","shape":{"id":"sumLab1","kind":"text","x":700,"y":200,"text":"S1 = 2","size":26,"explain":"The running total after 1 term: S1 = 2."}},{"at_ms":3300,"do":"move","target":"chip2","to":{"cx":600,"cy":380},"dur_ms":800},{"at_ms":3300,"do":"move","target":"chipLab2","to":{"x":592,"y":387},"dur_ms":800},{"at_ms":4150,"do":"hide","target":"chip2"},{"at_ms":4150,"do":"hide","target":"chipLab2"},{"at_ms":4150,"do":"move","target":"bar","to":{"y":380,"h":90},"dur_ms":700},{"at_ms":4150,"do":"show","shape":{"id":"sumLab2","kind":"text","x":700,"y":245,"text":"S2 = 6","size":26,"explain":"The running total after 2 terms: S2 = 6."}},{"at_ms":4800,"do":"move","target":"chip3","to":{"cx":600,"cy":290},"dur_ms":800},{"at_ms":4800,"do":"move","target":"chipLab3","to":{"x":592,"y":297},"dur_ms":800},{"at_ms":5650,"do":"hide","target":"chip3"},{"at_ms":5650,"do":"hide","target":"chipLab3"},{"at_ms":5650,"do":"move","target":"bar","to":{"y":290,"h":180},"dur_ms":700},{"at_ms":5650,"do":"show","shape":{"id":"sumLab3","kind":"text","x":700,"y":290,"text":"S3 = 12","size":26,"explain":"The running total after 3 terms: S3 = 12."}},{"at_ms":6300,"do":"move","target":"chip4","to":{"cx":600,"cy":170},"dur_ms":800},{"at_ms":6300,"do":"move","target":"chipLab4","to":{"x":592,"y":177},"dur_ms":800},{"at_ms":7150,"do":"hide","target":"chip4"},{"at_ms":7150,"do":"hide","target":"chipLab4"},{"at_ms":7150,"do":"move","target":"bar","to":{"y":170,"h":300},"dur_ms":700},{"at_ms":7150,"do":"show","shape":{"id":"sumLab4","kind":"text","x":700,"y":335,"text":"S4 = 20","size":26,"explain":"The running total after 4 terms: S4 = 20."}},{"at_ms":8000,"do":"show","shape":{"id":"sumEq","kind":"latex","x":120,"y":470,"size":40,"color":"#1f7a3a","tex":"S_n = (n/2)(a + l)","explain":"The sum formula: n over 2 times first plus last."}}]},{"id":"s4","caption":"A common mistake: r = -1 never settles","narration":"A common mistake: a geometric progression with r = -1 settles down eventually. The terms bounce between two values forever, and two close values feel like they are homing in on a limit. It never settles: convergence needs the ratio to shrink, with |r| < 1, and then the terms home in on the limit.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"axis","kind":"line","stroke":"#1a1a1a","width":2,"x1":80,"y1":300,"x2":880,"y2":300,"explain":"The number line: with r = -1 the terms flip sides and never settle."}},{"at_ms":600,"do":"show","shape":{"id":"tickA","kind":"circle","cx":300,"cy":300,"r":5,"fill":"#1a1a1a","explain":"The -1 pole: the bouncing terms keep landing here."}},{"at_ms":600,"do":"show","shape":{"id":"tickB","kind":"circle","cx":660,"cy":300,"r":5,"fill":"#1a1a1a","explain":"The 1 pole: the bouncing terms keep landing here."}},{"at_ms":600,"do":"show","shape":{"id":"valA","kind":"text","x":286,"y":345,"text":"-1","size":30,"explain":"The term value: -1."}},{"at_ms":600,"do":"show","shape":{"id":"valB","kind":"text","x":650,"y":345,"text":"1","size":30,"explain":"The term value: 1."}},{"at_ms":900,"do":"show","shape":{"id":"osc","kind":"circle","cx":300,"cy":300,"r":11,"fill":"#c0392b","explain":"The oscillator: it bounces between -1 and 1 forever."}},{"at_ms":1400,"do":"move","target":"osc","to":{"cx":660,"cy":300},"dur_ms":800},{"at_ms":2600,"do":"move","target":"osc","to":{"cx":300,"cy":300},"dur_ms":800},{"at_ms":3800,"do":"move","target":"osc","to":{"cx":660,"cy":300},"dur_ms":800},{"at_ms":4900,"do":"show","shape":{"id":"neverSettles","kind":"text","x":400,"y":220,"text":"it never settles","size":30,"color":"#c0392b","explain":"The verdict: with r = -1 the terms never settle on a limit."}},{"at_ms":5600,"do":"hide","target":"osc"},{"at_ms":5600,"do":"hide","target":"neverSettles"},{"at_ms":5600,"do":"hide","target":"tickA"},{"at_ms":5600,"do":"hide","target":"tickB"},{"at_ms":5600,"do":"hide","target":"valA"},{"at_ms":5600,"do":"hide","target":"valB"},{"at_ms":6000,"do":"show","shape":{"id":"c1","kind":"circle","cx":200,"cy":300,"r":9,"fill":"#c2410c","explain":"A dot of the shrinking sequence: each step pulls closer to the limit."}},{"at_ms":6300,"do":"show","shape":{"id":"c2","kind":"circle","cx":500,"cy":300,"r":9,"fill":"#c2410c","explain":"Another shrinking dot: closer to the limit than the last."}},{"at_ms":6600,"do":"show","shape":{"id":"c3","kind":"circle","cx":650,"cy":300,"r":9,"fill":"#c2410c","explain":"Another shrinking dot: homing in on the limit."}},{"at_ms":6900,"do":"show","shape":{"id":"c4","kind":"circle","cx":725,"cy":300,"r":9,"fill":"#c2410c","explain":"Another shrinking dot: almost at the limit now."}},{"at_ms":7000,"do":"show","shape":{"id":"limit","kind":"circle","cx":800,"cy":300,"r":12,"stroke":"#1f7a3a","width":3,"explain":"The limit: the shrinking terms home in on it."}},{"at_ms":7300,"do":"show","shape":{"id":"shrinksLab","kind":"text","x":560,"y":220,"text":"shrinks to the limit","size":28,"explain":"The contrast: when |r| < 1 the terms shrink toward the limit."}},{"at_ms":7600,"do":"show","shape":{"id":"convEq","kind":"latex","x":150,"y":150,"size":44,"color":"#1f7a3a","tex":"|r| < 1","explain":"The convergence test: the terms settle only when |r| < 1."}}]},{"id":"s5","caption":"The sequences toolkit","narration":"The toolkit, assembled: the a and d chips drop into the arithmetic formula, then a and r into the geometric one. Two formulas, four moving parts.","duration_ms":8000,"steps":[{"at_ms":500,"do":"show","shape":{"id":"skA1","kind":"text","x":60,"y":200,"text":"u_n =","size":36,"explain":"The formula skeleton: u sub n equals ..."}},{"at_ms":500,"do":"show","shape":{"id":"slotA","kind":"rect","x":190,"y":168,"w":64,"h":60,"stroke":"#94a3b8","width":2,"explain":"The empty slot for a: the first term drops here."}},{"at_ms":500,"do":"show","shape":{"id":"skA2","kind":"text","x":280,"y":200,"text":"+","size":36,"explain":"The plus sign of the AP formula."}},{"at_ms":500,"do":"show","shape":{"id":"skA3","kind":"text","x":330,"y":200,"text":"(n-1)","size":36,"explain":"The n-1: you add d exactly n-1 times."}},{"at_ms":500,"do":"show","shape":{"id":"slotD","kind":"rect","x":440,"y":168,"w":64,"h":60,"stroke":"#94a3b8","width":2,"explain":"The empty slot for d: the common difference drops here."}},{"at_ms":500,"do":"show","shape":{"id":"chipA","kind":"circle","cx":120,"cy":430,"r":24,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The a chip: the first term, ready to drop in."}},{"at_ms":500,"do":"show","shape":{"id":"chipALab","kind":"text","x":111,"y":419,"text":"a","size":30,"explain":"The chip label: a, the first term."}},{"at_ms":500,"do":"show","shape":{"id":"chipD","kind":"circle","cx":260,"cy":430,"r":24,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The d chip: the common difference, ready to drop in."}},{"at_ms":500,"do":"show","shape":{"id":"chipDLab","kind":"text","x":251,"y":419,"text":"d","size":30,"explain":"The chip label: d, the common difference."}},{"at_ms":1500,"do":"move","target":"chipA","to":{"cx":222,"cy":198},"dur_ms":800},{"at_ms":1500,"do":"move","target":"chipALab","to":{"x":213,"y":187},"dur_ms":800},{"at_ms":2600,"do":"move","target":"chipD","to":{"cx":472,"cy":198},"dur_ms":800},{"at_ms":2600,"do":"move","target":"chipDLab","to":{"x":463,"y":187},"dur_ms":800},{"at_ms":3600,"do":"show","shape":{"id":"apFull","kind":"latex","x":60,"y":310,"size":36,"color":"#1f7a3a","tex":"u_n = a + (n - 1)d","explain":"The assembled AP formula: u_n = a + (n-1)d."}},{"at_ms":4200,"do":"show","shape":{"id":"skB1","kind":"text","x":520,"y":200,"text":"u_n =","size":36,"explain":"The geometric skeleton: u sub n equals ..."}},{"at_ms":4200,"do":"show","shape":{"id":"slotA2","kind":"rect","x":648,"y":168,"w":64,"h":60,"stroke":"#94a3b8","width":2,"explain":"The empty slot for a: the first term drops here."}},{"at_ms":4200,"do":"show","shape":{"id":"skB2","kind":"text","x":736,"y":200,"text":"×","size":36,"explain":"The times sign of the GP formula."}},{"at_ms":4200,"do":"show","shape":{"id":"slotR","kind":"rect","x":770,"y":168,"w":64,"h":60,"stroke":"#94a3b8","width":2,"explain":"The empty slot for r: the common ratio drops here."}},{"at_ms":4200,"do":"show","shape":{"id":"skB3","kind":"text","x":842,"y":200,"text":"^(n-1)","size":28,"explain":"The n-1 power: you multiply by r exactly n-1 times."}},{"at_ms":4200,"do":"show","shape":{"id":"chipA2","kind":"circle","cx":600,"cy":430,"r":24,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The a chip: the first term, for the geometric side."}},{"at_ms":4200,"do":"show","shape":{"id":"chipA2Lab","kind":"text","x":591,"y":419,"text":"a","size":30,"explain":"The chip label: a, the first term."}},{"at_ms":4200,"do":"show","shape":{"id":"chipR","kind":"circle","cx":740,"cy":430,"r":24,"fill":"#fef3c7","stroke":"#b45309","width":2,"explain":"The r chip: the common ratio, ready to drop in."}},{"at_ms":4200,"do":"show","shape":{"id":"chipRLab","kind":"text","x":731,"y":419,"text":"r","size":30,"explain":"The chip label: r, the common ratio."}},{"at_ms":4800,"do":"move","target":"chipA2","to":{"cx":680,"cy":198},"dur_ms":800},{"at_ms":4800,"do":"move","target":"chipA2Lab","to":{"x":671,"y":187},"dur_ms":800},{"at_ms":5700,"do":"move","target":"chipR","to":{"cx":802,"cy":198},"dur_ms":800},{"at_ms":5700,"do":"move","target":"chipRLab","to":{"x":793,"y":187},"dur_ms":800},{"at_ms":6700,"do":"show","shape":{"id":"gpFull","kind":"latex","x":540,"y":310,"size":36,"color":"#1f7a3a","tex":"u_n = a × r^(n-1)","explain":"The assembled GP formula: u_n = a times r to the (n-1)."}}]}]}