    {
      "id": "s5",
      "caption": "The +C trap: only for indefinite integrals",
      "narration": "Forgetting the constant of integration is a classic slip, but so is keeping it where it does not belong. The indefinite integral of x squared needs plus C. In a definite integral the constant cancels at the two limits, so from 1 to 2 the answer is simply 7 over 3.",
      "duration_ms": 9000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "mis",
            "kind": "text",
            "x": 120,
            "y": 120,
            "text": "Misconception:",
            "size": 36,
            "color": "#b00020"
          }
        },
        {
          "at_ms": 1200,
          "do": "show",
          "shape": {
            "id": "eq",
            "kind": "latex",
            "x": 120,
            "y": 200,
            "tex": "\\int x^{2} \\, dx = \\frac{x^{3}}{3} + C",
            "size": 36
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "id": "wrong",
            "kind": "latex",
            "x": 120,
            "y": 300,
            "tex": "\\int_{1}^{2} x^{2} \\, dx = \\frac{8}{3} + C",
            "size": 36,
            "color": "#b00020"
          }
        },
        {
          "at_ms": 4200,
          "do": "show",
          "shape": {
            "id": "fix",
            "kind": "latex",
            "x": 120,
            "y": 400,
            "tex": "\\int_{1}^{2} x^{2} \\, dx = \\frac{8}{3} - \\frac{1}{3} = \\frac{7}{3}",
            "size": 36,
            "color": "#1f7a3a"
          }
        },
        {
          "at_ms": 5800,
          "do": "show",
          "shape": {
            "id": "note",
            "kind": "text",
            "x": 120,
            "y": 480,
            "text": "the limits kill C — it cancels at both ends",
            "size": 26
          }
        },
        {
          "at_ms": 6800,
          "do": "emphasize",
          "target": "fix",
          "dur_ms": 900
        },
        {
          "at_ms": 7600,
          "do": "caption",
          "text": "no +C once the limits are in"
        }
      ]
