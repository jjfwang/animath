{"animath":"0.1","canvas":{"width":960,"height":540},"kind":"concept","level":"jc","subject":"math","topic":"h2-integration","title":"JC H2 integration: Riemann sums, u-substitution, volumes of revolution","scenes":[{"id":"s1","caption":"Riemann sums: slicing area under a curve","narration":"The integral of x squared from 0 to 2 is the exact area under its curve. Four wide rectangles estimate 3.75; eight narrow ones tighten it to 3.1875, closing in on the true 8 over 3.","duration_ms":10000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"xAxis","kind":"line","stroke":"#1a1a1a","width":2,"x1":80,"y1":450,"x2":880,"y2":450,"explain":"The x-axis under the curve."}},{"at_ms":800,"do":"show","shape":{"id":"curve","kind":"polygon","stroke":"#1a56db","width":3,"fill":"#dbeafe","points":[[140.0,450.0],[206.0,446.4],[272.0,435.6],[338.0,417.6],[404.0,392.4],[470.0,360.0],[536.0,320.4],[602.0,273.6],[668.0,219.6],[734.0,158.4],[800.0,90.0],[800,450],[140,450]],"explain":"The curve y = x squared from 0 to 2, with the exact area under it shaded."}},{"at_ms":1400,"do":"show","shape":{"id":"strip1","kind":"rect","x":140,"y":442,"w":165,"h":8,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One wide Riemann strip (n = 4)."}},{"at_ms":1800,"do":"move","target":"strip1","to":{"x":140,"y":427.5,"w":165,"h":22.5},"dur_ms":700},{"at_ms":2200,"do":"show","shape":{"id":"strip2","kind":"rect","x":305,"y":442,"w":165,"h":8,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One wide Riemann strip (n = 4)."}},{"at_ms":2600,"do":"move","target":"strip2","to":{"x":305,"y":360.0,"w":165,"h":90.0},"dur_ms":700},{"at_ms":3000,"do":"show","shape":{"id":"strip3","kind":"rect","x":470,"y":442,"w":165,"h":8,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One wide Riemann strip (n = 4)."}},{"at_ms":3400,"do":"move","target":"strip3","to":{"x":470,"y":247.5,"w":165,"h":202.5},"dur_ms":700},{"at_ms":3800,"do":"show","shape":{"id":"strip4","kind":"rect","x":635,"y":442,"w":165,"h":8,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One wide Riemann strip (n = 4)."}},{"at_ms":4200,"do":"move","target":"strip4","to":{"x":635,"y":90.0,"w":165,"h":360.0},"dur_ms":700},{"at_ms":5000,"do":"show","shape":{"id":"n4lab","kind":"text","x":700,"y":80,"text":"n=4: estimate 3.75","size":26,"align":"middle","color":"#1f7a3a","explain":"The coarse estimate label: n = 4 gives 3.75."}},{"at_ms":5400,"do":"show","shape":{"id":"probe","kind":"circle","cx":140,"cy":450,"r":7,"fill":"#b45309","explain":"A probe dot travelling along the curve, marking the height each strip must reach."}},{"at_ms":5600,"do":"move","target":"probe","to":{"cx":305,"cy":427.5},"dur_ms":600},{"at_ms":6300,"do":"move","target":"probe","to":{"cx":470,"cy":360},"dur_ms":600},{"at_ms":7000,"do":"move","target":"probe","to":{"cx":635,"cy":247.5},"dur_ms":600},{"at_ms":7700,"do":"move","target":"probe","to":{"cx":800,"cy":90},"dur_ms":600},{"at_ms":8500,"do":"hide","target":"probe"},{"at_ms":8550,"do":"hide","target":"n4lab"},{"at_ms":8600,"do":"hide","target":"strip1"},{"at_ms":8700,"do":"hide","target":"strip2"},{"at_ms":8800,"do":"hide","target":"strip3"},{"at_ms":8800,"do":"show","shape":{"id":"nstrip1","kind":"rect","x":140.0,"y":444.4,"w":82.5,"h":5.6,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":8900,"do":"hide","target":"strip4"},{"at_ms":8910,"do":"show","shape":{"id":"nstrip2","kind":"rect","x":222.5,"y":427.5,"w":82.5,"h":22.5,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9020,"do":"show","shape":{"id":"nstrip3","kind":"rect","x":305.0,"y":399.4,"w":82.5,"h":50.6,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9130,"do":"show","shape":{"id":"nstrip4","kind":"rect","x":387.5,"y":360.0,"w":82.5,"h":90.0,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9240,"do":"show","shape":{"id":"nstrip5","kind":"rect","x":470.0,"y":309.4,"w":82.5,"h":140.6,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9350,"do":"show","shape":{"id":"nstrip6","kind":"rect","x":552.5,"y":247.5,"w":82.5,"h":202.5,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9460,"do":"show","shape":{"id":"nstrip7","kind":"rect","x":635.0,"y":174.4,"w":82.5,"h":275.6,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9570,"do":"show","shape":{"id":"nstrip8","kind":"rect","x":717.5,"y":90.0,"w":82.5,"h":360.0,"fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"explain":"One of the 8 finer strips (n = 8)."}},{"at_ms":9700,"do":"caption","text":"n=8: 3.1875 — closer to 8/3 ≈ 2.667"}]},{"id":"s2","caption":"Signed area: below the axis counts negative","narration":"Area below the x-axis counts as negative. The triangle above gives 2, the one below gives minus a half, so the net signed area is 1.5 — exactly the integral of x from minus 1 to 2.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"xAxis","kind":"line","stroke":"#1a1a1a","width":2,"x1":120,"y1":320,"x2":840,"y2":320,"explain":"The x-axis: area below it counts as negative in a definite integral."}},{"at_ms":700,"do":"show","shape":{"id":"lineL","kind":"line","stroke":"#1a56db","width":3,"x1":200,"y1":467,"x2":640,"y2":27,"explain":"The line y = x, which dips below the x-axis on the left and rises above it on the right."}},{"at_ms":1400,"do":"show","shape":{"id":"triPos","kind":"polygon","fill":"#cfe8d4","stroke":"#1f7a3a","width":2,"points":[[347,320],[640,27],[640,320]],"explain":"The triangle above the axis: positive area."}},{"at_ms":2200,"do":"show","shape":{"id":"triNeg","kind":"polygon","fill":"#f9d4d4","stroke":"#b91c1c","width":2,"points":[[200,467],[347,320],[200,320]],"explain":"The triangle below the axis, filled in red: area down here counts as negative."}},{"at_ms":3000,"do":"show","shape":{"id":"negLab","kind":"text","x":249,"y":372,"text":"−0.5","size":28,"align":"middle","color":"#b91c1c","explain":"The below-axis triangle: signed area -0.5."}},{"at_ms":3400,"do":"show","shape":{"id":"posLab","kind":"text","x":542,"y":273,"text":"2","size":28,"align":"middle","color":"#1f7a3a","explain":"The above-axis triangle: signed area 2."}},{"at_ms":3800,"do":"show","shape":{"id":"chipA","kind":"text","x":542,"y":505,"text":"+2","size":30,"align":"middle","color":"#1f7a3a","explain":"The net result chip: +2."}},{"at_ms":4400,"do":"move","target":"chipA","to":{"x":380,"y":505},"dur_ms":800},{"at_ms":5400,"do":"hide","target":"chipA"},{"at_ms":5600,"do":"show","shape":{"id":"chipB","kind":"text","x":380,"y":505,"text":"2 − 0.5 = 1.5","size":30,"align":"middle","color":"#1a1a1a","explain":"The running total: the red triangle below the axis subtracts from the green one above."}},{"at_ms":6400,"do":"emphasize","target":"chipB","dur_ms":900},{"at_ms":7200,"do":"caption","text":"net = 2 − 0.5 = 1.5, so ∫₋₁² x dx = 3/2"}]},{"id":"s3","caption":"u-substitution: the chain rule in reverse","narration":"The integral of 2x times e to the x squared hides a chain rule. Setting u to x squared turns 2x dx into du, so the integral becomes e to the u — just e minus 1.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"orig","kind":"latex","x":381,"y":90,"tex":"\\int_{0}^{1} 2x e^{x^{2}} \\, dx","size":32,"explain":"The original integral: integral from 0 to 1 of 2x e^(x^2) dx."}},{"at_ms":1200,"do":"show","shape":{"id":"uEq","kind":"text","x":480,"y":190,"text":"u = x²","size":26,"align":"middle","color":"#6b7280","explain":"The substitution: u = x squared."}},{"at_ms":2000,"do":"show","shape":{"id":"duEq","kind":"text","x":480,"y":240,"text":"du = 2x dx","size":26,"align":"middle","color":"#6b7280","explain":"Its differential: du = 2x dx."}},{"at_ms":2800,"do":"show","shape":{"id":"slotA","kind":"rect","x":330,"y":300,"w":90,"h":90,"fill":"none","stroke":"#b45309","width":2,"dash":"8 6","explain":"A slot: drop the u-part here."}},{"at_ms":3200,"do":"show","shape":{"id":"uchip","kind":"circle","cx":375,"cy":345,"r":18,"fill":"#fde68a","stroke":"#b45309","width":2,"explain":"The u chip: it stands in for the inner function x squared, ready to take its place."}},{"at_ms":3300,"do":"show","shape":{"id":"uchipT","kind":"text","x":375,"y":345,"text":"u","size":26,"align":"middle","color":"#92400e","explain":"The u chip: the new variable."}},{"at_ms":4000,"do":"show","shape":{"id":"slotB","kind":"rect","x":540,"y":300,"w":90,"h":90,"fill":"none","stroke":"#b45309","width":2,"dash":"8 6","explain":"The second slot."}},{"at_ms":4400,"do":"move","target":"uchip","to":{"cx":585,"cy":345},"dur_ms":700},{"at_ms":4400,"do":"move","target":"uchipT","to":{"x":585,"y":345},"dur_ms":700},{"at_ms":5600,"do":"show","shape":{"id":"mapArrow","kind":"arrow","x1":430,"y1":420,"x2":470,"y2":420,"stroke":"#b45309","width":3,"explain":"The mapping arrow: old variable to new."}},{"at_ms":5800,"do":"move","target":"mapArrow","to":{"x1":430,"y1":420,"x2":540,"y2":420},"dur_ms":600},{"at_ms":6600,"do":"hide","target":"orig"},{"at_ms":6800,"do":"show","shape":{"id":"subst","kind":"latex","x":345,"y":90,"tex":"\\int_{0}^{1} e^{u} \\, du = e - 1","size":32,"explain":"After substitution: integral of e^u du = e - 1."}},{"at_ms":7400,"do":"emphasize","target":"subst","dur_ms":900},{"at_ms":8000,"do":"caption","text":"u = x² turns the chain rule around — then integrate eᵘ"}]},{"id":"s4","caption":"Volumes of revolution: stacking discs","narration":"Rotate y equals x squared about the x-axis and it sweeps out a trumpet. Slice it into discs of radius x squared and thickness dx — stack them and integrate to get pi over 5.","duration_ms":11000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"xAxis","kind":"line","stroke":"#1a1a1a","width":2,"x1":80,"y1":400,"x2":900,"y2":400,"explain":"The x-axis: the solid is built by rotating the curve around it."}},{"at_ms":700,"do":"show","shape":{"id":"solid","kind":"polygon","stroke":"#1a56db","width":3,"fill":"#dbeafe","points":[[120.0,400.0],[192.0,397.8],[264.0,391.2],[336.0,380.2],[408.0,364.8],[480.0,345.0],[552.0,320.8],[624.0,292.2],[696.0,259.2],[768.0,221.8],[840.0,180.0],[840,400],[120,400]],"explain":"The solid of revolution: y = x squared swept around the x-axis from 0 to 1."}},{"at_ms":1400,"do":"show","shape":{"id":"disc1","kind":"circle","cx":300,"cy":480,"r":9,"fill":"#fde68a","stroke":"#b45309","width":2,"explain":"The first (smallest) disc of the volume stack."}},{"at_ms":1800,"do":"move","target":"disc1","to":{"cx":300,"cy":400},"dur_ms":700},{"at_ms":2800,"do":"show","shape":{"id":"disc2","kind":"circle","cx":480,"cy":480,"r":38,"fill":"#fde68a","stroke":"#b45309","width":2,"explain":"The second disc of the volume stack."}},{"at_ms":3200,"do":"move","target":"disc2","to":{"cx":480,"cy":400},"dur_ms":700},{"at_ms":4200,"do":"show","shape":{"id":"disc3","kind":"circle","cx":660,"cy":450,"r":84,"fill":"#fde68a","stroke":"#b45309","width":2,"explain":"The third disc of the volume stack."}},{"at_ms":4600,"do":"move","target":"disc3","to":{"cx":660,"cy":400},"dur_ms":700},{"at_ms":5600,"do":"show","shape":{"id":"disc4","kind":"circle","cx":800,"cy":400,"r":135,"fill":"#fde68a","stroke":"#b45309","width":2,"explain":"The fourth (largest) disc of the volume stack."}},{"at_ms":6000,"do":"move","target":"disc4","to":{"cx":800,"cy":340},"dur_ms":700},{"at_ms":6400,"do":"show","shape":{"id":"probe","kind":"circle","cx":120,"cy":400,"r":6,"fill":"#b45309","explain":"The probe dot: it marks a sample point on the axis where a disc is sliced."}},{"at_ms":6800,"do":"move","target":"probe","to":{"cx":300,"cy":386},"dur_ms":500},{"at_ms":6900,"do":"show","shape":{"id":"radiusArrow","kind":"arrow","x1":300,"y1":400,"x2":300,"y2":386,"stroke":"#b91c1c","width":3,"explain":"The radius arrow: at each x it stretches from the axis to the curve, so the disc there has radius x squared."}},{"at_ms":6950,"do":"move","target":"radiusArrow","to":{"x1":300,"y1":400,"x2":300,"y2":386},"dur_ms":500},{"at_ms":7400,"do":"move","target":"probe","to":{"cx":480,"cy":345},"dur_ms":500},{"at_ms":7550,"do":"move","target":"radiusArrow","to":{"x1":480,"y1":400,"x2":480,"y2":345},"dur_ms":500},{"at_ms":8000,"do":"move","target":"probe","to":{"cx":660,"cy":276},"dur_ms":500},{"at_ms":8150,"do":"move","target":"radiusArrow","to":{"x1":660,"y1":400,"x2":660,"y2":276},"dur_ms":500},{"at_ms":8600,"do":"move","target":"probe","to":{"cx":840,"cy":180},"dur_ms":500},{"at_ms":8750,"do":"move","target":"radiusArrow","to":{"x1":840,"y1":400,"x2":840,"y2":180},"dur_ms":500},{"at_ms":9400,"do":"show","shape":{"id":"volEq","kind":"latex","x":317,"y":70,"tex":"V = \\pi \\int_{0}^{1} (x^{2})^{2} \\, dx = \\frac{\\pi}{5}","size":30,"explain":"The volume integral: V = pi times the integral of (x^2)^2 dx = pi/5."}},{"at_ms":10000,"do":"emphasize","target":"volEq","dur_ms":900},{"at_ms":10500,"do":"caption","text":"each disc: πr²·dx — stack them, then integrate"}]},{"id":"s5","caption":"The +C trap: only for indefinite integrals","narration":"Only indefinite integrals need +C: it cancels at the two limits, so from 1 to 2 the answer is simply 7/3.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"divider","kind":"line","stroke":"#9ca3af","width":2,"dash":"8 6","x1":480,"y1":60,"x2":480,"y2":420,"explain":"The divider: indefinite vs definite, side by side."}},{"at_ms":600,"do":"show","shape":{"id":"indef","kind":"latex","x":163,"y":110,"tex":"\\int x^{2} \\, dx = \\frac{x^{3}}{3}","size":30,"explain":"The indefinite integral: x^2 integrates to x^3/3 (+C needed)."}},{"at_ms":1200,"do":"show","shape":{"id":"defn","kind":"latex","x":562,"y":110,"tex":"\\int_{1}^{2} x^{2} \\, dx = \\left[\\frac{x^{3}}{3}\\right]_{1}^{2}","size":30,"explain":"The definite integral: the antiderivative evaluated from 1 to 2."}},{"at_ms":2000,"do":"show","shape":{"id":"cChip1","kind":"text","x":260,"y":260,"text":"+C","size":32,"align":"middle","color":"#b45309","explain":"The +C chip: the constant of integration, which belongs on the indefinite side."}},{"at_ms":2600,"do":"move","target":"cChip1","to":{"x":415,"y":110},"dur_ms":700},{"at_ms":3400,"do":"show","shape":{"id":"cChip2","kind":"text","x":700,"y":260,"text":"+C","size":32,"align":"middle","color":"#b45309","explain":"The +C chip: it belongs on the left, not the right."}},{"at_ms":3800,"do":"move","target":"cChip2","to":{"x":845,"y":110},"dur_ms":700},{"at_ms":4700,"do":"hide","target":"cChip2"},{"at_ms":5000,"do":"show","shape":{"id":"lim1","kind":"text","x":620,"y":260,"text":"8/3","size":30,"align":"middle","color":"#1a56db","explain":"The upper-limit value: 8/3."}},{"at_ms":5300,"do":"show","shape":{"id":"lim2","kind":"text","x":780,"y":260,"text":"1/3","size":30,"align":"middle","color":"#1a56db","explain":"The lower-limit value: 1/3."}},{"at_ms":5600,"do":"move","target":"lim1","to":{"x":620,"y":170},"dur_ms":600},{"at_ms":5900,"do":"move","target":"lim2","to":{"x":780,"y":170},"dur_ms":600},{"at_ms":6700,"do":"show","shape":{"id":"val","kind":"text","x":700,"y":200,"text":"7/3","size":36,"align":"middle","color":"#1f7a3a","explain":"The definite integral's value: the +C cancels at the two limits, leaving just 7/3."}},{"at_ms":7300,"do":"emphasize","target":"val","dur_ms":900},{"at_ms":7900,"do":"caption","text":"no +C once the limits are in"}]}]}