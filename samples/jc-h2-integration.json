    {
      "id": "s3",
      "caption": "u-substitution: the chain rule in reverse",
      "narration": "The integral of 2x times e to the x squared from 0 to 1 hides a chain rule. Setting u to x squared turns 2x dx into du, and the limits stay 0 to 1. The integral becomes e to the u from 0 to 1, which is e minus 1.",
      "duration_ms": 9000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "eq",
            "kind": "latex",
            "x": 120,
            "y": 150,
            "tex": "\\int_{0}^{1} 2x e^{x^{2}} \\, dx",
            "size": 40
          }
        },
        {
          "at_ms": 1800,
          "do": "show",
          "shape": {
            "id": "sub",
            "kind": "latex",
            "x": 120,
            "y": 250,
            "tex": "u = x^{2}, \\quad du = 2x \\, dx",
            "size": 36
          }
        },
        {
          "at_ms": 3600,
          "do": "show",
          "shape": {
            "id": "lim",
            "kind": "text",
            "x": 120,
            "y": 330,
            "text": "x: 0 → 1   becomes   u: 0 → 1",
            "size": 28
          }
        },
        {
          "at_ms": 5200,
          "do": "show",
          "shape": {
            "id": "ans",
            "kind": "latex",
            "x": 120,
            "y": 420,
            "tex": "\\int_{0}^{1} e^{u} \\, du = e - 1",
            "size": 40
          }
        },
        {
          "at_ms": 6600,
          "do": "emphasize",
          "target": "ans",
          "dur_ms": 900
        },
        {
          "at_ms": 7400,
          "do": "caption",
          "text": "u = x² turns the chain rule around — then integrate eᵘ"
        }
      ]
    },
