[712.0,199.2]]},"dur_ms":1000},{"at_ms":6800,"do":"show","shape":{"id":"verdict","kind":"text","text":"producers: make food for almost all life","x":180,"y":470,"size":30,"explain":"producers: plants make food for almost all life on Earth."}}]},{"id":"s5","caption":"Misconception: oxygen does NOT come from CO2","duration_ms":8000,"narration":"A common mistake: thinking the oxygen plants release comes from carbon dioxide. The oxygen actually comes from water - split water releases it, while carbon dioxide supplies the carbon for glucose.","steps":[{"at_ms":0,"do":"show","shape":{"id":"leaf","kind":"circle","cx":480,"cy":280,"r":80,"fill":"#bfe6b0","stroke":"#2e7d32","strokeWidth":4,"explain":"The leaf: where photosynthesis happens."}},{"at_ms":0,"do":"show","shape":{"id":"co2in","kind":"arrow","x1":700,"y1":140,"x2":566,"y2":216,"stroke":"#5b7fa6","width":4,"explain":"Carbon dioxide in: it enters the leaf."}},{"at_ms":0,"do":"show","shape":{"id":"co2t","kind":"text","text":"carbon dioxide","x":648,"y":118,"size":24,"explain":"carbon dioxide: it enters through tiny pores under the leaf."}},{"at_ms":0,"do":"show","shape":{"id":"h2oin","kind":"arrow","x1":700,"y1":440,"x2":566,"y2":344,"stroke":"#3f88c5","width":4,"explain":"Water in: it travels up from the roots."}},{"at_ms":0,"do":"show","shape":{"id":"h2ot","kind":"text","text":"water","x":648,"y":472,"size":24,"explain":"water: it travels up from the roots."}},{"at_ms":0,"do":"show","shape":{"id":"o2b","kind":"circle","cx":810,"cy":280,"r":24,"fill":"#e3f0fa","stroke":"#3f88c5","strokeWidth":3,"explain":"An oxygen molecule: released as a by-product."}},{"at_ms":0,"do":"show","shape":{"id":"o2t","kind":"text","text":"oxygen","x":842,"y":272,"size":24,"explain":"oxygen: released by the leaf into the air."}},{"at_ms":800,"do":"show","shape":{"id":"myth","kind":"text","text":"myth: oxygen comes from carbon dioxide","x":120,"y":80,"size":24,"fill":"#c62828","explain":"myth: oxygen comes from carbon dioxide - the common mistake."}},{"at_ms":1400,"do":"show","shape":{"id":"wrongArr","kind":"arrow","x1":640,"y1":170,"x2":800,"y2":282,"stroke":"#c62828","width":5,"explain":"The wrong arrow: oxygen does not come from CO2."}},{"at_ms":3000,"do":"hide","target":"wrongArr"},{"at_ms":3000,"do":"hide","target":"myth"},{"at_ms":3600,"do":"show","shape":{"id":"rightArr","kind":"arrow","x1":640,"y1":400,"x2":800,"y2":282,"stroke":"#2e7d32","width":5,"explain":"The right arrow: the oxygen comes from water."}},{"at_ms":4600,"do":"show","shape":{"id":"fix","kind":"text","text":"oxygen comes from water","x":120,"y":480,"size":24,"fill":"#2e7d32","explain":"oxygen comes from water: splitting water releases it, while CO2 supplies the carbon for glucose."}},{"at_ms":6800,"do":"emphasize","target":"rightArr"}]}]}