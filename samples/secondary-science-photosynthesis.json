appens."}},{"at_ms":2500,"do":"show","shape":{"id":"leafL","kind":"text","text":"leaf","x":610,"y":312,"size":30,"explain":"leaf: the plant's food factory."}},{"at_ms":4400,"do":"show","shape":{"id":"lightL","kind":"text","text":"light energy","x":370,"y":175,"size":26,"explain":"light energy: the input that powers photosynthesis."}}]},{"id":"s2","caption":"In: carbon dioxide and water","duration_ms":8000,"narration":"Carbon dioxide enters through tiny pores under the leaf. Water travels up from the roots.","steps":[{"at_ms":0,"do":"show","shape":{"id":"leaf","kind":"circle","cx":480,"cy":290,"r":90,"fill":"#bfe6b0","stroke":"#2e7d32","strokeWidth":4,"explain":"The leaf: where photosynthesis happens."}},{"at_ms":500,"do":"show","shape":{"id":"co2g","kind":"arrow","x1":700,"y1":160,"x2":556,"y2":236,"stroke":"#5b7fa6","width":4,"explain":"Carbon dioxide entering: it flows into the leaf."}},{"at_ms":1000,"do":"show","shape":{"id":"co1","kind":"circle","cx":700,"cy":160,"r":11,"fill":"#9db8d4","stroke":"#5b7fa6","strokeWidth":2,"explain":"A carbon dioxide molecule."}},{"at_ms":1100,"do":"move","target":"co1","to":{"cx":540,"cy":270},"dur_ms":1500},{"at_ms":1400,"do":"show","shape":{"id":"co2","kind":"circle","cx":700,"cy":160,"r":11,"fill":"#9db8d4","stroke":"#5b7fa6","strokeWidth":2,"explain":"A carbon dioxide molecule."}},{"at_ms":1500,"do":"move","target":"co2","to":{"cx":540,"cy":270},"dur_ms":1500},{"at_ms":1800,"do":"show","shape":{"id":"co3","kind":"circle","cx":700,"cy":160,"r":11,"fill":"#9db8d4","stroke":"#5b7fa6","strokeWidth":2,"explain":"A carbon dioxide molecule."}},{"at_ms":1900,"do":"move","target":"co3","to":{"cx":540,"cy":270},"dur_ms":1500},{"at_ms":2600,"do":"show","shape":{"id":"co2t","kind":"text","text":"carbon dioxide","x":640,"y":140,"size":26,"explain":"carbon dioxide: it enters through tiny pores under the leaf."}},{"at_ms":2800,"do":"show","shape":{"id":"h2og","kind":"arrow","x1":700,"y1":440,"x2":556,"y2":352,"stroke":"#3f88c5","width":4,"e