plain":"The month axis of the line graph."}},{"at_ms":500,"do":"show","shape":{"id":"m1","kind":"text","size":22,"text":"Jan","x":122,"y":478,"explain":"Month label: Jan."}},{"at_ms":600,"do":"show","shape":{"id":"m2","kind":"text","size":22,"text":"Feb","x":242,"y":478,"explain":"Month label: Feb."}},{"at_ms":700,"do":"show","shape":{"id":"m3","kind":"text","size":22,"text":"Mar","x":362,"y":478,"explain":"Month label: Mar."}},{"at_ms":800,"do":"show","shape":{"id":"m4","kind":"text","size":22,"text":"Apr","x":482,"y":478,"explain":"Month label: Apr."}},{"at_ms":1000,"do":"show","shape":{"id":"seg1","kind":"line","stroke":"#1a56db","width":4,"x1":140,"x2":140,"y1":420,"y2":420,"explain":"Line stub: the graph starts at the January point."}},{"at_ms":1100,"do":"show","shape":{"cx":140,"cy":420,"fill":"#1a56db","id":"d","kind":"circle","r":8,"stroke":"#1a1a1a","strokeWidth":2,"explain":"The probe dot: it travels month to month, drawing the line."}},{"at_ms":1300,"do":"move","dur_ms":900,"target":"seg1","to":{"x1":140,"x2":260,"y1":420,"y2":350}},{"at_ms":1300,"do":"move","dur_ms":900,"target":"d","to":{"cx":260,"cy":350}},{"at_ms":2300,"do":"show","shape":{"id":"seg2","kind":"line","stroke":"#1a56db","width":4,"x1":260,"x2":260,"y1":350,"y2":350,"explain":"Line stub: the February point, higher than January."}},{"at_ms":2600,"do":"move","dur_ms":900,"target":"seg2","to":{"x1":260,"x2":380,"y1":350,"y2":375}},{"at_ms":2600,"do":"move","dur_ms":900,"target":"d","to":{"cx":380,"cy":375}},{"at_ms":3600,"do":"show","shape":{"id":"seg3","kind":"line","stroke":"#1a56db","width":4,"x1":380,"x2":380,"y1":375,"y2":375,"explain":"Line stub: the March point -- the dip."}},{"at_ms":3900,"do":"move","dur_ms":900,"target":"seg3","to":{"x1":380,"x2":500,"y1":375,"y2":280}},{"at_ms":3900,"do":"move","dur_ms":900,"target":"d","to":{"cx":500,"cy":280}},{"at_ms":5000,"do":"show","shape":{"id":"dip","kind":"text","size":28,"text":"small dip in March","x":560,"y":395,"explain":"Note: the sm