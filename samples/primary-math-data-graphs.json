"at_ms":2600,"do":"move","dur_ms":800,"target":"minton","to":{"h":80,"w":70,"x":280,"y":330}},{"at_ms":3600,"do":"show","shape":{"id":"labM","kind":"text","size":28,"text":"badminton: 8","x":280,"y":300,"explain":"Bar label: badminton, 8 votes."}},{"at_ms":3900,"do":"show","shape":{"fill":"#e8b47f","h":0,"id":"swim","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":70,"x":400,"y":410,"explain":"Swimming bar: grows to 3 votes."}},{"at_ms":4100,"do":"move","dur_ms":800,"target":"swim","to":{"h":30,"w":70,"x":400,"y":380}},{"at_ms":5100,"do":"show","shape":{"id":"labW","kind":"text","size":28,"text":"swimming: 3","x":400,"y":350,"explain":"Bar label: swimming, 3 votes."}},{"at_ms":5400,"do":"show","shape":{"cx":195,"cy":280,"fill":"#e8604c","id":"chip","kind":"circle","r":10,"stroke":"#1a1a1a","strokeWidth":2,"explain":"The comparison chip: it travels from the badminton top to the soccer top."}},{"at_ms":5700,"do":"move","dur_ms":900,"target":"chip","to":{"cx":315,"cy":330}},{"at_ms":6800,"do":"show","shape":{"id":"diff","kind":"text","size":34,"text":"13 − 8 = 5 more chose soccer","x":140,"y":480,"explain":"Answer: 13 minus 8 is 5 -- five more chose soccer."}},{"at_ms":7800,"do":"emphasize","dur_ms":1000,"target":"diff"},{"at_ms":9000,"do":"caption","text":"Read the heights, then subtract"}]},{"caption":"Watch out: a steeper line is not always bigger","duration_ms":9000,"id":"s4","narration":"A tricky mistake: saying a steeper line means a bigger increase. Both sales rose by 20 - watch graph B's axis compress and its line flatten to the truthful scale.","steps":[{"at_ms":0,"do":"show","shape":{"id":"q","kind":"text","size":38,"text":"Which sale rose faster?","x":120,"y":90,"explain":"Question: which sale rose faster?"}},{"at_ms":700,"do":"show","shape":{"id":"axA","kind":"line","stroke":"#1a1a1a","width":3,"x1":140,"x2":140,"y1":380,"y2":180,"explain":"Shop A sales axis: 0 to 50."}},{"at_ms":900,"do":"show","shape":{"id":"t0A","kind":"text","size":24,"text":"0","x"