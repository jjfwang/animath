300}},{"at_ms":4700,"do":"move","dur_ms":1200,"target":"t200B","to":{"x":475,"y":305}},{"at_ms":4700,"do":"move","dur_ms":1200,"target":"t100B","to":{"x":485,"y":340}},{"at_ms":4700,"do":"move","dur_ms":1200,"target":"g2","to":{"x1":560,"x2":760,"y1":380,"y2":300}},{"at_ms":6200,"do":"show","shape":{"color":"#8a1f1f","id":"warn","kind":"text","size":30,"text":"same rise: +20 each — B only looks flatter","x":120,"y":500,"explain":"The warning: the same rise of 20 -- B only looks flatter."}},{"at_ms":7400,"do":"emphasize","dur_ms":1200,"target":"warn"},{"at_ms":8600,"do":"caption","text":"Check the axis scale before comparing slopes"}]}],"subject":"math","title":"Data graphs: pie charts and line graphs","topic":"data-graphs"}