{"animath":"0.1","canvas":{"width":960,"height":540},"kind":"concept","level":"secondary","subject":"math","title":"A-Math integration: area, accumulation and the +C trap","topic":"a-integration","scenes":[{"id":"s1","duration_ms":9000,"caption":"The antiderivative is accumulated area","narration":"Integration undoes differentiation. Geometrically, the antiderivative is the area building up under the curve as x sweeps right.","steps":[{"at_ms":0,"do":"show","shape":{"id":"xax","kind":"line","x1":80,"y1":440,"x2":880,"y2":440,"stroke":"#1a1a1a","width":2,"explain":"The x-axis: the sweep moves right along it."}},{"at_ms":300,"do":"show","shape":{"id":"yax","kind":"line","x1":120,"y1":60,"x2":120,"y2":480,"stroke":"#1a1a1a","width":2,"explain":"The y-axis."}},{"at_ms":800,"do":"show","shape":{"id":"cur1","kind":"line","x1":160,"y1":404,"x2":300,"y2":348,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 1: the function being integrated."}},{"at_ms":1200,"do":"show","shape":{"id":"cur2","kind":"line","x1":300,"y1":348,"x2":440,"y2":272,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 2: the function being integrated."}},{"at_ms":1600,"do":"show","shape":{"id":"cur3","kind":"line","x1":440,"y1":272,"x2":580,"y2":176,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 3: the function being integrated."}},{"at_ms":2000,"do":"show","shape":{"id":"cur4","kind":"line","x1":580,"y1":176,"x2":720,"y2":64,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 4: the function being integrated."}},{"at_ms":2400,"do":"show","shape":{"id":"sweep","kind":"circle","cx":160,"cy":404,"r":9,"fill":"#d63c2f","explain":"The sweep dot: area piles up behind it as it travels right."}},{"at_ms":2600,"do":"move","target":"sweep","to":{"cx":300,"cy":348},"dur_ms":700},{"at_ms":3400,"do":"show","shape":{"id":"strip1","kind":"rect","x":160,"y":348,"w":140,"h":92,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Area strip 1: the accumulated area under the first curve section."}},{"at_ms":3500,"do":"move","target":"sweep","to":{"cx":440,"cy":272},"dur_ms":700},{"at_ms":4300,"do":"show","shape":{"id":"strip2","kind":"rect","x":300,"y":272,"w":140,"h":168,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Area strip 2: the accumulated area under the second curve section."}},{"at_ms":4400,"do":"move","target":"sweep","to":{"cx":580,"cy":176},"dur_ms":700},{"at_ms":5200,"do":"show","shape":{"id":"strip3","kind":"rect","x":440,"y":176,"w":140,"h":264,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Area strip 3: the accumulated area under the third curve section."}},{"at_ms":5300,"do":"move","target":"sweep","to":{"cx":720,"cy":64},"dur_ms":700},{"at_ms":6100,"do":"show","shape":{"id":"strip4","kind":"rect","x":580,"y":64,"w":140,"h":376,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Area strip 4: the accumulated area under the fourth curve section."}},{"at_ms":6800,"do":"show","shape":{"id":"runlab","kind":"text","x":120,"y":508,"text":"area accumulates as x sweeps right","size":28,"color":"#1a1a1a","explain":"Caption: area accumulates as x sweeps right."}},{"at_ms":7600,"do":"caption","text":"The antiderivative is accumulated area"}]},{"id":"s2","duration_ms":10000,"caption":"Riemann sum: thin rectangles converge on the area","narration":"Chop the region into rectangles and add them up. As the strips get thinner and more numerous, their total closes in on the exact shaded area — the definite integral.","steps":[{"at_ms":0,"do":"show","shape":{"id":"xax","kind":"line","x1":80,"y1":440,"x2":880,"y2":440,"stroke":"#1a1a1a","width":2,"explain":"The x-axis: the sweep moves right along it."}},{"at_ms":300,"do":"show","shape":{"id":"yax","kind":"line","x1":120,"y1":60,"x2":120,"y2":480,"stroke":"#1a1a1a","width":2,"explain":"The y-axis."}},{"at_ms":800,"do":"show","shape":{"id":"cu1","kind":"line","x1":160,"y1":400,"x2":320,"y2":320,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 1 of the region being measured."}},{"at_ms":1200,"do":"show","shape":{"id":"cu2","kind":"line","x1":320,"y1":320,"x2":480,"y2":220,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 2 of the region being measured."}},{"at_ms":1600,"do":"show","shape":{"id":"cu3","kind":"line","x1":480,"y1":220,"x2":640,"y2":120,"stroke":"#1f7a3a","width":4,"explain":"Curve segment 3 of the region being measured."}},{"at_ms":2200,"do":"show","shape":{"id":"r1","kind":"rect","x":160,"y":400,"w":120,"h":40,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Riemann rectangle 1: wide, a rough estimate."}},{"at_ms":2700,"do":"show","shape":{"id":"r2","kind":"rect","x":280,"y":340,"w":120,"h":100,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Riemann rectangle 2: wide, a rough estimate."}},{"at_ms":3200,"do":"show","shape":{"id":"r3","kind":"rect","x":400,"y":270,"w":120,"h":170,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Riemann rectangle 3: wide, a rough estimate."}},{"at_ms":3700,"do":"show","shape":{"id":"r4","kind":"rect","x":520,"y":195,"w":120,"h":245,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Riemann rectangle 4: wide, a rough estimate."}},{"at_ms":4200,"do":"show","shape":{"id":"rough","kind":"text","x":120,"y":508,"text":"4 wide rectangles: a rough total","size":28,"color":"#1a1a1a","explain":"Caption: 4 wide rectangles give a rough total."}},{"at_ms":4800,"do":"move","target":"r1","to":{"x":160,"w":60},"dur_ms":600},{"at_ms":5000,"do":"move","target":"r2","to":{"x":280,"w":60},"dur_ms":600},{"at_ms":5200,"do":"move","target":"r3","to":{"x":400,"w":60},"dur_ms":600},{"at_ms":5300,"do":"show","shape":{"id":"r1b","kind":"rect","x":220,"y":370,"w":60,"h":70,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Narrower rectangle 1: half the width, closer to the curve."}},{"at_ms":5400,"do":"move","target":"r4","to":{"x":520,"w":60},"dur_ms":600},{"at_ms":5500,"do":"show","shape":{"id":"r2b","kind":"rect","x":340,"y":308,"w":60,"h":132,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Narrower rectangle 2: half the width, closer to the curve."}},{"at_ms":5700,"do":"show","shape":{"id":"r3b","kind":"rect","x":460,"y":232,"w":60,"h":208,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Narrower rectangle 3: half the width, closer to the curve."}},{"at_ms":5900,"do":"show","shape":{"id":"r4b","kind":"rect","x":580,"y":158,"w":60,"h":282,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"Narrower rectangle 4: half the width, closer to the curve."}},{"at_ms":6300,"do":"hide","target":"rough"},{"at_ms":6400,"do":"show","shape":{"id":"finer","kind":"text","x":120,"y":508,"text":"8 narrower rectangles: closer","size":28,"color":"#1a1a1a","explain":"Caption: 8 narrower rectangles get closer."}},{"at_ms":7000,"do":"hide","target":"r1"},{"at_ms":7000,"do":"hide","target":"r2"},{"at_ms":7000,"do":"hide","target":"r3"},{"at_ms":7000,"do":"hide","target":"r4"},{"at_ms":7000,"do":"hide","target":"r1b"},{"at_ms":7000,"do":"hide","target":"r2b"},{"at_ms":7000,"do":"hide","target":"r3b"},{"at_ms":7000,"do":"hide","target":"r4b"},{"at_ms":7000,"do":"hide","target":"finer"},{"at_ms":7200,"do":"show","shape":{"id":"trueArea","kind":"polygon","points":[[160,440],[160,400],[240,360],[320,320],[400,270],[480,220],[560,170],[640,120],[640,440]],"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":2,"explain":"The exact region: the limit of the rectangle sums."}},{"at_ms":7800,"do":"show","shape":{"id":"exact","kind":"text","x":120,"y":508,"text":"the limit: the exact shaded area","size":28,"color":"#1a1a1a","explain":"Caption: the limit -- the exact shaded area."}},{"at_ms":8400,"do":"show","shape":{"id":"int","kind":"latex","x":680,"y":120,"tex":"\\int_a^b f(x)\\,dx","size":36,"explain":"The definite integral from a to b of f of x dx: the exact area."}},{"at_ms":9000,"do":"caption","text":"Riemann sum: thin rectangles converge on the area"}]},{"id":"s3","duration_ms":8000,"caption":"Worked: evaluating a definite integral","narration":"Integrate 2x from 1 to 2: antidifferentiate to x squared, evaluate at each bound, subtract. Four minus one is three square units.","steps":[{"at_ms":0,"do":"show","shape":{"id":"xax","kind":"line","x1":80,"y1":440,"x2":880,"y2":440,"stroke":"#1a1a1a","width":2,"explain":"The horizontal axis; x values are read along it from left to right."}},{"at_ms":300,"do":"show","shape":{"id":"yax","kind":"line","x1":120,"y1":60,"x2":120,"y2":480,"stroke":"#1a1a1a","width":2,"explain":"The vertical axis; it marks heights above the x-axis."}},{"at_ms":800,"do":"show","shape":{"id":"ln1","kind":"line","x1":200,"y1":320,"x2":400,"y2":200,"stroke":"#1f7a3a","width":4,"explain":"The left half of the curve y = 2x; area builds up under it."}},{"at_ms":1200,"do":"show","shape":{"id":"ln2","kind":"line","x1":400,"y1":200,"x2":600,"y2":80,"stroke":"#1f7a3a","width":4,"explain":"The right half of the curve y = 2x; area builds up under it."}},{"at_ms":1600,"do":"show","shape":{"id":"fun","kind":"text","x":612,"y":92,"text":"y = 2x","size":28,"color":"#1a1a1a","explain":"The function: y equals 2x."}},{"at_ms":2000,"do":"show","shape":{"id":"b1","kind":"line","x1":240,"y1":296,"x2":240,"y2":440,"stroke":"#6b7280","width":2,"explain":"The left bound x = 1; the area builds up between the bounds."}},{"at_ms":2400,"do":"show","shape":{"id":"b2","kind":"line","x1":560,"y1":104,"x2":560,"y2":440,"stroke":"#6b7280","width":2,"explain":"The right bound x = 2; the area builds up between the bounds."}},{"at_ms":2600,"do":"show","shape":{"id":"x1lab","kind":"text","x":222,"y":468,"text":"x = 1","size":24,"color":"#1a1a1a","explain":"Lower bound: x = 1."}},{"at_ms":2800,"do":"show","shape":{"id":"x2lab","kind":"text","x":542,"y":468,"text":"x = 2","size":24,"color":"#1a1a1a","explain":"Upper bound: x = 2."}},{"at_ms":3000,"do":"show","shape":{"id":"a1","kind":"rect","x":240,"y":432,"w":107,"h":8,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"This rectangle is the first slice of area building up between the bounds."}},{"at_ms":3300,"do":"move","target":"a1","to":{"y":296,"h":144},"dur_ms":600},{"at_ms":3700,"do":"show","shape":{"id":"a2","kind":"rect","x":347,"y":432,"w":107,"h":8,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"This rectangle is the second slice of area building up between the bounds."}},{"at_ms":4000,"do":"move","target":"a2","to":{"y":232,"h":208},"dur_ms":600},{"at_ms":4400,"do":"show","shape":{"id":"a3","kind":"rect","x":454,"y":432,"w":106,"h":8,"fill":"#d6ead9","stroke":"#1f7a3a","strokeWidth":1,"explain":"This rectangle is the third slice of area building up between the bounds."}},{"at_ms":4700,"do":"move","target":"a3","to":{"y":168,"h":272},"dur_ms":600},{"at_ms":5400,"do":"show","shape":{"id":"anti","kind":"latex","x":680,"y":200,"tex":"x^2","size":36,"explain":"Antiderivative: x squared."}},{"at_ms":5900,"do":"show","shape":{"id":"sub","kind":"latex","x":680,"y":268,"tex":"4-1=3","size":36,"explain":"Evaluate and subtract: 4 minus 1 is 3."}},{"at_ms":6400,"do":"show","shape":{"id":"ans","kind":"text","x":600,"y":330,"text":"area = 3 square units","size":30,"color":"#1a1a1a","explain":"Answer: the area is 3 square units."}},{"at_ms":7000,"do":"caption","text":"Worked: evaluating a definite integral"}]},{"id":"s4","duration_ms":8000,"caption":"Misconception: never drop the +C","narration":"Writing only x squared is the trap. Every vertical shift of the curve has the same slope, 2x — so the indefinite integral must keep plus C.","steps":[{"at_ms":0,"do":"show","shape":{"id":"xax","kind":"line","x1":80,"y1":440,"x2":880,"y2":440,"stroke":"#1a1a1a","width":2,"explain":"The x-axis: the sweep moves right along it."}},{"at_ms":300,"do":"show","shape":{"id":"yax","kind":"line","x1":120,"y1":60,"x2":120,"y2":480,"stroke":"#1a1a1a","width":2,"explain":"The y-axis."}},{"at_ms":800,"do":"show","shape":{"id":"c0a","kind":"line","x1":280,"y1":400,"x2":440,"y2":280,"stroke":"#1f7a3a","width":4,"explain":"Curve: y = x squared, the C = 0 member."}},{"at_ms":1100,"do":"show","shape":{"id":"c0b","kind":"line","x1":440,"y1":280,"x2":600,"y2":160,"stroke":"#1f7a3a","width":4,"explain":"Curve: y = x squared, the C = 0 member."}},{"at_ms":1400,"do":"show","shape":{"id":"c5a","kind":"line","x1":280,"y1":340,"x2":440,"y2":220,"stroke":"#2a7ab8","width":3,"explain":"Curve: y = x squared plus 5, shifted up."}},{"at_ms":1600,"do":"show","shape":{"id":"c5b","kind":"line","x1":440,"y1":220,"x2":600,"y2":100,"stroke":"#2a7ab8","width":3,"explain":"Curve: y = x squared plus 5, shifted up."}},{"at_ms":1900,"do":"show","shape":{"id":"cm3a","kind":"line","x1":280,"y1":440,"x2":440,"y2":320,"stroke":"#b87a2a","width":3,"explain":"Curve: y = x squared minus 3, shifted down."}},{"at_ms":2100,"do":"show","shape":{"id":"cm3b","kind":"line","x1":440,"y1":320,"x2":600,"y2":200,"stroke":"#b87a2a","width":3,"explain":"Curve: y = x squared minus 3, shifted down."}},{"at_ms":2300,"do":"show","shape":{"id":"c0lab","kind":"text","x":612,"y":172,"text":"C = 0","size":24,"color":"#1a1a1a","explain":"Label: C = 0."}},{"at_ms":2400,"do":"show","shape":{"id":"c5lab","kind":"text","x":612,"y":112,"text":"C = 5","size":24,"color":"#1a1a1a","explain":"Label: C = 5."}},{"at_ms":2500,"do":"show","shape":{"id":"cmlab","kind":"text","x":612,"y":212,"text":"C = −3","size":24,"color":"#1a1a1a","explain":"Label: C = minus 3."}},{"at_ms":2700,"do":"show","shape":{"id":"probe","kind":"circle","cx":440,"cy":280,"r":8,"fill":"#d63c2f","explain":"The probe: it checks the slope on each curve."}},{"at_ms":2900,"do":"show","shape":{"id":"sl1","kind":"text","x":460,"y":292,"text":"slope = 2x","size":24,"color":"#1a1a1a","explain":"Slope read-off: 2x on the C = 0 curve."}},{"at_ms":3300,"do":"move","target":"probe","to":{"cx":440,"cy":220},"dur_ms":600},{"at_ms":3600,"do":"show","shape":{"id":"sl2","kind":"text","x":460,"y":232,"text":"still 2x","size":24,"color":"#1a1a1a","explain":"Slope read-off: still 2x on a shifted curve."}},{"at_ms":4000,"do":"move","target":"probe","to":{"cx":440,"cy":320},"dur_ms":600},{"at_ms":4300,"do":"show","shape":{"id":"sl3","kind":"text","x":460,"y":332,"text":"still 2x","size":24,"color":"#1a1a1a","explain":"Slope read-off: still 2x on a shifted curve."}},{"at_ms":4700,"do":"show","shape":{"id":"trap","kind":"text","x":120,"y":505,"text":"Trap: x² alone is wrong","size":28,"color":"#1a1a1a","explain":"The trap: writing x squared alone, dropping the +C."}},{"at_ms":5300,"do":"show","shape":{"id":"fix","kind":"text","x":500,"y":505,"text":"every C works — keep +C","size":28,"color":"#1a1a1a","explain":"The fix: every C works -- keep the +C."}},{"at_ms":5800,"do":"caption","text":"Misconception: never drop the +C"}]}]}