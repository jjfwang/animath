    {
      "caption": "Worked: evaluating a definite integral",
      "duration_ms": 7500,
      "id": "s3",
      "narration": "Integrate 2x from 1 to 2. Antidifferentiate to get x squared, evaluate it at each bound, and subtract: 4 minus 1 is 3. The area is exactly 3 square units.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "q",
            "kind": "latex",
            "size": 48,
            "tex": "\\int_1^2 2x\\,dx",
            "x": 120,
            "y": 100
          }
        },
        {
          "at_ms": 1200,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "anti",
            "kind": "latex",
            "size": 44,
            "tex": "= \\left[x^2\\right]_1^2",
            "x": 140,
            "y": 190
          }
        },
        {
          "at_ms": 2500,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "eval",
            "kind": "latex",
            "size": 44,
            "tex": "= 2^2 - 1^2 = 4 - 1",
            "x": 140,
            "y": 280
          }
        },
        {
          "at_ms": 3800,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "ans",
            "kind": "latex",
            "size": 56,
            "tex": "= 3",
            "x": 140,
            "y": 380
          }
        },
        {
          "at_ms": 5200,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "rule",
            "kind": "text",
            "size": 26,
            "text": "antidifferentiate, evaluate at each bound, subtract",
            "x": 140,
            "y": 470
          }
        },
        {
          "at_ms": 6500,
          "do": "caption",
          "text": "Evaluate at the bounds — then subtract"
        }
      ]
    },
    {
      "caption": "Misconception: never drop the +C",
      "duration_ms": 8000,
      "id": "s4",
      "narration": "Integrating 2x and writing only x squared is wrong. Differentiate x squared plus 5 and you still get 2x; differentiate x squared plus 7 and you still get 2x. Every constant is a candidate, so the indefinite integral keeps plus C.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "q",
            "kind": "latex",
            "size": 48,
            "tex": "\\int 2x\\,dx = \\;?",
            "x": 120,
            "y": 110
          }
        },
        {
          "at_ms": 1200,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "trap",
            "kind": "text",
            "size": 30,
            "text": "Trap: writing down just x^2 and stopping",
            "x": 140,
            "y": 210
          }
        },
        {
          "at_ms": 2400,
          "do": "show",
          "shape": {
            "color": "#b00020",
            "id": "wrong",
            "kind": "latex",
            "size": 42,
            "tex": "x^2 \\qquad \\text{(missing } +C\\text{)}",
            "x": 140,
            "y": 300
          }
        },
        {
          "at_ms": 3600,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "ce",
            "kind": "latex",
            "size": 36,
            "tex": "\\frac{d}{dx}(x^2 + 5) = 2x, \\quad \\frac{d}{dx}(x^2 + 7) = 2x",
            "x": 120,
            "y": 390
          }
        },
        {
          "at_ms": 4900,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "fix",
            "kind": "latex",
            "size": 48,
            "tex": "\\int 2x\\,dx = x^2 + C",
            "x": 140,
            "y": 470
          }
        },
        {
          "at_ms": 5800,
          "do": "emphasize",
          "dur_ms": 900,
          "target": "wrong"
        },
        {
          "at_ms": 6900,
          "do": "caption",
          "text": "Any constant survives differentiation — the integral keeps +C"
        }
      ]
    }
