nergy content per gram","duration_ms":9000,"narration":"Carbohydrate and protein each release 17 kilojoules per gram. Fat releases far more — 37 kilojoules per gram.","steps":[{"at_ms":0,"do":"show","shape":{"id":"axis","explain":"The chart axis: energy content measured in kilojoules per gram.","kind":"line","x1":200,"y1":460,"x2":760,"y2":460,"stroke":"#5d4037","width":4}},{"at_ms":400,"do":"show","shape":{"id":"b0","explain":"The carbs bar: 17 kilojoules per gram.","kind":"rect","x":255,"y":446,"w":90,"h":14,"fill":"#66bb6a","stroke":"#37474f","strokeWidth":2}},{"at_ms":800,"do":"move","target":"b0","to":{"h":170,"y":290},"dur_ms":800},{"at_ms":800,"do":"show","shape":{"id":"bl0","explain":"Label: Carbs.","kind":"text","x":300,"y":492,"text":"carbs","size":20,"align":"middle"}},{"at_ms":1700,"do":"show","shape":{"id":"bv0","explain":"Label: 17 kJ per gram. The energy in one gram of carbohydrate.","kind":"text","x":300,"y":272,"text":"17 kJ/g","size":20,"align":"middle"}},{"at_ms":2200,"do":"show","shape":{"id":"b1","explain":"The protein bar: 17 kilojoules per gram, the same as carbohydrate.","kind":"rect","x":435,"y":446,"w":90,"h":14,"fill":"#42a5f5","stroke":"#37474f","strokeWidth":2}},{"at_ms":2600,"do":"move","target":"b1","to":{"h":170,"y":290},"dur_ms":800},{"at_ms":2600,"do":"show","shape":{"id":"bl1","explain":"Label: Protein.","kind":"text","x":480,"y":492,"text":"protein","size":20,"align":"middle"}},{"at_ms":3500,"do":"show","shape":{"id":"bv1","explain":"Label: 17 kJ per gram. The energy in one gram of protein.","kind":"text","x":480,"y":272,"text":"17 kJ/g","size":20,"align":"middle"}},{"at_ms":4000,"do":"show","shape":{"id":"b2","explain":"The fat bar: 37 kilojoules per gram, more than twice the others.","kind":"rect","x":615,"y":446,"w":90,"h":14,"fill":"#ef5350","stroke":"#37474f","strokeWidth":2}},{"at_ms":4400,"do":"move","target":"b2","to":{"h":340,"y":120},"dur_ms":800},{"at_ms":4400,"do":"show","shape":{"id":"bl2","explain":"Label: Fat.","kind":"text","x":660,"y":492,"text":"fat","size":20,"align":"middle"}},{"at_ms":5300,"do":"show","shape":{"id":"bv2","explain":"Label: 37 kJ per gram. The energy in one gram of fat.","kind":"text","x":660,"y":102,"text":"37 kJ/g","size":20,"align":"middle"}},{"at_ms":5600,"do":"show","shape":{"id":"fatnote","explain":"A note: fat has more energy per gram than carbohydrate or protein.","kind":"text","x":120,"y":524,"text":"fat has more energy per gram","size":24}}]},{"id":"s3","caption":"The digestion pipeline: mouth to large intestine","duration_ms":11000,"narration":"Food travels mouth, oesophagus, stomach, small intestine, then large intestine. Digestion is a long pipeline — not one chamber.","steps":[{"at_ms":0,"do":"show","shape":{"id":"o1","explain":"Label: Mouth. Digestion starts here.","kind":"text","x":70,"y":270,"text":"mouth","size":24}},{"at_ms":1000,"do":"show","shape":{"id":"o2","explain":"Label: Oesophagus. The tube that squeezes food down to the stomach.","kind":"text","x":175,"y":270,"text":"oesophagus","size":24}},{"at_ms":2000,"do":"show","shape":{"id":"o3","explain":"Label: Stomach. Food is churned and mixed here.","kind":"text","x":347,"y":270,"text":"stomach","size":24}},{"at_ms":3000,"do":"show","shape":{"id":"o4","explain":"Label: Small intestine. Most digestion and absorption happen here.","kind":"text","x":478,"y":270,"text":"small intestine","size":24}},{"at_ms":4000,"do":"show","shape":{"id":"o5","explain":"Label: Large intestine. Water is absorbed here and the rest becomes waste.","kind":"text","x":682,"y":270,"text":"large intestine","size":24}},{"at_ms":4800,"do":"show","shape":{"id":"tube","explain":"The digestion pipeline: one long tube from mouth to large intestine.","kind":"line","x1":60,"y1":340,"x2":860,"y2":340,"stroke":"#a1887f","width":14}},{"at_ms":5200,"do":"show","shape":{"id":"food","explain":"A food dot: watch it travel the whole pipeline.","kind":"circle","cx":70,"cy":340,"r":18,"fill":"#c98a3d","stroke":"#7a521a","strokeWid