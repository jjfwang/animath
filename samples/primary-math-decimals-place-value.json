},{"at_ms":4900,"do":"show","shape":{"id":"eq","kind":"text","size":36,"text":"0.20 + 0.05 = 0.25","x":470,"y":340}},{"at_ms":5700,"do":"emphasize","dur_ms":1000,"target":"eq"},{"at_ms":6900,"do":"caption","text":"25 hundredths make one quarter of the whole"}]},{"caption":"Add: line up the places","duration_ms":8000,"id":"s3","narration":"Add 0.4 and 0.25. First write 0.4 as 0.40 so both numbers talk in hundredths, then add the hundredths.","steps":[{"at_ms":0,"do":"show","shape":{"fill":"#ffffff","h":70,"id":"bar1","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":160}},{"at_ms":800,"do":"show","shape":{"fill":"#7fb3e8","h":70,"id":"fill1","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":144,"x":120,"y":160}},{"at_ms":1100,"do":"show","shape":{"id":"lab1","kind":"text","size":30,"text":"0.4 = 4 tenths","x":520,"y":205}},{"at_ms":2000,"do":"show","shape":{"fill":"#ffffff","h":70,"id":"bar2","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":280}},{"at_ms":2200,"do":"show","shape":{"fill":"#8fd694","h":70,"id":"fill2","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":90,"x":120,"y":280}},{"at_ms":2500,"do":"show","shape":{"id":"lab2","kind":"text","size":30,"text":"0.25 = 25 hundredths","x":520,"y":325}},{"at_ms":3600,"do":"caption","text":"Line them up: 0.40 + 0.25 — tenths under tenths"},{"at_ms":4400,"do":"show","shape":{"fill":"#ffffff","h":70,"id":"bar3","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":360,"x":120,"y":390}},{"at_ms":4600,"do":"show","shape":{"fill":"#b08fd6","h":70,"id":"fill3","kind":"rect","stroke":"#1a1a1a","strokeWidth":2,"w":234,"x":120,"y":390}},{"at_ms":5000,"do":"show","shape":{"id":"eq","kind":"text","size":34,"text":"0.40 + 0.25 = 0.65","x":520,"y":435}},{"at_ms":5800,"do":"emphasize","dur_ms":1000,"target":"eq"},{"at_ms":6600,"do":"show","shape":{"color":"#8a1f1f","id":"warn","kind":"text","size":26,"text":"0.25 is NOT bigger than 0.4 — 25 > 4 says nothing here!","x":120,"y":510}}]},{"ca