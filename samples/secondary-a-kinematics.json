    {
      "caption": "The SUVAT pair — and the gradient trap",
      "duration_ms": 8000,
      "id": "s4",
      "narration": "With constant acceleration a, velocity grows as v equals u plus a t, and displacement accumulates as u t plus half a t squared. But watch the trap: a straight s-t graph has constant gradient — and the gradient of s-t is velocity, so the velocity is constant and the acceleration is zero.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "v",
            "kind": "latex",
            "size": 50,
            "tex": "v = u + at",
            "x": 120,
            "y": 110
          }
        },
        {
          "at_ms": 1200,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "s",
            "kind": "latex",
            "size": 50,
            "tex": "s = ut + \\frac{1}{2}at^2",
            "x": 120,
            "y": 210
          }
        },
        {
          "at_ms": 2400,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "setup",
            "kind": "text",
            "size": 28,
            "text": "A straight s–t graph has constant gradient…",
            "x": 120,
            "y": 310
          }
        },
        {
          "at_ms": 3400,
          "do": "show",
          "shape": {
            "color": "#b00020",
            "id": "trap",
            "kind": "text",
            "size": 40,
            "text": "…so the acceleration is constant?",
            "x": 140,
            "y": 380
          }
        },
        {
          "at_ms": 4700,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "fix",
            "kind": "text",
            "size": 26,
            "text": "No: constant gradient of s–t means constant velocity — a = 0",
            "x": 120,
            "y": 460
          }
        },
        {
          "at_ms": 5600,
          "do": "emphasize",
          "dur_ms": 900,
          "target": "trap"
        },
        {
          "at_ms": 6700,
          "do": "caption",
          "text": "Read the gradient for the graph in front of you"
        }
      ]
