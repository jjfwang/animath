    {
      "caption": "Gradient of the s–t graph is the velocity",
      "duration_ms": 7000,
      "id": "s2",
      "narration": "Pick two points on the s-t graph and form the gradient triangle: rise in displacement over run in time. That slope is the velocity — rise over run, metres over seconds.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "sxa",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 60,
            "x2": 420,
            "y1": 420,
            "y2": 420
          }
        },
        {
          "at_ms": 300,
          "do": "show",
          "shape": {
            "id": "sya",
            "kind": "line",
            "stroke": "#1a1a1a",
            "width": 2,
            "x1": 90,
            "x2": 90,
            "y1": 100,
            "y2": 450
          }
        },
        {
          "at_ms": 600,
          "do": "show",
          "shape": {
            "id": "stline",
            "kind": "line",
            "stroke": "#1f7a3a",
            "width": 4,
            "x1": 120,
            "x2": 390,
            "y1": 390,
            "y2": 180
          }
        },
        {
          "at_ms": 1500,
