    {
      "id": "s1",
      "caption": "Arc length and sector area",
      "narration": "A sector is a fraction of a full circle: theta over 360. With radius 100 and a 60 degree angle, the arc is one sixth of the circumference, about 104.7, and the sector area is one sixth of pi r squared, about 5236.",
      "duration_ms": 8000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "circ",
            "kind": "circle",
            "cx": 440,
            "cy": 290,
            "r": 100,
            "fill": "none",
            "stroke": "#1a1a1a",
            "strokeWidth": 3
          }
        },
        {
          "at_ms": 700,
          "do": "show",
          "shape": {
            "id": "rad1",
            "kind": "line",
            "x1": 440,
            "y1": 290,
            "x2": 540,
            "y2": 290,
            "stroke": "#1a1a1a",
            "width": 4
          }
        },
        {
