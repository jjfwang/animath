{"animath":"0.1","title":"E-Math mensuration: sectors, pyramids and spheres","level":"secondary","subject":"math","topic":"e-mensuration","kind":"concept","canvas":{"width":960,"height":540},"scenes":[{"id":"s1","caption":"Arc length and sector area","narration":"Watch the radius sweep out 60 degrees: each 20-degree beat stages in its wedge while the arc-length chip climbs 34.9, 69.8, 104.7. The full sector is one sixth of the circle, so its area is one sixth of pi r squared, about 5236.","duration_ms":8000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"circ","kind":"circle","cx":440,"cy":290,"r":100,"fill":"none","stroke":"#1a1a1a","strokeWidth":3,"explain":"The circle of radius 100."}},{"at_ms":400,"do":"show","shape":{"id":"rad1","kind":"line","x1":440,"y1":290,"x2":540,"y2":290,"stroke":"#1a1a1a","width":4,"explain":"The radius: r = 100."}},{"at_ms":700,"do":"show","shape":{"id":"sweep","kind":"line","x1":440,"y1":290,"x2":540,"y2":290,"stroke":"#b00020","width":4,"explain":"The sweeping radius: it opens out the sector angle."}},{"at_ms":900,"do":"move","target":"sweep","to":{"x2":534,"y2":256},"dur_ms":900},{"at_ms":1800,"do":"show","shape":{"id":"w1","kind":"polygon","points":[[440,290],[540,290],[538,273],[534,256]],"fill":"#e8f0fe","stroke":"#2b5cb8","strokeWidth":3,"explain":"The sector wedge for a 20-degree angle."}},{"at_ms":1900,"do":"show","shape":{"id":"th1","kind":"text","x":608,"y":245,"size":26,"text":"θ = 20°","explain":"The sector angle: 20 degrees."}},{"at_ms":1900,"do":"show","shape":{"id":"arc1","kind":"text","x":608,"y":300,"size":26,"text":"arc ≈ 34.9","explain":"The arc length for 20 degrees: about 34.9."}},{"at_ms":2100,"do":"move","target":"sweep","to":{"x2":517,"y2":226},"dur_ms":900},{"at_ms":3000,"do":"show","shape":{"id":"w2","kind":"polygon","points":[[440,290],[534,256],[527,240],[517,226]],"fill":"#e8f0fe","stroke":"#2b5cb8","strokeWidth":3,"explain":"The sector wedge for a 40-degree angle."}},{"at_ms":3100,"do":"hide","target":"th1"},{"at_ms":3100,"do":"show","shape":{"id":"th2","kind":"text","x":608,"y":245,"size":26,"text":"θ = 40°","explain":"The sector angle: 40 degrees."}},{"at_ms":3100,"do":"hide","target":"arc1"},{"at_ms":3150,"do":"show","shape":{"id":"arc2","kind":"text","x":608,"y":300,"size":26,"text":"arc ≈ 69.8","explain":"The arc length for 40 degrees: about 69.8."}},{"at_ms":3400,"do":"move","target":"sweep","to":{"x2":490,"y2":203},"dur_ms":900},{"at_ms":4300,"do":"show","shape":{"id":"w3","kind":"polygon","points":[[440,290],[517,226],[504,213],[490,203]],"fill":"#e8f0fe","stroke":"#2b5cb8","strokeWidth":3,"explain":"The sector wedge for a 60-degree angle."}},{"at_ms":4400,"do":"hide","target":"th2"},{"at_ms":4400,"do":"show","shape":{"id":"th3","kind":"text","x":608,"y":245,"size":26,"text":"θ = 60°","explain":"The sector angle: 60 degrees."}},{"at_ms":4400,"do":"hide","target":"arc2"},{"at_ms":4450,"do":"show","shape":{"id":"arc3","kind":"text","x":608,"y":300,"size":26,"text":"arc ≈ 104.7","explain":"The arc length for 60 degrees: about 104.7."}},{"at_ms":5200,"do":"show","shape":{"id":"rlab","kind":"text","x":608,"y":190,"size":24,"text":"r = 100","explain":"The radius label: r = 100."}},{"at_ms":5600,"do":"show","shape":{"id":"areaF","kind":"latex","x":40,"y":445,"size":30,"tex":"\\text{area} = \\frac{60}{360} \\times \\pi(100)^2 \\approx 5236","explain":"The sector-area formula: 60 over 360 of pi r-squared, about 5236."}},{"at_ms":6800,"do":"emphasize","target":"w3","dur_ms":700}]},{"id":"s2","caption":"Pyramid volume, revealed","narration":"The base fills in first: 6 by 6 gives a base area of 36. The height line grows in three beats to 9, the apex lands, and the edges close the pyramid, so one third of 36 times 9 is 108.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"base","kind":"rect","x":380,"y":330,"w":120,"h":80,"fill":"none","stroke":"#1a1a1a","strokeWidth":3,"explain":"The base of the pyramid: a 6-by-6 square."}},{"at_ms":500,"do":"show","shape":{"id":"baseFill","kind":"rect","x":380,"y":330,"w":120,"h":80,"fill":"#e8f0fe","stroke":"none","explain":"The base-area highlight: 36 square units."}},{"at_ms":800,"do":"show","shape":{"id":"bChip","kind":"text","x":600,"y":250,"size":26,"text":"base area = 6 × 6 = 36","explain":"The base area: 6 times 6 equals 36."}},{"at_ms":1400,"do":"show","shape":{"id":"hline","kind":"line","x1":440,"y1":368,"x2":440,"y2":366,"stroke":"#b00020","width":4,"explain":"The height line: the perpendicular height h."}},{"at_ms":1600,"do":"move","target":"hline","to":{"y2":310},"dur_ms":800},{"at_ms":2000,"do":"show","shape":{"id":"h1","kind":"text","x":600,"y":305,"size":26,"text":"h = 3","explain":"Height 3: the first pyramid level."}},{"at_ms":2600,"do":"move","target":"hline","to":{"y2":250},"dur_ms":800},{"at_ms":3000,"do":"hide","target":"h1"},{"at_ms":3000,"do":"show","shape":{"id":"h2","kind":"text","x":600,"y":305,"size":26,"text":"h = 6","explain":"Height 6: the pyramid grows taller."}},{"at_ms":3600,"do":"move","target":"hline","to":{"y2":220},"dur_ms":800},{"at_ms":4200,"do":"hide","target":"h2"},{"at_ms":4200,"do":"show","shape":{"id":"h3","kind":"text","x":600,"y":305,"size":26,"text":"h = 9","explain":"Height 9: the full pyramid height."}},{"at_ms":4500,"do":"show","shape":{"id":"apex","kind":"circle","cx":440,"cy":220,"r":6,"fill":"#b00020","stroke":"none","explain":"The apex: the top vertex of the pyramid."}},{"at_ms":4800,"do":"show","shape":{"id":"edge1","kind":"line","x1":440,"y1":220,"x2":380,"y2":330,"stroke":"#1a1a1a","width":3,"explain":"A slant edge: from the apex to a base corner."}},{"at_ms":4950,"do":"show","shape":{"id":"edge2","kind":"line","x1":440,"y1":220,"x2":500,"y2":330,"stroke":"#1a1a1a","width":3,"explain":"A slant edge: from the apex to a base corner."}},{"at_ms":5400,"do":"show","shape":{"id":"vform","kind":"latex","x":40,"y":450,"size":30,"tex":"V = \\frac{1}{3} \\times \\text{base area} \\times h","explain":"The pyramid volume formula: one-third times base area times height."}},{"at_ms":6200,"do":"show","shape":{"id":"vres","kind":"latex","x":40,"y":500,"size":30,"tex":"V = \\frac{1}{3}(36)(9) = 108","color":"#b00020","explain":"The result: one-third times 36 times 9 equals 108."}},{"at_ms":7400,"do":"emphasize","target":"vres","dur_ms":700}]},{"id":"s3","caption":"Sphere volume","narration":"The radius arrow grows beat by beat: r 1, 2, 3, while the r-cubed chip jumps 1, 8, 27. Four thirds pi times r cubed at r 3 is 36 pi, about 113.1.","duration_ms":9000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"sph","kind":"circle","cx":360,"cy":290,"r":90,"fill":"none","stroke":"#1a1a1a","strokeWidth":3,"explain":"The sphere: shown in cross-section as a circle."}},{"at_ms":400,"do":"show","shape":{"id":"rarr","kind":"arrow","x1":360,"y1":290,"x2":362,"y2":290,"stroke":"#b00020","width":4,"explain":"The radius arrow: from the centre outward."}},{"at_ms":600,"do":"move","target":"rarr","to":{"x2":390},"dur_ms":700},{"at_ms":900,"do":"show","shape":{"id":"rc1","kind":"text","x":600,"y":200,"size":26,"text":"r = 1","explain":"Radius 1: the smallest sphere."}},{"at_ms":950,"do":"show","shape":{"id":"rcb1","kind":"text","x":600,"y":255,"size":26,"text":"r³ = 1","explain":"r-cubed equals 1: volume scales with the cube of r."}},{"at_ms":1500,"do":"move","target":"rarr","to":{"x2":420},"dur_ms":700},{"at_ms":1800,"do":"hide","target":"rc1"},{"at_ms":1800,"do":"show","shape":{"id":"rc2","kind":"text","x":600,"y":200,"size":26,"text":"r = 2","explain":"Radius 2: the middle sphere."}},{"at_ms":1800,"do":"hide","target":"rcb1"},{"at_ms":1850,"do":"show","shape":{"id":"rcb2","kind":"text","x":600,"y":255,"size":26,"text":"r³ = 8","explain":"r-cubed equals 8: volume scales with the cube of r."}},{"at_ms":2400,"do":"move","target":"rarr","to":{"x2":450},"dur_ms":700},{"at_ms":2700,"do":"hide","target":"rc2"},{"at_ms":2700,"do":"show","shape":{"id":"rc3","kind":"text","x":600,"y":200,"size":26,"text":"r = 3","explain":"Radius 3: the largest sphere."}},{"at_ms":2700,"do":"hide","target":"rcb2"},{"at_ms":2750,"do":"show","shape":{"id":"rcb3","kind":"text","x":600,"y":255,"size":26,"text":"r³ = 27","explain":"r-cubed equals 27: volume scales with the cube of r."}},{"at_ms":3300,"do":"show","shape":{"id":"svf","kind":"latex","x":40,"y":430,"size":30,"tex":"V = \\frac{4}{3}\\pi r^3","explain":"The sphere volume formula: four-thirds pi r-cubed."}},{"at_ms":4100,"do":"show","shape":{"id":"svr","kind":"latex","x":40,"y":480,"size":30,"tex":"V = \\frac{4}{3}\\pi(3)^3 = 36\\pi \\approx 113.1","color":"#b00020","explain":"The result: four-thirds pi times 27 is 36 pi, about 113.1."}},{"at_ms":5200,"do":"emphasize","target":"svr","dur_ms":700},{"at_ms":6400,"do":"caption","text":"Grow the radius, and r cubed grows faster"}]},{"id":"s4","caption":"A common mistake: doubling r doubles area","narration":"A common mistake: doubling the radius doubles the area. Radius 2 gives about 12.6; radius 4 gives about 50.3 — four times as much, because area scales with the square of the radius.","duration_ms":8000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"wrong","kind":"text","x":480,"y":500,"size":30,"text":"Doubling the radius doubles the area.","color":"#b00020","align":"middle","explain":"The misconception: doubling the radius doubles the area."}},{"at_ms":200,"do":"move","target":"wrong","to":{"y":130},"dur_ms":600},{"at_ms":800,"do":"show","shape":{"id":"c1","kind":"circle","cx":240,"cy":270,"r":60,"fill":"none","stroke":"#1a1a1a","strokeWidth":3,"explain":"The smaller circle: r = 2."}},{"at_ms":900,"do":"show","shape":{"id":"rdoub","kind":"arrow","x1":240,"y1":270,"x2":300,"y2":270,"stroke":"#b00020","width":4,"explain":"The doubling arrow: the radius grows from 2 to 4."}},{"at_ms":1200,"do":"show","shape":{"id":"a1","kind":"text","x":140,"y":395,"size":26,"text":"r = 2, A ≈ 12.6","explain":"Small circle: r = 2, area about 12.6."}},{"at_ms":1800,"do":"move","target":"rdoub","to":{"x2":360},"dur_ms":900},{"at_ms":2700,"do":"show","shape":{"id":"c2","kind":"circle","cx":620,"cy":290,"r":120,"fill":"none","stroke":"#b86a1f","strokeWidth":3,"explain":"The larger circle: r = 4."}},{"at_ms":2900,"do":"show","shape":{"id":"a2","kind":"text","x":540,"y":455,"size":26,"text":"r = 4, A ≈ 50.3","explain":"Large circle: r = 4, area about 50.3."}},{"at_ms":3600,"do":"show","shape":{"id":"ratio","kind":"latex","x":40,"y":455,"size":32,"tex":"50.3 \\approx 4 \\times 12.6","color":"#b00020","explain":"The check: 50.3 is about 4 times 12.6, so the area quadrupled."}},{"at_ms":4300,"do":"show","shape":{"id":"take","kind":"text","x":40,"y":505,"size":28,"text":"Area scales with r²: double r → 4× area.","explain":"The takeaway: area scales with r-squared, so doubling r gives 4 times the area."}},{"at_ms":5300,"do":"emphasize","target":"take","dur_ms":700}]}]}
