            "y": 180,
            "size": 34,
            "color": "#1f7a3a",
            "tex": "\\text{arc} = \\frac{60}{360} \\times 2\\pi(100) \\approx 104.7"
          }
        },
        {
          "at_ms": 5800,
          "do": "show",
          "shape": {
            "id": "secEq",
            "kind": "latex",
            "x": 620,
            "y": 280,
            "size": 34,
            "color": "#1f7a3a",
            "tex": "\\text{area} = \\frac{60}{360} \\times \\pi(100)^2 \\approx 5236"
          }
        },
        {
          "at_ms": 7000,
          "do": "emphasize",
          "target": "sector",
          "dur_ms": 600
        }
      ]
    },
    {
      "id": "s2",
      "caption": "Pyramid volume, revealed",
