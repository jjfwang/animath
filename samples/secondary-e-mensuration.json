            "stroke": "#2b5cb8",
            "strokeWidth": 3
          }
        },
        {
          "at_ms": 3000,
          "do": "show",
          "shape": {
            "id": "labR",
            "kind": "text",
            "x": 462,
            "y": 252,
            "size": 26,
            "text": "r = 100"
          }
