    {
      "caption": "Work is done when a force moves something",
      "duration_ms": 10000,
      "id": "s1",
      "narration": "Work in physics is not just effort — a force must move something. Here a force of 50 newtons pushes this crate 4 metres. The work done is force times distance: 50 times 4, which is 200 joules. No movement, no work done.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
            "kind": "text",
            "size": 34,
            "text": "Work: pushing a crate",
            "x": 80,
            "y": 70
          }
        },
        {
          "at_ms": 500,
          "do": "show",
          "shape": {
            "id": "floor",
            "kind": "line",
            "stroke": "#5d6d7e",
            "width": 4,
            "x1": 80,
            "x2": 880,
            "y1": 400,
            "y2": 400
          }
        },
        {
          "at_ms": 900,
