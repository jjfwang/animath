    },
    {
      "caption": "Power is the rate at which work gets done",
      "duration_ms": 10000,
      "id": "s2",
      "narration":"Now suppose the same 200 joules of work is done in 10 seconds: power is work over time — 200 divided by 10, which is 20 watts. Do it in 2 seconds and the power is 100 watts: same work, more power — power is about rate.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
            "kind": "text",
            "size": 34,
            "text": "Power: how fast is the work done?",
            "x": 80,
            "y": 70
          }
        },
        {
          "at_ms": 500,
          "do": "show",
          "shape": {
            "color": "#2471a3",
            "id": "formula",
            "kind": "latex",
            "size": 40,
            "tex": "P = \\frac{W}{t}",
            "x": 80,
            "y": 170
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "id": "setup",
            "kind": "text",
            "size": 24,
            "text": "Same crate, same push: W = 200 J (from the last scene)",
            "x": 80,
            "y": 250
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "id": "case1",
            "kind": "text",
            "size": 20,
            "text": "Done in 10 s — steady, unhurried push",
            "x": 80,
            "y": 320
          }
        },
        {
          "at_ms": 3800,
          "do": "show",
          "shape": {
            "color": "#1f7a3a",
            "id": "p1",
            "kind": "latex",
            "size": 36,
            "tex": "P = \\frac{200\\ \\text{J}}{10\\ \\text{s}} = 20\\ \\text{W}",
            "x": 80,
            "y": 400
          }
        },
        {
          "at_ms": 5200,
          "do": "show",
          "shape": {
            "id": "case2",
            "kind": "text",
            "size": 20,
            "text": "Done in 2 s — same work, much faster",
            "x": 526,
            "y": 320
          }
        },
        {
          "at_ms": 6400,
          "do": "show",
          "shape": {
            "color": "#c0392b",
            "id": "p2",
            "kind": "latex",
            "size": 36,
            "tex": "P = \\frac{200\\ \\text{J}}{2\\ \\text{s}} = 100\\ \\text{W}",
            "x": 480,
            "y": 400
          }
        },
        {
          "at_ms": 7800,
          "do": "emphasize",
          "target": "p2"
        },
        {
          "at_ms": 8600,
          "do": "caption",
          "text": "Same work, less time = more power. Watts are joules per second."
        }
      ]
    },
