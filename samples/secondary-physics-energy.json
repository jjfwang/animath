          "do": "show",
          "shape": {
            "id": "point",
            "kind": "text",
            "size": 24,
            "text": "Joules (J) are the units of work — a force moved something.",
            "x": 80,
            "y": 500
          }
        },
        {
          "at_ms": 9200,
          "do": "caption",
          "text": "Work = force × distance. No movement, no work."
        }
