        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "formula",
            "kind": "latex",
            "size": 44,
            "tex": "P(A) = \\frac{\\text{favourable}}{\\text{total}}",
            "x": 160,
            "y": 200
          }
