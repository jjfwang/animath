","shape":{"id":"barTrap","kind":"rect","x":100,"y":90,"w":0,"h":36,"fill":"#c0392b","explain":"The trap bar: length 7, the wrong answer."}},{"at_ms":1100,"do":"move","target":"barTrap","to":{"w":420},"dur_ms":1300},{"at_ms":2800,"do":"show","shape":{"id":"trueLab","kind":"text","text":"The truth: c = 5","x":100,"y":200,"size":28,"explain":"The truth: c = 5."}},{"at_ms":3100,"do":"show","shape":{"id":"barTrue","kind":"rect","x":100,"y":220,"w":0,"h":36,"fill":"#1f7a3a","explain":"The true bar: length 5, the correct hypotenuse."}},{"at_ms":3400,"do":"move","target":"barTrue","to":{"w":300},"dur_ms":1100},{"at_ms":5000,"do":"show","shape":{"id":"whyLab","kind":"text","text":"Lengths add to 7, but the squares add: 9 + 16 = 25.","x":100,"y":330,"size":26,"explain":"Why the trap fails: lengths add to 7, but the squares add: 9 + 16 = 25."}},{"at_ms":6200,"do":"hide","target":"barTrap"},{"at_ms":6400,"do":"hide","target":"trapLab"},{"at_ms":7000,"do":"show","shape":{"id":"rule","kind":"latex","tex":"a^2 + b^2 = c^2","x":240,"y":390,"size":46,"color":"#1f7a3a","explain":"The theorem: a-squared plus b-squared equals c-squared."}},{"at_ms":8600,"do":"emphasize","target":"rule","dur_ms":1000}]}]}