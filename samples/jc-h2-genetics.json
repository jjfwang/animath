    {
      "caption": "Central dogma: DNA makes protein",
      "duration_ms": 9000,
      "id": "s1",
      "narration": "Genetic information flows one way. DNA is transcribed into messenger RNA in the nucleus — then the mRNA is translated into protein at a ribosome. DNA to RNA to protein: the central dogma of molecular biology.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "dogma",
            "kind": "latex",
            "size": 40,
            "tex": "\\text{DNA} \\rightarrow \\text{mRNA} \\rightarrow \\text{protein}",
            "x": 180,
            "y": 180
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "id": "txLabel",
            "kind": "text",
            "size": 24,
            "text": "transcription (in the nucleus)",
            "x": 200,
            "y": 265
          }
        },
        {
          "at_ms": 2400,
          "do": "show",
          "shape": {
            "id": "tlLabel",
            "kind": "text",
            "size": 24,
            "text": "translation (at a ribosome)",
            "x": 520,
            "y": 265
