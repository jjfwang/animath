    {
      "caption": "Ohm's law: V = IR",
      "duration_ms": 9000,
      "id": "s4",
      "narration": "Ohm's law says voltage equals current times resistance. A 12-volt battery across a 4-ohm resistor pushes a current of 12 divided by 4 — that is 3 amps.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "title",
            "kind": "text",
            "size": 34,
            "text": "Ohm's law: V = IR",
            "x": 80,
            "y": 70
          }
        },
        {
          "at_ms": 800,
          "do": "show",
          "shape": {
            "id": "law",
            "kind": "latex",
            "size": 56,
            "tex": "V = I R",
            "x": 120,
            "y": 200
          }
        },
        {
          "at_ms": 2000,
          "do": "show",
          "shape": {
            "id": "eg",
            "kind": "text",
            "size": 28,
            "text": "Worked example: a 12 V battery across 4 Ω",
            "x": 120,
            "y": 300
          }
        },
        {
          "at_ms": 3000,
          "do": "show",
          "shape": {
            "id": "givenV",
            "kind": "latex",
            "size": 44,
            "tex": "V = 12\\,\\text{V}",
            "x": 120,
            "y": 370
          }
        },
        {
          "at_ms": 3800,
          "do": "show",
          "shape": {
            "id": "givenR",
            "kind": "latex",
            "size": 44,
            "tex": "R = 4\\,\\Omega",
            "x": 430,
            "y": 370
          }
        },
        {
          "at_ms": 4800,
          "do": "show",
          "shape": {
            "id": "sub",
            "kind": "latex",
            "size": 44,
            "tex": "I = \\frac{V}{R} = \\frac{12\\,\\text{V}}{4\\,\\Omega}",
            "x": 120,
            "y": 460
          }
        },
        {
          "at_ms": 6200,
          "do": "show",
          "shape": {
            "id": "ans",
            "kind": "latex",
            "size": 60,
            "tex": "I = 3\\,\\text{A}",
            "x": 620,
            "y": 200
          }
        },
        {
          "at_ms": 6600,
          "do": "emphasize",
          "dur_ms": 1200,
          "target": "ans"
        },
        {
          "at_ms": 7600,
          "do": "caption",
          "text": "12 ÷ 4 = 3 — the current is 3 A"
        }
      ]
    },
