    {
      "caption": "No real roots is not no solution",
      "duration_ms": 7000,
      "id": "s4",
      "narration": "A negative discriminant means no REAL roots — the curve never touches the axis. But the equation still has solutions: two complex ones. The mistake is stopping at 'no solution'.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "color": "#1a1a1a",
            "id": "eg",
            "kind": "latex",
            "size": 44,
            "tex": "x^2 + 1 = 0, \\quad D = -4",
            "x": 140,
            "y": 160
          }
        },
        {
          "at_ms": 1400,
          "do": "show",
          "shape": {
            "id": "claim",
            "kind": "text",
            "size": 34,
            "text": "D < 0 ⇒ no REAL roots",
            "x": 140,
            "y": 260
          }
        },
        {
          "at_ms": 2800,
          "do": "show",
          "shape": {
            "color": "#b00020",
            "id": "slip",
            "kind": "text",
            "size": 32,
            "text": "…but NOT “no solution at all”",
            "x": 140,
            "y": 340
