{"animath":"0.1","title":"Weather and climate: heat on the move","level":"primary","subject":"geography","topic":"weather-climate","kind":"concept","canvas":{"width":960,"height":540},"scenes":[{"id":"s1","caption":"The sun heats the land","narration":"The sun pours heat onto the land. The land warms the air above it, and the warm air begins to rise.","duration_ms":6000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"sun","kind":"circle","cx":800,"cy":110,"r":55,"fill":"#ffdd55","stroke":"#e6b800","strokeWidth":3,"explain":"The sun: it pours heat onto the land."}},{"at_ms":300,"do":"show","shape":{"id":"land","kind":"rect","x":60,"y":400,"w":840,"h":140,"fill":"#8a9a5b","stroke":"#5a6b3a","strokeWidth":3,"explain":"The land: the sun warms it up."}},{"at_ms":600,"do":"show","shape":{"id":"rays","kind":"arrow","x1":760,"y1":180,"x2":700,"y2":380,"stroke":"#e07b00","width":4,"explain":"Sunlight: carrying heat down to the land."}},{"at_ms":1100,"do":"show","shape":{"id":"warmAir","kind":"circle","cx":500,"cy":380,"r":14,"fill":"#ff9a5a","stroke":"#c25a00","strokeWidth":2,"explain":"Warm air: heated by the land, it is about to rise."}},{"at_ms":1500,"do":"move","target":"warmAir","to":{"cx":500,"cy":220},"dur_ms":2500},{"at_ms":4300,"do":"caption","text":"Heat from the sun lifts the air"}]},{"id":"s2","caption":"Warm air rises, cool air flows in","narration":"Warm air rises, and cooler air flows in to take its place. That moving air is what we feel as wind.","duration_ms":7000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"warm","kind":"circle","cx":480,"cy":400,"r":16,"fill":"#ff9a5a","stroke":"#c25a00","strokeWidth":2,"explain":"Warm air: it rises."}},{"at_ms":300,"do":"show","shape":{"id":"inflow","kind":"arrow","x1":80,"y1":320,"x2":380,"y2":320,"stroke":"#5a9bd4","width":5,"explain":"Cooler air: it flows in to fill the gap."}},{"at_ms":600,"do":"show","shape":{"id":"warmLabel","kind":"text","x":560,"y":400,"text":"warm","size":30,"color":"#c25a00","explain":"Label: warm air."}},{"at_ms":800,"do":"show","shape":{"id":"coolLabel","kind":"text","x":90,"y":260,"text":"cool","size":30,"color":"#2a5db5","explain":"Label: cooler air."}},{"at_ms":1100,"do":"move","target":"warm","to":{"cx":480,"cy":180},"dur_ms":2500},{"at_ms":1300,"do":"move","target":"inflow","to":{"x1":180,"y1":320,"x2":480,"y2":320},"dur_ms":2000},{"at_ms":4200,"do":"caption","text":"Rising and in-flowing air is wind"}]},{"id":"s3","caption":"Clouds gather, rain falls","narration":"High up, the warm air cools and gathers into clouds. The drops grow heavy and fall as rain.","duration_ms":7000,"steps":[{"at_ms":0,"do":"show","shape":{"id":"cloud1","kind":"circle","cx":380,"cy":180,"r":45,"fill":"#e8ecf2","stroke":"#9aa5b5","strokeWidth":2,"explain":"Cloud: cooled vapour gathered into drops."}},{"at_ms":200,"do":"show","shape":{"id":"cloud2","kind":"circle","cx":460,"cy":165,"r":55,"fill":"#e8ecf2","stroke":"#9aa5b5","strokeWidth":2,"explain":"Cloud: cooled vapour gathered into drops."}},{"at_ms":400,"do":"show","shape":{"id":"cloud3","kind":"circle","cx":540,"cy":180,"r":45,"fill":"#e8ecf2","stroke":"#9aa5b5","strokeWidth":2,"explain":"Cloud: cooled vapour gathered into drops."}},{"at_ms":800,"do":"show","shape":{"id":"drop1","kind":"line","x1":420,"y1":230,"x2":420,"y2":270,"stroke":"#3a7bd5","width":4,"explain":"Rain: falling back to the ground."}},{"at_ms":900,"do":"show","shape":{"id":"drop2","kind":"line","x1":500,"y1":230,"x2":500,"y2":270,"stroke":"#3a7bd5","width":4,"explain":"Rain: falling back to the ground."}},{"at_ms":1200,"do":"move","target":"drop1","to":{"x1":420,"y1":420,"x2":420,"y2":460},"dur_ms":1800},{"at_ms":1300,"do":"move","target":"drop2","to":{"x1":500,"y1":420,"x2":500,"y2":460},"dur_ms":1800},{"at_ms":4800,"do":"caption","text":"Weather is today's rain - climate is decades of weather"}]}]}
