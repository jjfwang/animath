hape":{"id":"d3","kind":"latex","tex":"3","x":600,"y":430,"size":44,"color":"#1a56db"}},{"at_ms":6000,"do":"move","target":"d3","to":{"x":290,"y":440},"dur_ms":700},{"at_ms":6800,"do":"show","shape":{"id":"xlab","kind":"latex","tex":"x =","x":50,"y":370,"size":48,"color":"#1f7a3a"}},{"at_ms":7600,"do":"caption","text":"Undo in reverse: minus five first, then divide by three"}]},{"id":"s4","caption":"The (a+b)^2 trap","duration_ms":9000,"narration":"A plus b all squared is not a squared plus b squared: with a equals two and b equals three, the wrong side gives thirteen. Watch the missing middle term two-a-b travel in while the twenty-five chip slides home.","steps":[{"at_ms":0,"do":"show","shape":{"id":"title","kind":"text","text":"The (a+b)^2 trap","x":120,"y":100,"size":36}},{"at_ms":400,"do":"show","shape":{"id":"trap","kind":"latex","tex":"(a + b)^2 \\neq a^2 + b^2","x":150,"y":170,"size":48,"color":"#b00020"}},{"at_ms":1600,"do":"show","shape":{"id":"wlab","kind":"latex","tex":"2^2 + 3^2 = 4 + 9 =","x":120,"y":280,"size":36}},{"at_ms":2000,"do":"show","shape":{"id":"w13","kind":"latex","tex":"13","x":460,"y":268,"size":72,"color":"#b00020"}},{"at_ms":3000,"do":"show","shape":{"id":"chip2ab","kind":"latex","tex":"2ab","x":770,"y":120,"size":48,"color":"#1f7a3a"}},{"at_ms":3600,"do":"move","target":"chip2ab","to":{"x":620,"y":268},"dur_ms":800},{"at_ms":4600,"do":"show","shape":{"id":"c25","kind":"latex","tex":"25","x":760,"y":360,"size":72,"color":"#1f7a3a"}},{"at_ms":5200,"do":"move","target":"c25","to":{"x":380,"y":360},"dur_ms":700},{"at_ms":6200,"do":"hide","target":"trap"},{"at_ms":6300,"do":"show","shape":{"id":"fixed","kind":"latex","tex":"(a + b)^2 = a^2 + 2ab + b^2","x":150,"y":170,"size":40,"color":"#1f7a3a"}},{"at_ms":7000,"do":"hide","target":"wlab"},{"at_ms":7100,"do":"hide","target":"w13"},{"at_ms":7400,"do":"show","shape":{"id":"marker","kind":"text","text":"See secondary A: binomial expansion","x":150,"y":470,"size":24,"color":"#555555"}},{"at_ms"