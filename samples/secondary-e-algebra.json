{"animath": "0.1", "canvas": {"width": 960, "height": 540}, "kind": "concept", "level": "secondary", "subject": "math", "title": "E-Math algebra: expansion, factorisation and changing the subject", "topic": "e-algebra", "scenes": [{"id": "s1", "caption": "Expand with the area model", "duration_ms": 11000, "narration": "Expand x plus two times x plus three with an area model. The tiles travel in from the coloured factor rails and land as x squared, three x, two x and six ones; collect the x tiles to get x squared plus five x plus six.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "text": "Expand with the area model", "x": 120, "y": 100, "size": 36}}, {"at_ms": 400, "do": "show", "shape": {"id": "expr", "kind": "latex", "tex": "(x + 2)(x + 3)", "x": 150, "y": 170, "size": 44, "explain": "The product to expand: (x + 2)(x + 3)."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "rx1", "kind": "text", "text": "x", "x": 589, "y": 182, "size": 32, "color": "#1a56db", "explain": "The row label x: one side of the area rectangle."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "rx2", "kind": "text", "text": "3", "x": 752, "y": 182, "size": 32, "color": "#b45f06", "explain": "The row label 3: the constant part of the (x + 3) side."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "ry1", "kind": "text", "text": "x", "x": 462, "y": 272, "size": 32, "color": "#1e7e34", "explain": "The column label x: the other side of the area rectangle."}}, {"at_ms": 1200, "do": "show", "shape": {"id": "ry2", "kind": "text", "text": "2", "x": 462, "y": 372, "size": 32, "color": "#6a1b9a", "explain": "The column label 2: the constant part of the (x + 2) side."}}, {"at_ms": 2200, "do": "show", "shape": {"id": "tile_x2", "kind": "rect", "x": 650, "y": 120, "w": 60, "h": 40, "fill": "#dceefb", "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The x-squared tile: an x-by-x square."}}, {"at_ms": 2600, "do": "move", "target": "tile_x2", "to": {"x": 500, "y": 220}, "dur_ms": 600}, {"at_ms": 3400, "do": "move", "target": "tile_x2", "to": {"w": 200, "h": 120}, "dur_ms": 600}, {"at_ms": 4100, "do": "show", "shape": {"id": "l_x2", "kind": "latex", "tex": "x^2", "x": 586, "y": 266, "size": 32, "explain": "The x-squared region of the area model."}}, {"at_ms": 4300, "do": "show", "shape": {"id": "tile_3x", "kind": "rect", "x": 730, "y": 90, "w": 60, "h": 60, "fill": "#eafbe6", "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The 3x tile: a 3-by-x rectangle."}}, {"at_ms": 4700, "do": "move", "target": "tile_3x", "to": {"x": 700, "y": 220, "w": 120, "h": 120}, "dur_ms": 600}, {"at_ms": 5400, "do": "show", "shape": {"id": "l_3x", "kind": "latex", "tex": "3x", "x": 736, "y": 266, "size": 32, "explain": "The 3x region of the area model."}}, {"at_ms": 5600, "do": "show", "shape": {"id": "tile_2x", "kind": "rect", "x": 330, "y": 360, "w": 100, "h": 40, "fill": "#eafbe6", "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The 2x tile: a 2-by-x rectangle."}}, {"at_ms": 6000, "do": "move", "target": "tile_2x", "to": {"x": 500, "y": 340, "w": 200, "h": 80}, "dur_ms": 600}, {"at_ms": 6700, "do": "show", "shape": {"id": "l_2x", "kind": "latex", "tex": "2x", "x": 586, "y": 366, "size": 32, "explain": "The 2x region of the area model."}}, {"at_ms": 6900, "do": "show", "shape": {"id": "tile_6", "kind": "rect", "x": 730, "y": 440, "w": 60, "h": 40, "fill": "#fff3d6", "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The 6 tile: a 2-by-3 rectangle."}}, {"at_ms": 7300, "do": "move", "target": "tile_6", "to": {"x": 700, "y": 340, "w": 120, "h": 80}, "dur_ms": 600}, {"at_ms": 8000, "do": "show", "shape": {"id": "l_6", "kind": "latex", "tex": "6", "x": 752, "y": 366, "size": 32, "explain": "The constant region: 2 times 3 is 6."}}, {"at_ms": 8300, "do": "show", "shape": {"id": "ans", "kind": "latex", "tex": "= x^2 + 5x + 6", "x": 150, "y": 445, "size": 44, "color": "#1f7a3a", "explain": "The expanded result: x-squared plus 5x plus 6."}}, {"at_ms": 9300, "do": "emphasize", "target": "ans", "dur_ms": 800}, {"at_ms": 10200, "do": "caption", "text": "Every term in one bracket multiplies every term in the other"}]}, {"id": "s2", "caption": "Factorise by grouping", "duration_ms": 10000, "narration": "Two x plus six plus x y plus three y has no single common factor, so group it. Take two out of the first pair and y out of the second pair, then pull the common bracket x plus three out whole.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "text": "Factorise by grouping", "x": 120, "y": 100, "size": 36}}, {"at_ms": 400, "do": "show", "shape": {"id": "start", "kind": "latex", "tex": "2x + 6 + xy + 3y", "x": 150, "y": 180, "size": 44, "explain": "The expression to factorise: four terms with no single common factor."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "g1", "kind": "latex", "tex": "2x + 6", "x": 150, "y": 320, "size": 44, "explain": "The first pair: 2x + 6 shares a factor of 2."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "grp1", "kind": "rect", "x": 120, "y": 270, "w": 230, "h": 90, "rx": 12, "fill": "none", "stroke": "#1a56db", "strokeWidth": 3, "explain": "The first group: 2x + 6."}}, {"at_ms": 1800, "do": "show", "shape": {"id": "g2", "kind": "latex", "tex": "xy + 3y", "x": 150, "y": 420, "size": 44, "explain": "The second pair: xy + 3y shares a factor of y."}}, {"at_ms": 1800, "do": "show", "shape": {"id": "grp2", "kind": "rect", "x": 120, "y": 370, "w": 230, "h": 90, "rx": 12, "fill": "none", "stroke": "#1f7a3a", "strokeWidth": 3, "explain": "The second group: xy + 3y."}}, {"at_ms": 3200, "do": "show", "shape": {"id": "chip2", "kind": "latex", "tex": "2", "x": 400, "y": 320, "size": 44, "color": "#b00020", "explain": "The factor 2 pulled out of the first pair."}}, {"at_ms": 3600, "do": "move", "target": "chip2", "to": {"x": 105, "y": 320}, "dur_ms": 600}, {"at_ms": 4400, "do": "show", "shape": {"id": "b1", "kind": "latex", "tex": "(x + 3)", "x": 150, "y": 320, "size": 44, "color": "#1f7a3a", "explain": "The bracket left after factoring 2 out of 2x + 6."}}, {"at_ms": 5000, "do": "show", "shape": {"id": "chipy", "kind": "latex", "tex": "y", "x": 400, "y": 420, "size": 44, "color": "#b00020", "explain": "The factor y pulled out of the second pair."}}, {"at_ms": 5400, "do": "move", "target": "chipy", "to": {"x": 105, "y": 420}, "dur_ms": 600}, {"at_ms": 6200, "do": "show", "shape": {"id": "b2", "kind": "latex", "tex": "(x + 3)", "x": 150, "y": 420, "size": 44, "color": "#1f7a3a", "explain": "The bracket left after factoring y out of xy + 3y."}}, {"at_ms": 7000, "do": "move", "target": "b1", "to": {"x": 560, "y": 180}, "dur_ms": 700}, {"at_ms": 7700, "do": "move", "target": "b2", "to": {"x": 745, "y": 180}, "dur_ms": 700}, {"at_ms": 8500, "do": "hide", "target": "b1"}, {"at_ms": 8600, "do": "hide", "target": "b2"}, {"at_ms": 8700, "do": "show", "shape": {"id": "ans", "kind": "latex", "tex": "(x + 3)(2 + y)", "x": 560, "y": 180, "size": 48, "color": "#1f7a3a", "explain": "The factorised form: both pairs share the bracket (x + 3)."}}, {"at_ms": 9300, "do": "caption", "text": "Spot the common bracket, then pull it out whole"}]}, {"id": "s3", "caption": "Change the subject to x", "duration_ms": 9000, "narration": "Make x the subject of y equals three x plus five. Undo the recipe in reverse: the minus five travels across first and flips sign, then dividing by three splits the fraction bar.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "text": "Change the subject to x", "x": 120, "y": 100, "size": 36}}, {"at_ms": 400, "do": "show", "shape": {"id": "l1", "kind": "latex", "tex": "y = 3x + 5", "x": 150, "y": 210, "size": 48, "explain": "The starting equation: make x the subject."}}, {"at_ms": 1800, "do": "show", "shape": {"id": "s5", "kind": "latex", "tex": "- 5", "x": 560, "y": 210, "size": 44, "color": "#b00020", "explain": "Subtract 5 from both sides: undo the plus 5."}}, {"at_ms": 2600, "do": "move", "target": "s5", "to": {"x": 150, "y": 330}, "dur_ms": 700}, {"at_ms": 3500, "do": "show", "shape": {"id": "l2", "kind": "latex", "tex": "y - 5 = 3x", "x": 150, "y": 210, "size": 48, "explain": "After subtracting 5: y minus 5 equals 3x."}}, {"at_ms": 3600, "do": "hide", "target": "l1"}, {"at_ms": 4300, "do": "hide", "target": "s5"}, {"at_ms": 4400, "do": "show", "shape": {"id": "num", "kind": "latex", "tex": "y - 5", "x": 150, "y": 330, "size": 44, "explain": "The numerator y minus 5, waiting to be divided by 3."}}, {"at_ms": 4700, "do": "show", "shape": {"id": "bar", "kind": "line", "x1": 150, "y1": 400, "x2": 170, "y2": 400, "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The fraction bar: divide everything by 3."}}, {"at_ms": 5000, "do": "move", "target": "bar", "to": {"x2": 460}, "dur_ms": 600}, {"at_ms": 5800, "do": "show", "shape": {"id": "d3", "kind": "latex", "tex": "3", "x": 600, "y": 430, "size": 44, "color": "#1a56db", "explain": "The divisor 3: undo the times 3."}}, {"at_ms": 6000, "do": "move", "target": "d3", "to": {"x": 290, "y": 440}, "dur_ms": 700}, {"at_ms": 6800, "do": "show", "shape": {"id": "xlab", "kind": "latex", "tex": "x =", "x": 50, "y": 370, "size": 48, "color": "#1f7a3a", "explain": "x alone on the left: the subject of the formula."}}, {"at_ms": 7600, "do": "caption", "text": "Undo in reverse: minus five first, then divide by three"}]}, {"id": "s4", "caption": "The (a+b)^2 trap", "duration_ms": 9000, "narration": "A plus b all squared is not a squared plus b squared: with a equals two and b equals three, the wrong side gives thirteen. Watch the missing middle term two-a-b travel in while the twenty-five chip slides home.", "steps": [{"at_ms": 0, "do": "show", "shape": {"id": "title", "kind": "text", "text": "The (a+b)^2 trap", "x": 120, "y": 100, "size": 36}}, {"at_ms": 400, "do": "show", "shape": {"id": "trap", "kind": "latex", "tex": "(a + b)^2 \\neq a^2 + b^2", "x": 150, "y": 170, "size": 48, "color": "#b00020", "explain": "The trap: (a + b) squared is NOT a-squared plus b-squared."}}, {"at_ms": 1600, "do": "show", "shape": {"id": "wlab", "kind": "latex", "tex": "2^2 + 3^2 = 4 + 9 =", "x": 120, "y": 280, "size": 36, "explain": "Testing with numbers: (2 + 3) squared against 2-squared plus 3-squared."}}, {"at_ms": 2000, "do": "show", "shape": {"id": "w13", "kind": "latex", "tex": "13", "x": 460, "y": 268, "size": 72, "color": "#b00020", "explain": "The wrong answer: 2-squared plus 3-squared gives 13, not 25."}}, {"at_ms": 3000, "do": "show", "shape": {"id": "chip2ab", "kind": "latex", "tex": "2ab", "x": 770, "y": 120, "size": 48, "color": "#1f7a3a", "explain": "The missing middle term: expanding (a + b)(a + b) gives 2ab."}}, {"at_ms": 3600, "do": "move", "target": "chip2ab", "to": {"x": 695, "y": 311}, "dur_ms": 800}, {"at_ms": 4600, "do": "show", "shape": {"id": "c25", "kind": "latex", "tex": "25", "x": 760, "y": 360, "size": 72, "color": "#1f7a3a", "explain": "The correct answer: (2 + 3) squared is 25."}}, {"at_ms": 5200, "do": "move", "target": "c25", "to": {"x": 380, "y": 360}, "dur_ms": 700}, {"at_ms": 6000, "do": "show", "shape": {"id": "bigAll", "kind": "rect", "x": 600, "y": 300, "w": 200, "h": 200, "fill": "none", "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The (2 + 3) square: 5 by 5, area 25."}}, {"at_ms": 6150, "do": "show", "shape": {"id": "sq4", "kind": "rect", "x": 600, "y": 300, "w": 80, "h": 80, "fill": "#1f77b4", "stroke": "none", "explain": "4: 2 squared, the top-left tile."}}, {"at_ms": 6150, "do": "show", "shape": {"id": "lab4", "kind": "latex", "tex": "4", "x": 631, "y": 332, "size": 30, "color": "#ffffff", "explain": "The value 4: 2 squared."}}, {"at_ms": 6300, "do": "show", "shape": {"id": "r6a", "kind": "rect", "x": 680, "y": 300, "w": 120, "h": 80, "fill": "#2ca02c", "stroke": "none", "explain": "6: a 2-by-3 rectangle, half of the missing 12."}}, {"at_ms": 6300, "do": "show", "shape": {"id": "lab6a", "kind": "latex", "tex": "6", "x": 731, "y": 332, "size": 30, "color": "#ffffff", "explain": "The value 6: 2 times 3."}}, {"at_ms": 6450, "do": "show", "shape": {"id": "r6b", "kind": "rect", "x": 600, "y": 380, "w": 80, "h": 120, "fill": "#2ca02c", "stroke": "none", "explain": "6: the other 2-by-3 rectangle, the rest of the missing 12."}}, {"at_ms": 6450, "do": "show", "shape": {"id": "lab6b", "kind": "latex", "tex": "6", "x": 631, "y": 432, "size": 30, "color": "#ffffff", "explain": "The value 6: 2 times 3."}}, {"at_ms": 6600, "do": "hide", "target": "trap"}, {"at_ms": 6600, "do": "show", "shape": {"id": "sq9", "kind": "rect", "x": 680, "y": 380, "w": 120, "h": 120, "fill": "#d62728", "stroke": "none", "explain": "9: 3 squared, the bottom-right tile."}}, {"at_ms": 6600, "do": "show", "shape": {"id": "lab9", "kind": "latex", "tex": "9", "x": 731, "y": 432, "size": 30, "color": "#ffffff", "explain": "The value 9: 3 squared."}}, {"at_ms": 6700, "do": "show", "shape": {"id": "fixed", "kind": "latex", "tex": "(a + b)^2 = a^2 + 2ab + b^2", "x": 150, "y": 170, "size": 40, "color": "#1f7a3a", "explain": "The correct identity: (a + b) squared equals a-squared plus 2ab plus b-squared."}}, {"at_ms": 7400, "do": "hide", "target": "wlab"}, {"at_ms": 7500, "do": "hide", "target": "w13"}, {"at_ms": 7800, "do": "show", "shape": {"id": "marker", "kind": "text", "text": "See secondary A: binomial expansion", "x": 150, "y": 470, "size": 24, "color": "#555555", "explain": "Pointer: the general binomial expansion is covered in Secondary A."}}, {"at_ms": 8500, "do": "caption", "text": "2ab is the missing middle term — watch it travel in"}]}]}