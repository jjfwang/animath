            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 4100,
          "do": "show",
          "shape": {
            "id": "t2",
            "kind": "latex",
            "tex": "T_3 = \\binom{3}{2} a^1 b^2 = 3ab^2",
            "x": 130,
