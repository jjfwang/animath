    {
      "id": "s4",
      "caption": "Misconception: the power does not distribute",
      "narration": "(a + b) squared is not a squared plus b squared. Check with numbers: (1+2)^2 is 9, but 1^2+2^2 is only 5. The missing middle term is 2ab \u2014 that is the whole trap.",
      "duration_ms": 8500,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "wrong",
            "kind": "latex",
            "tex": "(a + b)^n \\neq a^n + b^n",
            "x": 140,
            "y": 120,
            "size": 48,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 1300,
          "do": "show",
          "shape": {
            "id": "trap",
            "kind": "text",
            "text": "The classic trap: distributing the power over the sum.",
            "x": 140,
            "y": 220,
            "size": 28,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 2700,
          "do": "show",
          "shape": {
            "id": "eg",
            "kind": "latex",
            "tex": "(1 + 2)^2 = 3^2 = 9",
            "x": 140,
            "y": 320,
            "size": 44,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 4000,
          "do": "show",
          "shape": {
            "id": "bad",
            "kind": "latex",
            "tex": "\\text{but } 1^2 + 2^2 = 1 + 4 = 5",
            "x": 140,
            "y": 400,
            "size": 44,
            "color": "#b00020"
          }
        },
        {
          "at_ms": 5300,
          "do": "show",
          "shape": {
            "id": "fix",
            "kind": "latex",
            "tex": "9 \\neq 5 \\;\\Rightarrow\\; (a+b)^2 = a^2 + 2ab + b^2",
            "x": 140,
            "y": 480,
            "size": 40,
            "color": "#1f7a3a"
          }
        },
        {
          "at_ms": 6200,
          "do": "emphasize",
          "target": "bad",
          "dur_ms": 900
        },
        {
          "at_ms": 7300,
          "do": "caption",
          "text": "The middle term 2ab is the one everyone forgets"
        }
      ]
    }
