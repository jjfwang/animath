{"animath": "0.1", "canvas": {"height": 540, "width": 960}, "kind": "concept", "level": "secondary", "scenes": [{"caption": "Pascal's triangle: the coefficients of (a + b)^n", "duration_ms": 12000, "id": "s1", "narration": "Each row of Pascal's triangle lists the coefficients of a binomial expansion: row n gives the coefficients of (a + b) to the power n. Every entry is the sum of the two entries above it.", "steps": [{"at_ms": 0, "do": "show", "shape": {"color": "#1a1a1a", "id": "n3", "explain": "Row n: the row number tells you which power of (a + b) these coefficients belong to.", "kind": "latex", "size": 44, "tex": "(a + b)^3 = 1a^3 + 3a^2b + 3ab^2 + 1b^3", "x": 90, "y": 80}}, {"at_ms": 900, "do": "show", "shape": {"color": "#1a1a1a", "id": "p0_0", "explain": "The top of the triangle: row 0, the coefficients of (a + b) to the power 0.", "kind": "text", "size": 34, "text": "1", "x": 480, "y": 150}}, {"at_ms": 1300, "do": "show", "shape": {"color": "#1a1a1a", "id": "p1_0", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 448, "y": 212}}, {"at_ms": 1600, "do": "show", "shape": {"color": "#1a1a1a", "id": "p1_1", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 512, "y": 212}}, {"at_ms": 2000, "do": "show", "shape": {"color": "#1a1a1a", "id": "p2_0", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 416, "y": 274}}, {"at_ms": 2200, "do": "show", "shape": {"color": "#1a1a1a", "id": "p2_2", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 544, "y": 274}}, {"at_ms": 2400, "do": "show", "shape": {"cx": 448, "cy": 226, "fill": "#d97706", "id": "dotA", "explain": "The addition: the two entries above that add to the entry below.", "kind": "circle", "r": 10}}, {"at_ms": 2400, "do": "show", "shape": {"cx": 512, "cy": 226, "fill": "#d97706", "id": "dotB", "explain": "The addition: the two entries above that add to the entry below.", "kind": "circle", "r": 10}}, {"at_ms": 2700, "do": "move", "dur_ms": 700, "target": "dotA", "to": {"cx": 480, "cy": 274}}, {"at_ms": 2700, "do": "move", "dur_ms": 700, "target": "dotB", "to": {"cx": 480, "cy": 274}}, {"at_ms": 3500, "do": "show", "shape": {"color": "#1a1a1a", "id": "p2_1", "explain": "2: the sum of the two 1s above it.", "kind": "text", "size": 34, "text": "2", "x": 480, "y": 274}}, {"at_ms": 3500, "do": "hide", "target": "dotA"}, {"at_ms": 3500, "do": "hide", "target": "dotB"}, {"at_ms": 3900, "do": "show", "shape": {"color": "#1a1a1a", "id": "p3_0", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 384, "y": 336}}, {"at_ms": 4100, "do": "show", "shape": {"color": "#1a1a1a", "id": "p3_3", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 576, "y": 336}}, {"at_ms": 4300, "do": "show", "shape": {"color": "#1a1a1a", "id": "p3_1", "explain": "3: 1 plus 2 from the row above.", "kind": "text", "size": 34, "text": "3", "x": 448, "y": 336}}, {"at_ms": 4500, "do": "show", "shape": {"cx": 480, "cy": 288, "fill": "#d97706", "id": "dotC", "explain": "The addition: the two entries above that add to the entry below.", "kind": "circle", "r": 10}}, {"at_ms": 4500, "do": "show", "shape": {"cx": 544, "cy": 288, "fill": "#d97706", "id": "dotD", "explain": "The addition: the two entries above that add to the entry below.", "kind": "circle", "r": 10}}, {"at_ms": 4800, "do": "move", "dur_ms": 700, "target": "dotC", "to": {"cx": 512, "cy": 336}}, {"at_ms": 4800, "do": "move", "dur_ms": 700, "target": "dotD", "to": {"cx": 512, "cy": 336}}, {"at_ms": 5600, "do": "show", "shape": {"color": "#1a1a1a", "id": "p3_2", "explain": "3: 2 plus 1 from the row above.", "kind": "text", "size": 34, "text": "3", "x": 512, "y": 336}}, {"at_ms": 5600, "do": "hide", "target": "dotC"}, {"at_ms": 5600, "do": "hide", "target": "dotD"}, {"at_ms": 6000, "do": "show", "shape": {"color": "#1a1a1a", "id": "p4_0", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 352, "y": 398}}, {"at_ms": 6200, "do": "show", "shape": {"color": "#1a1a1a", "id": "p4_4", "explain": "The edge of the triangle: C(n,0) and C(n,n) are always 1.", "kind": "text", "size": 34, "text": "1", "x": 608, "y": 398}}, {"at_ms": 6400, "do": "show", "shape": {"color": "#1a1a1a", "id": "p4_1", "explain": "4: 1 plus 3 from the row above.", "kind": "text", "size": 34, "text": "4", "x": 416, "y": 398}}, {"at_ms": 6600, "do": "show", "shape": {"color": "#1a1a1a", "id": "p4_3", "explain": "4: 3 plus 1 from the row above.", "kind": "text", "size": 34, "text": "4", "x": 544, "y": 398}}, {"at_ms": 6800, "do": "show", "shape": {"cx": 448, "cy": 350, "fill": "#d97706", "id": "dotE", "explain": "The addition: the two entries above that add to the entry below.", "kind": "circle", "r": 10}}, {"at_ms": 6800, "do": "show", "shape": {"cx": 512, "cy": 350, "fill": "#d97706", "id": "dotF", "explain": "The addition: the two entries above that add to the entry below.", "kind": "circle", "r": 10}}, {"at_ms": 7100, "do": "move", "dur_ms": 700, "target": "dotE", "to": {"cx": 480, "cy": 398}}, {"at_ms": 7100, "do": "move", "dur_ms": 700, "target": "dotF", "to": {"cx": 480, "cy": 398}}, {"at_ms": 7900, "do": "show", "shape": {"color": "#1a1a1a", "id": "p4_2", "explain": "6: 3 plus 3 from the row above.", "kind": "text", "size": 34, "text": "6", "x": 480, "y": 398}}, {"at_ms": 7900, "do": "hide", "target": "dotE"}, {"at_ms": 7900, "do": "hide", "target": "dotF"}, {"at_ms": 8500, "do": "caption", "text": "Row n lists the coefficients of (a + b)^n"}, {"at_ms": 9000, "do": "emphasize", "dur_ms": 900, "target": "p4_2"}]}, {"caption": "(a + b)^n, term by term", "duration_ms": 11000, "id": "s2", "narration": "The binomial theorem gives every term at once: term r+1 is C(n,r) times a to the n minus r times b to the r. The coefficients rise and fall, and the powers of a drop as the powers of b climb.", "steps": [{"at_ms": 0, "do": "show", "shape": {"color": "#1a1a1a", "id": "exp", "explain": "The binomial theorem: term r plus 1 is C(n,r) times a to the n minus r times b to the r.", "kind": "latex", "size": 40, "tex": "(a + b)^3 = \\sum_{r=0}^{3} \\binom{3}{r} a^{3-r} b^r", "x": 90, "y": 70}}, {"at_ms": 900, "do": "show", "shape": {"cx": 72, "cy": 112, "fill": "#d97706", "id": "ptr", "explain": "The pointer: it tracks which term of the expansion is being built.", "kind": "circle", "r": 9}}, {"at_ms": 1100, "do": "move", "dur_ms": 600, "target": "ptr", "to": {"cx": 100, "cy": 150}}, {"at_ms": 1800, "do": "show", "shape": {"color": "#1f7a3a", "id": "t0", "explain": "Term 1: C(3,0) times a cubed.", "kind": "latex", "size": 36, "tex": "T_1 = \\binom{3}{0} a^3 = 1a^3", "x": 130, "y": 150}}, {"at_ms": 2400, "do": "show", "shape": {"color": "#1a1a1a", "id": "t0n", "explain": "The pattern: the powers of a fall from 3 to 0 across the terms.", "kind": "text", "size": 24, "text": "coefficient 1, powers of a fall 3 → 0", "x": 425, "y": 150}}, {"at_ms": 3000, "do": "move", "dur_ms": 700, "target": "ptr", "to": {"cx": 100, "cy": 220}}, {"at_ms": 3800, "do": "show", "shape": {"color": "#1f7a3a", "id": "t1", "explain": "Term 2: C(3,1) times a squared times b.", "kind": "latex", "size": 36, "tex": "T_2 = \\binom{3}{1} a^2 b^1 = 3a^2b", "x": 130, "y": 220}}, {"at_ms": 4400, "do": "show", "shape": {"color": "#1a1a1a", "id": "t1n", "explain": "The pattern: the powers of b rise as the powers of a fall.", "kind": "text", "size": 24, "text": "coefficient 3, powers of b rise", "x": 512, "y": 220}}, {"at_ms": 5000, "do": "move", "dur_ms": 700, "target": "ptr", "to": {"cx": 100, "cy": 290}}, {"at_ms": 5800, "do": "show", "shape": {"color": "#1f7a3a", "id": "t2", "explain": "Term 3: C(3,2) times a times b squared.", "kind": "latex", "size": 36, "tex": "T_3 = \\binom{3}{2} a^1 b^2 = 3ab^2", "x": 130, "y": 290}}, {"at_ms": 6400, "do": "show", "shape": {"color": "#1a1a1a", "id": "t2n", "explain": "The pattern: the powers of a fall from 3 to 0 across the terms.", "kind": "text", "size": 24, "text": "coefficient 3", "x": 640, "y": 290}}, {"at_ms": 7000, "do": "move", "dur_ms": 700, "target": "ptr", "to": {"cx": 100, "cy": 360}}, {"at_ms": 7800, "do": "show", "shape": {"color": "#1f7a3a", "id": "t3", "explain": "Term 4: C(3,3) times b cubed.", "kind": "latex", "size": 36, "tex": "T_4 = \\binom{3}{3} b^3 = 1b^3", "x": 130, "y": 360}}, {"at_ms": 8400, "do": "show", "shape": {"color": "#1a1a1a", "id": "t3n", "explain": "The pattern: the powers of b rise as the powers of a fall.", "kind": "text", "size": 24, "text": "coefficient 1", "x": 640, "y": 360}}, {"at_ms": 9200, "do": "hide", "target": "ptr"}, {"at_ms": 9500, "do": "caption", "text": "Coefficients rise 1, 3, 3, 1; powers of a fall as b's rise"}]}, {"caption": "Worked: expanding (2x - 3)^4", "duration_ms": 11500, "id": "s3", "narration": "Take (2x - 3) to the fourth: each term is C(4,r) times (2x) to the 4 minus r times (-3) to the r. Keep the brackets around negative 3 — its powers alternate sign.", "steps": [{"at_ms": 0, "do": "show", "shape": {"color": "#1a1a1a", "id": "q", "explain": "The worked example: expand (2x minus 3) to the fourth power.", "kind": "latex", "size": 38, "tex": "(2x - 3)^4 = \\sum_{r=0}^{4} \\binom{4}{r}(2x)^{4-r}(-3)^r", "x": 70, "y": 70}}, {"at_ms": 1000, "do": "show", "shape": {"color": "#1a1a1a", "id": "w1", "explain": "Term 1: C(4,0) times (2x) to the fourth times negative 3 to the zero.", "kind": "latex", "size": 36, "tex": "C(4,0)(2x)^4(-3)^0", "x": 60, "y": 150}}, {"at_ms": 1000, "do": "show", "shape": {"id": "tray", "kind": "rect", "x": 545, "y": 130, "w": 300, "h": 340, "rx": 12, "fill": "#eef2ff", "stroke": "#1a56db", "strokeWidth": 2, "explain": "The answer column: each simplified term flies here to join the sum."}}, {"at_ms": 1400, "do": "show", "shape": {"color": "#1f7a3a", "id": "w1v", "explain": "Term 1 simplifies to 16 x to the fourth: both C(4,0) and negative 3 to the zero are 1.", "kind": "latex", "size": 36, "tex": "= 16x^4", "x": 830, "y": 150}}, {"at_ms": 1700, "do": "move", "dur_ms": 600, "target": "w1v", "to": {"x": 560, "y": 150}}, {"at_ms": 2500, "do": "show", "shape": {"color": "#1a1a1a", "id": "w2", "explain": "Term 2: C(4,1) times (2x) cubed times negative 3.", "kind": "latex", "size": 36, "tex": "C(4,1)(2x)^3(-3)^1", "x": 60, "y": 220}}, {"at_ms": 2900, "do": "show", "shape": {"color": "#1f7a3a", "id": "w2v", "explain": "Term 2 simplifies to negative 96 x cubed: the minus sign comes from the single factor of negative 3.", "kind": "latex", "size": 36, "tex": "= -96x^3", "x": 830, "y": 220}}, {"at_ms": 3200, "do": "move", "dur_ms": 600, "target": "w2v", "to": {"x": 560, "y": 220}}, {"at_ms": 4000, "do": "show", "shape": {"color": "#1a1a1a", "id": "w3", "explain": "Term 3: C(4,2) times (2x) squared times negative 3 squared.", "kind": "latex", "size": 36, "tex": "C(4,2)(2x)^2(-3)^2", "x": 60, "y": 290}}, {"at_ms": 4400, "do": "show", "shape": {"color": "#1f7a3a", "id": "w3v", "explain": "Term 3 simplifies to 216 x squared: the even power of negative 3 keeps it positive.", "kind": "latex", "size": 36, "tex": "= 216x^2", "x": 830, "y": 290}}, {"at_ms": 4700, "do": "move", "dur_ms": 600, "target": "w3v", "to": {"x": 560, "y": 290}}, {"at_ms": 5500, "do": "show", "shape": {"color": "#1a1a1a", "id": "w4", "explain": "Term 4: C(4,3) times (2x) times negative 3 cubed.", "kind": "latex", "size": 36, "tex": "C(4,3)(2x)^1(-3)^3", "x": 60, "y": 360}}, {"at_ms": 5900, "do": "show", "shape": {"color": "#1f7a3a", "id": "w4v", "explain": "Term 4 simplifies to negative 216 x: the minus sign comes from the odd power of negative 3.", "kind": "latex", "size": 36, "tex": "= -216x", "x": 830, "y": 360}}, {"at_ms": 6200, "do": "move", "dur_ms": 600, "target": "w4v", "to": {"x": 560, "y": 360}}, {"at_ms": 7000, "do": "show", "shape": {"color": "#1a1a1a", "id": "w5", "explain": "Term 5: C(4,4) times negative 3 to the fourth.", "kind": "latex", "size": 36, "tex": "C(4,4)(2x)^0(-3)^4", "x": 60, "y": 430}}, {"at_ms": 7400, "do": "show", "shape": {"color": "#1f7a3a", "id": "w5v", "explain": "Term 5 simplifies to 81: negative 3 to the fourth is positive.", "kind": "latex", "size": 36, "tex": "= 81", "x": 830, "y": 430}}, {"at_ms": 7700, "do": "move", "dur_ms": 600, "target": "w5v", "to": {"x": 560, "y": 430}}, {"at_ms": 8500, "do": "show", "shape": {"color": "#1f7a3a", "id": "ans", "explain": "The full expansion: every term added together.", "kind": "latex", "size": 34, "tex": "(2x - 3)^4 = 16x^4 - 96x^3 + 216x^2 - 216x + 81", "x": 60, "y": 480}}, {"at_ms": 8500, "do": "emphasize", "target": "tray"}, {"at_ms": 9400, "do": "caption", "text": "Parenthesise -3 before raising it to a power"}]}, {"caption": "Misconception: the power does not distribute", "duration_ms": 8500, "id": "s4", "narration": "(a + b) squared is not a squared plus b squared: (1+2)^2 is 9, but 1^2+2^2 is only 5. The missing middle term 2ab is the whole trap.", "steps": [{"at_ms": 0, "do": "show", "shape": {"color": "#1a1a1a", "id": "wrong", "explain": "The trap: (a + b) squared is not a squared plus b squared.", "kind": "latex", "size": 48, "tex": "(a + b)^n \\neq a^n + b^n", "x": 140, "y": 120}}, {"at_ms": 1300, "do": "show", "shape": {"color": "#1a1a1a", "id": "trap", "explain": "The trap warning: the middle term 2ab is the one everyone forgets.", "kind": "text", "size": 28, "text": "The classic trap: distributing the power over the sum.", "x": 140, "y": 220}}, {"at_ms": 2700, "do": "show", "shape": {"color": "#1a1a1a", "id": "eg", "explain": "The number check: (1 plus 2) squared is 9.", "kind": "latex", "size": 44, "tex": "(1 + 2)^2 = 3^2 = 9", "x": 140, "y": 320}}, {"at_ms": 4000, "do": "show", "shape": {"color": "#b00020", "id": "bad", "explain": "The wrong answer: 1 squared plus 2 squared is only 5.", "kind": "latex", "size": 44, "tex": "\\text{but } 1^2 + 2^2 = 1 + 4 = 5", "x": 760, "y": 420}}, {"at_ms": 4500, "do": "move", "dur_ms": 800, "target": "bad", "to": {"x": 140, "y": 420}}, {"at_ms": 5600, "do": "emphasize", "dur_ms": 900, "target": "bad"}, {"at_ms": 6750, "do": "hide", "target": "trap"}, {"at_ms": 6750, "do": "hide", "target": "eg"}, {"at_ms": 6750, "do": "hide", "target": "bad"}, {"at_ms": 6800, "do": "show", "shape": {"id": "sqAll", "kind": "rect", "x": 560, "y": 180, "w": 260, "h": 260, "fill": "none", "stroke": "#1a1a1a", "strokeWidth": 3, "explain": "The whole square: side (a + b), area (a + b) squared."}}, {"at_ms": 6950, "do": "show", "shape": {"id": "sqA", "kind": "rect", "x": 560, "y": 180, "w": 160, "h": 160, "fill": "#1f77b4", "stroke": "none", "explain": "a squared: the a-by-a corner of the big square."}}, {"at_ms": 6950, "do": "show", "shape": {"id": "labA", "kind": "latex", "tex": "a^2", "x": 617, "y": 248, "size": 30, "color": "#ffffff", "explain": "a squared."}}, {"at_ms": 7100, "do": "show", "shape": {"id": "ab1", "kind": "rect", "x": 720, "y": 180, "w": 100, "h": 160, "fill": "#2ca02c", "stroke": "none", "explain": "One a-by-b rectangle: half of the missing 2ab."}}, {"at_ms": 7100, "do": "show", "shape": {"id": "labAB1", "kind": "latex", "tex": "ab", "x": 750, "y": 248, "size": 30, "color": "#ffffff", "explain": "a times b: the cross term."}}, {"at_ms": 7250, "do": "show", "shape": {"id": "ab2", "kind": "rect", "x": 560, "y": 340, "w": 160, "h": 100, "fill": "#2ca02c", "stroke": "none", "explain": "The other a-by-b rectangle: the rest of the missing 2ab."}}, {"at_ms": 7250, "do": "show", "shape": {"id": "labAB2", "kind": "latex", "tex": "ab", "x": 620, "y": 388, "size": 30, "color": "#ffffff", "explain": "a times b: the cross term."}}, {"at_ms": 7400, "do": "show", "shape": {"id": "sqB", "kind": "rect", "x": 720, "y": 340, "w": 100, "h": 100, "fill": "#d62728", "stroke": "none", "explain": "b squared: the b-by-b corner."}}, {"at_ms": 7400, "do": "show", "shape": {"id": "labB", "kind": "latex", "tex": "b^2", "x": 743, "y": 388, "size": 30, "color": "#ffffff", "explain": "b squared."}}, {"at_ms": 7600, "do": "show", "shape": {"id": "fix", "kind": "latex", "tex": "9 \\neq 5 \\;\\Rightarrow\\; (a+b)^2 = a^2 + 2ab + b^2", "x": 140, "y": 480, "size": 40, "color": "#1f7a3a", "explain": "The fix: the missing middle term 2ab."}}, {"at_ms": 8300, "do": "caption", "text": "The middle term 2ab is the one everyone forgets"}]}], "subject": "math", "title": "A-Math binomial: Pascal's triangle and the (a+b)^n expansion", "topic": "a-binomial"}