    {
      "id": "s3",
      "caption": "Worked: expanding (2x - 3)^4",
      "narration": "Take (2x - 3) to the fourth. Each term is C(4,r) times (2x) to the 4 minus r times (-3) to the r. Keep the brackets around negative 3: its powers alternate sign.",
      "duration_ms": 11500,
      "steps": [
        {
