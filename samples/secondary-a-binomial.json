          "shape": {
            "id": "q",
            "kind": "latex",
            "tex": "(2x - 3)^4 = \\sum_{r=0}^{4} \\binom{4}{r}(2x)^{4-r}(-3)^r",
            "x": 70,
            "y": 70,
            "size": 38,
            "color": "#1a1a1a"
          }
        },
