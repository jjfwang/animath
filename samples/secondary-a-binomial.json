    {
      "id": "s2",
      "caption": "(a + b)^n, term by term",
      "narration": "The binomial theorem gives every term at once: term r+1 is C(n,r) times a to the n minus r times b to the r. The coefficients rise and fall, and the powers of a drop as the powers of b climb.",
      "duration_ms": 11000,
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "id": "exp",
            "kind": "latex",
            "tex": "(a + b)^3 = \\sum_{r=0}^{3} \\binom{3}{r} a^{3-r} b^r",
            "x": 90,
            "y": 70,
            "size": 40,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 1100,
          "do": "show",
          "shape": {
            "id": "t0",
            "kind": "latex",
            "tex": "T_1 = \\binom{3}{0} a^3 = 1a^3",
            "x": 130,
            "y": 150,
            "size": 36,
            "color": "#1f7a3a"
          }
        },
        {
          "at_ms": 1600,
          "do": "show",
          "shape": {
            "id": "t0n",
            "kind": "text",
            "text": "coefficient 1, powers of a fall 3 \u2192 0",
            "x": 640,
            "y": 150,
            "size": 24,
            "color": "#1a1a1a"
          }
        },
        {
          "at_ms": 2600,
          "do": "show",
          "shape": {
            "id": "t1",
            "kind": "latex",
            "tex": "T_2 = \\binom{3}{1} a^2 b^1 = 3a^2b",
            "x": 130,
            "y": 220,
            "size": 36,
            "color": "#1f7a3a"
          }
        },
        {
          "at_ms": 3100,
          "do": "show",
          "shape": {
            "id": "t1n",
            "kind": "text",
            "text": "coefficient 3, powers of b rise",
            "x": 640,
            "y": 220,
