    {
      "caption": "Einstein's photoelectric equation",
      "duration_ms": 10000,
      "id": "s3",
      "narration": "Einstein's equation balances the energy books. The photon's energy h f first pays the work function W to free the electron, and whatever remains becomes the electron's kinetic energy. That is why brighter light cannot speed electrons up — each electron gets just one photon.",
      "steps": [
        {
          "at_ms": 0,
          "do": "show",
          "shape": {
            "fill": "#6b7280",
            "h": 40,
            "id": "metal",
