":"text","x":272,"y":298,"size":22,"text":"flower"}},{"at_ms":1600,"do":"show","shape":{"id":"stigmaD","explain":"The stigma: the landing spot for pollen in the pollination step.","kind":"circle","cx":300,"cy":205,"r":10,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":2000,"do":"show","shape":{"id":"chipP","explain":"The pollination step: pollen is delivered to the flower.","kind":"rect","x":480,"y":100,"w":210,"h":48,"fill":"#e8f4fd","stroke":"#2b5cb8","strokeWidth":3}},{"at_ms":2200,"do":"show","shape":{"id":"chipPL","explain":"Label: Pollination.","kind":"text","x":514,"y":132,"size":22,"text":"pollination"}},{"at_ms":2600,"do":"move","dur_ms":1200,"target":"chipP","to":{"x":200,"y":120}},{"at_ms":2600,"do":"move","dur_ms":1200,"target":"chipPL","to":{"x":234,"y":152}},{"at_ms":4000,"do":"show","shape":{"id":"pd1","explain":"A pollen grain: delivered during pollination, before any fusion.","kind":"circle","cx":288,"cy":198,"r":8,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":4100,"do":"show","shape":{"id":"pd2","explain":"A pollen grain: delivered during pollination, before any fusion.","kind":"circle","cx":300,"cy":193,"r":8,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":4200,"do":"show","shape":{"id":"pd3","explain":"A pollen grain: delivered during pollination, before any fusion.","kind":"circle","cx":312,"cy":198,"r":8,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":4600,"do":"show","shape":{"id":"wt","explain":"A note: it is easy to think pollination IS fertilisation, but the two events are separate.","kind":"text","x":120,"y":420,"size":24,"text":"easy to think: pollination IS fertilisation"}},{"at_ms":5000,"do":"caption","text":"Pollination is delivery: pollen stays on the stigma."},{"at_ms":5400,"do":"show","shape":{"id":"ovuleM","explain":"The ovule: where fusion happens in the fertilisation step.","kind":"circle","cx":300,"cy":335,"r":25,"fill":"#fff3b0","stroke":"#b8860b","strokeWidth":3}},{"at_ms":5400,"do":"show","shape":{"id":"chipF","explain":"The fertilisation step: the male nucleus fuses with the ovule.","kind":"rect","x":480,"y":320,"w":210,"h":48,"fill":"#fde8e8","stroke":"#c0392b","strokeWidth":3}},{"at_ms":5600,"do":"show","shape":{"id":"chipFL","explain":"Label: Fertilisation.","kind":"text","x":501,"y":352,"size":22,"text":"fertilisation"}},{"at_ms":6000,"do":"move","dur_ms":1200,"target":"chipF","to":{"x":50,"y":300}},{"at_ms":6000,"do":"move","dur_ms":1200,"target":"chipFL","to":{"x":71,"y":332}},{"at_ms":7400,"do":"show","shape":{"id":"fuse","explain":"The fusion: male nucleus and ovule join. This joining is fertilisation.","kind":"circle","cx":300,"cy":335,"r":32,"fill":"#f9d976","stroke":"#e0a800","strokeWidth":3}},{"at_ms":7400,"do":"emphasize","dur_ms":1000,"target":"fuse"},{"at_ms":7800,"do":"show","shape":{"id":"verdict","explain":"The verdict: delivery is not fusion. Fertilisation needs fusion.","kind":"text","x":120,"y":470,"size":22,"text":"Delivery is not fusion - fertilisation needs fusion."}},{"at_ms":8400,"do":"caption","text":"Pollination delivers; fertilisation fuses."}]}]}