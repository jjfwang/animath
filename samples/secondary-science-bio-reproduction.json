t.","kind":"circle","cx":170,"cy":274,"r":8,"fill":"#7a5c3e","stroke":"#4e3a26","strokeWidth":2}},{"at_ms":1600,"do":"show","shape":{"id":"windArrow","explain":"The arrow shows wind carrying the seeds away.","kind":"arrow","x1":235,"y1":228,"x2":560,"y2":172,"stroke":"#5b8dd6","width":4}},{"at_ms":2000,"do":"show","shape":{"id":"windL","explain":"Label: Wind.","kind":"text","x":390,"y":148,"size":22,"text":"wind"}},{"at_ms":2200,"do":"show","shape":{"id":"wd","explain":"A wind-carried seed: light seeds travel far on the wind.","kind":"circle","cx":250,"cy":230,"r":9,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":2400,"do":"move","dur_ms":900,"target":"wd","to":{"cx":400,"cy":201}},{"at_ms":3300,"do":"move","dur_ms":900,"target":"wd","to":{"cx":560,"cy":172}},{"at_ms":4300,"do":"show","shape":{"id":"waterArrow","explain":"The arrow shows water carrying the seed away.","kind":"arrow","x1":235,"y1":308,"x2":625,"y2":352,"stroke":"#3aa7c9","width":4}},{"at_ms":4700,"do":"show","shape":{"id":"waterL","explain":"Label: Water.","kind":"text","x":425,"y":378,"size":22,"text":"water"}},{"at_ms":4900,"do":"show","shape":{"id":"wseed","explain":"A water-carried seed: it floats to a new home.","kind":"circle","cx":250,"cy":310,"r":9,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":5100,"do":"move","dur_ms":1100,"target":"wseed","to":{"cx":430,"cy":330}},{"at_ms":6200,"do":"move","dur_ms":1000,"target":"wseed","to":{"cx":625,"cy":352}},{"at_ms":7300,"do":"show","shape":{"id":"animal","explain":"An animal: seeds hitch a ride in its fur, or are dropped after it eats the fruit.","kind":"circle","cx":250,"cy":420,"r":14,"fill":"#8a5a2b","stroke":"#5c3a1a","strokeWidth":2}},{"at_ms":7600,"do":"show","shape":{"id":"hitch","explain":"A hitchhiking seed: it catches a ride on an animal.","kind":"circle","cx":250,"cy":400,"r":9,"fill":"#f2c94c","stroke":"#b8860b","strokeWidth":2}},{"at_ms":7800,"do":"move","dur_ms":900,"target":"animal","to":{"cx":440,"cy":43